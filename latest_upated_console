        private static bool InitializeWorkingModel(IpfcModel model)
        {
            try
            {
                bool isAssembly = model is IpfcAssembly;

                if (isAssembly)
                {
                    List<AssemblyComponentInfo> allComponents = new List<AssemblyComponentInfo>();
                    HashSet<string> visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    CollectAllComponents((IpfcAssembly)model, (IpfcAssembly)model, new List<int>(), allComponents, visited);


                    AssemblyComponentInfo bestPipeComp = null;

                    // Pass 1 (Ultra-Fast): Check parts with TUBE, PIPE, BEND, HOSE in their instance name
                    for (int i = 0; i < allComponents.Count; i++)
                    {
                        AssemblyComponentInfo compInfo = allComponents[i];
                        IpfcModel comp = compInfo.Model;
                        string name = "";
                        try { name = comp.InstanceName ?? ""; } catch { }

                        if (IsIgnoredFitting(name)) continue;

                        if (name.IndexOf("TUBE", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("PIPE", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("BEND", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("HOSE", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            int bends = CountDistinctBends((IpfcModelItemOwner)comp);
                            if (bends >= 1)
                            {
                                bestPipeComp = compInfo;
                                break;
                            }
                        }
                    }

                    // Pass 2 (Fast Scan): If not matched by name, check remaining parts for bends
                    if (bestPipeComp == null)
                    {
                        for (int i = 0; i < allComponents.Count; i++)
                        {
                            AssemblyComponentInfo compInfo = allComponents[i];
                            IpfcModel comp = compInfo.Model;
                            string name = "";
                            try { name = comp.InstanceName ?? ""; } catch { }

                            if (IsIgnoredFitting(name)) continue;

                            int bends = CountDistinctBends((IpfcModelItemOwner)comp);
                            if (bends < 1) continue;

                            // Found a bent pipe component - use it immediately for speed
                            bestPipeComp = compInfo;
                            break;
                        }
                    }

                    if (bestPipeComp != null)
                    {
                        try
                        {
                            IpfcWindow win = Session.GetModelWindow(model);
                            if (win != null) win.Activate();
                            model.Display();
                        }
                        catch { }

                        WorkingModel = model;
                        WorkingItemOwner = (IpfcModelItemOwner)bestPipeComp.Model;
                        FeatureItemOwner = (IpfcModelItemOwner)model;
                        PipeComponentPath = bestPipeComp.ComponentPath;
                        return true;
                    }

                    int asmBends = CountDistinctBends((IpfcModelItemOwner)model);
                    List<TerminalSide> asmEnds = FindTerminalSides((IpfcModelItemOwner)model);

                    if ((asmEnds.Count == 2 || asmBends >= 1) && asmBends >= 1)
                    {
                        WorkingModel = model;
                        WorkingItemOwner = (IpfcModelItemOwner)model;
                        FeatureItemOwner = (IpfcModelItemOwner)model;
                        PipeComponentPath = null;
                        return true;
                    }

                    MessageBox.Show(
                        "No bent pipe found in the active assembly hierarchy.",
                        "No Pipe Found",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning);

                    return false;
                }
                else
                {
                    // Standalone PART
                    int partBends = CountDistinctBends((IpfcModelItemOwner)model);
                    List<TerminalSide> partEnds = FindTerminalSides((IpfcModelItemOwner)model);

                    if (partBends >= 1 || partEnds.Count == 2)
                    {
                        if (partBends >= 1)
                        {
                            WorkingModel = model;
                            WorkingItemOwner = (IpfcModelItemOwner)model;
                            FeatureItemOwner = (IpfcModelItemOwner)model;
                            PipeComponentPath = null;
                            return true;
                        }
                        else
                        {
                            MessageBox.Show(
                                "The open model is a straight pipe with no bends.\n\n" +
                                "This automation requires a bent pipe.",
                                "Straight Pipe Detected",
                                MessageBoxButtons.OK,
                                MessageBoxIcon.Warning);
                            return false;
                        }
                    }
                    else
                    {
                        MessageBox.Show(
                            "The open model is not a recognized pipe geometry (found " + partEnds.Count + " terminal ends).",
                            "Invalid Model",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning);
                        return false;
                    }
                }
            }
            catch (Exception)
            {
                return false;
            }
        }

        private static bool IsIgnoredFitting(string name)
        {
            if (string.IsNullOrEmpty(name)) return false;
            string upper = name.ToUpperInvariant();
            return upper.Contains("NUT") ||
                   upper.Contains("FERRULE") ||
                   upper.Contains("FTG") ||
                   upper.Contains("FITTING") ||
                   upper.Contains("SEAL") ||
                   upper.Contains("O-RING") ||
                   upper.Contains("ORING") ||
                   upper.Contains("CLAMP") ||
                   upper.Contains("SCREW") ||
                   upper.Contains("BOLT") ||
                   upper.Contains("WASHER") ||
                   upper.Contains("FLANGE") ||
                   upper.Contains("PLUG") ||
                   upper.Contains("CAP") ||
                   upper.Contains("PIN") ||
                   upper.Contains("RIVET") ||
                   upper.Contains("SPRING") ||
                   upper.Contains("GASKET") ||
                   upper.Contains("BRACKET") ||
                   upper.Contains("PLATE") ||
                   upper.Contains("HOUSING");
        }

        private static int CountDistinctBends(IpfcModelItemOwner itemOwner)
        {
            try
            {
                if (itemOwner == null) return 0;
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null || surfaces.Count < 2) return 0;

                int torusCount = 0;
                List<double[]> torusCenters = new List<double[]>();
                HashSet<string> centerKeys = new HashSet<string>();
                const double CENTER_TOLERANCE = 2.0;

                int cylinderCount = 0;

                for (int i = 0; i < surfaces.Count; i++)
                {
                    try
                    {
                        if (!(surfaces[i] is IpfcSurface surf)) continue;
                        int stype = surf.GetSurfaceType();

                        if (stype == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                        {
                            torusCount++;
                            if (surf is IpfcTransformedSurface trans && trans.CoordSys != null)
                            {
                                IpfcPoint3D origin = trans.CoordSys.GetOrigin();
                                if (origin != null)
                                {
                                    double[] c = new double[] { origin[0], origin[1], origin[2] };
                                    string cKey = $"{Math.Round(c[0] / CENTER_TOLERANCE)}_{Math.Round(c[1] / CENTER_TOLERANCE)}_{Math.Round(c[2] / CENTER_TOLERANCE)}";
                                    if (centerKeys.Add(cKey))
                                    {
                                        torusCenters.Add(c);
                                    }
                                }
                            }
                        }
                        else if (stype == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                        {
                            cylinderCount++;
                        }
                    }
                    catch { }
                }

                if (torusCenters.Count > 0)
                {
                    return torusCenters.Count;
                }

                if (torusCount > 0)
                {
                    return Math.Max(1, torusCount / 2);
                }

                if (cylinderCount >= 2)
                {
                    List<double[]> cylinderDirs = new List<double[]>();
                    for (int i = 0; i < surfaces.Count; i++)
                    {
                        try
                        {
                            if (surfaces[i] is IpfcSurface surf && surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                            {
                                double[] dir = GetCylinderAxisDirection(surf);
                                if (dir != null)
                                {
                                    bool isColinear = false;
                                    for (int k = 0; k < cylinderDirs.Count; k++)
                                    {
                                        double dot = Math.Abs(dir[0] * cylinderDirs[k][0] + dir[1] * cylinderDirs[k][1] + dir[2] * cylinderDirs[k][2]);
                                        if (dot > 0.995)
                                        {
                                            isColinear = true;
                                            break;
                                        }
                                    }
                                    if (!isColinear)
                                    {
                                        cylinderDirs.Add(dir);
                                    }
                                }
                            }
                        }
                        catch { }
                    }

                    if (cylinderDirs.Count >= 2)
                    {
                        return cylinderDirs.Count - 1;
                    }
                }

                return 0;
            }
            catch
            {
                return 0;
            }
        }

        private static void CollectAllComponents(
            IpfcAssembly rootAssembly,
            IpfcAssembly currentAssembly,
            List<int> currentPath,
            List<AssemblyComponentInfo> collectedComponents,
            HashSet<string> visitedKeys)
        {
            try
            {
                IpfcModelItemOwner asmOwner = (IpfcModelItemOwner)currentAssembly;
                IpfcModelItems features = asmOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (features == null) return;

                for (int i = 0; i < features.Count; i++)
                {
                    try
                    {
                        IpfcModelItem feat = features[i];
                        if (feat is IpfcComponentFeat compFeat)
                        {
                            IpfcModelDescriptor descr = compFeat.ModelDescr;
                            if (descr == null) continue;

                            IpfcModel compModel = Session.GetModelFromDescr(descr);
                            if (compModel == null) continue;

                            List<int> nextPath = new List<int>(currentPath) { feat.Id };

                            string pathKey = string.Join("/", nextPath) + ":" + (compModel.InstanceName ?? "");
                            if (visitedKeys.Contains(pathKey)) continue;
                            visitedKeys.Add(pathKey);

                            Cintseq idSeq = new Cintseq();
                            foreach (int id in nextPath)
                            {
                                idSeq.Append(id);
                            }

                            IpfcComponentPath compPath = null;
                            try
                            {
                                compPath = new CMpfcAssembly().CreateComponentPath(rootAssembly, idSeq);
                            }
                            catch { }

                            if (compModel is IpfcAssembly subAsm)
                            {
                                CollectAllComponents(rootAssembly, subAsm, nextPath, collectedComponents, visitedKeys);
                            }
                            else if (compModel is IpfcSolid || compModel is IpfcPart)
                            {
                                collectedComponents.Add(new AssemblyComponentInfo
                                {
                                    Model = compModel,
                                    ComponentFeat = compFeat,
                                    FeatureIdPath = nextPath,
                                    ComponentPath = compPath
                                });
                            }
                        }
                    }
                    catch (Exception)
                    {
                    }
                }
            }
            catch (Exception)
            {
            }
        }

        private static double[] GetCylinderAxisDirection(IpfcSurface cylSurf)
        {
            try
            {
                if (cylSurf is IpfcTransformedSurface transSurf && transSurf.CoordSys != null)
                {
                    IpfcVector3D zAxis = transSurf.CoordSys.GetZAxis();
                    if (zAxis != null)
                    {
                        double len = Math.Sqrt(zAxis[0] * zAxis[0] + zAxis[1] * zAxis[1] + zAxis[2] * zAxis[2]);
                        if (len > 0.0001)
                        {
                            return new double[] { zAxis[0] / len, zAxis[1] / len, zAxis[2] / len };
                        }
                    }
                }
            }
            catch { }
            return null;
        }
        private static bool IsPipeTargetName(string name)
        {
            if (string.IsNullOrEmpty(name)) return false;
            string upper = name.ToUpperInvariant().Trim();

            if (upper == "PIPE_START_POINT" ||
                upper == "PIPE_Z_POINT" ||
                upper == "PIPE_END_POINT" ||
                upper == "PIPE_AXIS_START" ||
                upper == "PIPE_AXIS_END" ||
                upper == "BEND_DATA" ||
                upper == "PIPE_BOUND_BOX")
            {
                return true;
            }

            if (upper == "A_1" || upper == "A_2" || upper == "A_3" || upper == "A_4" ||
                upper == "A1" || upper == "A2" || upper == "A3" || upper == "A4")
            {
                return true;
            }

            if (upper.StartsWith("A_") && upper.Length <= 5)
            {
                string suffix = upper.Substring(2);
                if (int.TryParse(suffix, out _))
                    return true;
            }

            if (upper.Contains("PIPE_START") ||
                upper.Contains("PIPE_END") ||
                upper.Contains("PIPE_Z") ||
                upper.Contains("PIPE_AXIS") ||
                upper.Contains("BEND_DATA") ||
                upper.Contains("BOUND_BOX"))
            {
                return true;
            }

            return false;
        }

        private static bool CheckAndDeleteExistingItems(IpfcModelItemOwner featureOwner)
        {
            List<string> existingItems = new List<string>();

            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_COORD_SYS), "Coord System", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_AXIS), "Axis", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT), "Point", existingItems);
            // CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE), "Feature", existingItems);

            if (existingItems.Count == 0)
            {
                return true;
            }


            DialogResult result = MessageBox.Show(
                "The following existing items were found:\n\n" +
                string.Join("\n", existingItems) +
                "\n\nDo you want to DELETE all of them and create new ones?",
                "Existing Items Found",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning);

            if (result == DialogResult.No)
            {
                return false;
            }
            DeleteAllExistingPipeItemsAllAtOnce(featureOwner);
            return true;
        }

        private static void CollectPipeItems(IpfcModelItems items, string prefix, List<string> existingItems)
        {
            if (items == null) return;
            for (int i = 0; i < items.Count; i++)
            {
                try
                {
                    IpfcModelItem item = items[i];
                    string name = item.GetName();
                    if (IsPipeTargetName(name))
                    {
                        string entry = prefix + ": " + name;
                        if (!existingItems.Contains(entry))
                            existingItems.Add(entry);
                    }
                    else if (item is IpfcFeature feat)
                    {
                        CheckAndAddSubItem(feat, EpfcModelItemType.EpfcITEM_POINT, "Point", existingItems);
                        CheckAndAddSubItem(feat, EpfcModelItemType.EpfcITEM_AXIS, "Axis", existingItems);
                        CheckAndAddSubItem(feat, EpfcModelItemType.EpfcITEM_COORD_SYS, "Coord System", existingItems);
                    }
                }
                catch { }
            }
        }

        private static void CheckAndAddSubItem(IpfcFeature feat, EpfcModelItemType type, string prefix, List<string> existingItems)
        {
            try
            {
                IpfcModelItems subItems = feat.ListSubItems(type);
                if (subItems != null)
                {
                    for (int s = 0; s < subItems.Count; s++)
                    {
                        string subName = subItems[s].GetName();
                        if (IsPipeTargetName(subName))
                        {
                            string entry = prefix + ": " + subName;
                            if (!existingItems.Contains(entry))
                                existingItems.Add(entry);
                        }
                    }
                }
            }
            catch { }
        }

        private static void DeleteAllExistingPipeItemsAllAtOnce(IpfcModelItemOwner featureOwner)
        {
            IpfcSession creoSession = (IpfcSession)Session;
            IpfcSelectionBuffer buffer = creoSession.CurrentSelectionBuffer;
            buffer.Clear();

            List<IpfcModelItem> itemsToSelect = new List<IpfcModelItem>();
            HashSet<int> addedIds = new HashSet<int>();

            EpfcModelItemType[] types = new[]
            {
                EpfcModelItemType.EpfcITEM_FEATURE,
                EpfcModelItemType.EpfcITEM_COORD_SYS,
                EpfcModelItemType.EpfcITEM_AXIS,
                EpfcModelItemType.EpfcITEM_POINT
            };

            foreach (var type in types)
            {
                try
                {
                    IpfcModelItems items = featureOwner.ListItems(type);
                    if (items != null)
                    {
                        for (int i = 0; i < items.Count; i++)
                        {
                            try
                            {
                                IpfcModelItem item = items[i];
                                string name = item.GetName();
                                bool isTarget = IsPipeTargetName(name);

                                if (!isTarget && item is IpfcFeature feat)
                                {
                                    IpfcModelItems subPts = feat.ListSubItems(EpfcModelItemType.EpfcITEM_POINT);
                                    if (subPts != null)
                                    {
                                        for (int p = 0; p < subPts.Count; p++)
                                        {
                                            if (IsPipeTargetName(subPts[p].GetName())) { isTarget = true; break; }
                                        }
                                    }

                                    if (!isTarget)
                                    {
                                        IpfcModelItems subAxes = feat.ListSubItems(EpfcModelItemType.EpfcITEM_AXIS);
                                        if (subAxes != null)
                                        {
                                            for (int a = 0; a < subAxes.Count; a++)
                                            {
                                                if (IsPipeTargetName(subAxes[a].GetName())) { isTarget = true; break; }
                                            }
                                        }
                                    }

                                    if (!isTarget)
                                    {
                                        IpfcModelItems subCsys = feat.ListSubItems(EpfcModelItemType.EpfcITEM_COORD_SYS);
                                        if (subCsys != null)
                                        {
                                            for (int c = 0; c < subCsys.Count; c++)
                                            {
                                                if (IsPipeTargetName(subCsys[c].GetName())) { isTarget = true; break; }
                                            }
                                        }
                                    }
                                }

                                if (isTarget && !addedIds.Contains(item.Id))
                                {
                                    addedIds.Add(item.Id);
                                    itemsToSelect.Add(item);
                                }
                            }
                            catch { }
                        }
                    }
                }
                catch { }
            }

            foreach (var item in itemsToSelect)
            {
                try
                {
                    IpfcSelection sel = new CMpfcSelect().CreateModelItemSelection(item, null);
                    buffer.AddSelection(sel);
                }
                catch { }
            }

            IpfcSolid solid = featureOwner as IpfcSolid ?? Session.CurrentModel as IpfcSolid;
            if (solid != null)
            {
                try
                {
                    CpfcFeatureOperations ops = new CpfcFeatureOperations();
                    HashSet<int> featOpsIds = new HashSet<int>();

                    foreach (var item in itemsToSelect)
                    {
                        try
                        {
                            IpfcFeature feat = item as IpfcFeature;
                            if (feat == null && item is IpfcAxis axis) feat = axis.GetFeature();
                            if (feat == null && item is IpfcCoordSystem csys) feat = csys.GetFeature();

                            if (feat != null)
                            {
                                int featId = ((IpfcModelItem)feat).Id;
                                if (!featOpsIds.Contains(featId))
                                {
                                    featOpsIds.Add(featId);
                                    IpfcDeleteOperation delOp = feat.CreateDeleteOp();
                                    delOp.Clip = true;
                                    delOp.AllowGroupMembers = true;
                                    delOp.AllowChildGroupMembers = true;
                                    ops.Append(delOp);
                                }
                            }
                        }
                        catch { }
                    }

                    if (ops.Count > 0)
                    {
                        solid.ExecuteFeatureOps(ops, null);
                    }
                }
                catch (Exception)
                {
                }
            }

            string singleDeleteMacro =
                "~ Command `ProCmdEditDelete` ;" +
                "~ Command `ProCmdFeatDelete` ;" +
                "~ Activate `del_feat_dlg` `OK`;" +
                "~ Activate `del_feat_dlg` `stdbtn_1`;" +
                "~ Activate `del_feat_dlg` `delete_btn`;" +
                "~ Activate `del_feat_dlg` `ok_btn`;" +
                "~ Activate `del_feat_dlg` `CommitBtn`;" +
                "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                "~ Activate `Odui_Dlg_00` `stdbtn_1`;" +
                "~ Activate `main_dlg_cur` `stdbtn_1`;";

            Session.RunMacro(singleDeleteMacro);
            Thread.Sleep(200);

            buffer.Clear();
            RegenerateModel();
        }
        private static Dictionary<string, string> FindTreeNodeNames(Dictionary<string, int> itemsToFind)
        {
            var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var remaining = new Dictionary<string, int>(itemsToFind, StringComparer.OrdinalIgnoreCase);

            IpfcSession creoSession = (IpfcSession)Session;
            IpfcSelectionBuffer buffer = creoSession.CurrentSelectionBuffer;

            try
            {
                Session.RunMacro("~ Command `ProCmdTreeExpandAll`;");
                Thread.Sleep(200);
            }
            catch { }

            int consecutiveMisses = 0;
            for (int i = 1; i <= 600 && remaining.Count > 0; i++)
            {
                string nodeName = "node" + i;

                try
                {
                    buffer.Clear();

                    string mapkey =
                        "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `" + nodeName + "`;" +
                        "~ Select `main_dlg_cur` `PHTLeft.ModelTree` 1 `" + nodeName + "`;";
                    Session.RunMacro(mapkey);
                    Thread.Sleep(30);

                    IpfcSelections contents = buffer.Contents;
                    if (contents != null && contents.Count > 0)
                    {
                        consecutiveMisses = 0;
                        IpfcModelItem selItem = contents[0]?.get_SelItem();
                        if (selItem != null)
                        {
                            string foundName = "";
                            int selId = selItem.Id;
                            try { foundName = selItem.GetName(); } catch { }

                            List<string> keys = new List<string>(remaining.Keys);
                            for (int j = 0; j < keys.Count; j++)
                            {
                                string targetName = keys[j];
                                int targetId = remaining[targetName];
                                bool matched = false;

                                // STRICT ID MATCHING: When targetId is provided, we MUST match by ID!
                                if (targetId > 0)
                                {
                                    if (selId == targetId)
                                    {
                                        matched = true;
                                    }
                                    else if (selItem is IpfcFeature feat)
                                    {
                                        try
                                        {
                                            if (feat is IpfcModelItem featModelItem && featModelItem.Id == targetId)
                                            {
                                                matched = true;
                                            }
                                            else
                                            {
                                                IpfcModelItems subPoints = feat.ListSubItems(EpfcModelItemType.EpfcITEM_POINT);
                                                if (subPoints != null)
                                                {
                                                    for (int k = 0; k < subPoints.Count; k++)
                                                    {
                                                        if (subPoints[k].Id == targetId) { matched = true; break; }
                                                    }
                                                }

                                                if (!matched)
                                                {
                                                    IpfcModelItems subAxes = feat.ListSubItems(EpfcModelItemType.EpfcITEM_AXIS);
                                                    if (subAxes != null)
                                                    {
                                                        for (int k = 0; k < subAxes.Count; k++)
                                                        {
                                                            if (subAxes[k].Id == targetId) { matched = true; break; }
                                                        }
                                                    }
                                                }

                                                if (!matched)
                                                {
                                                    IpfcModelItems subCsys = feat.ListSubItems(EpfcModelItemType.EpfcITEM_COORD_SYS);
                                                    if (subCsys != null)
                                                    {
                                                        for (int c = 0; c < subCsys.Count; c++)
                                                        {
                                                            if (subCsys[c].Id == targetId) { matched = true; break; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        catch { }
                                    }
                                }
                                else if (!string.IsNullOrEmpty(foundName) && foundName.Equals(targetName, StringComparison.OrdinalIgnoreCase))
                                {
                                    matched = true;
                                }

                                if (matched)
                                {
                                    result[targetName] = nodeName;
                                    remaining.Remove(targetName);
                                    break;
                                }
                            }
                        }
                    }
                    else
                    {
                        consecutiveMisses++;
                        if (consecutiveMisses > 120 && i > 150)
                        {
                            break;
                        }
                    }
                }
                catch { }
            }

            if (remaining.Count > 0)
            {
            }

            return result;
        }
        private static double[] CalculateApexPoint(double[] p1, double[] u1, double[] p2, double[] u2)
        {
            try
            {
                if (p1 == null || u1 == null || p2 == null || u2 == null) return null;
                double u1DotU2 = u1[0] * u2[0] + u1[1] * u2[1] + u1[2] * u2[2];
                double denom = 1.0 - u1DotU2 * u1DotU2;
                if (Math.Abs(denom) < 0.0001) return null; // Parallel or nearly parallel

                double[] w0 = new double[] { p1[0] - p2[0], p1[1] - p2[1], p1[2] - p2[2] };
                double d = u1[0] * w0[0] + u1[1] * w0[1] + u1[2] * w0[2];
                double e = u2[0] * w0[0] + u2[1] * w0[1] + u2[2] * w0[2];

                double s = (u1DotU2 * e - d) / denom;
                double t = (e - u1DotU2 * d) / denom;

                double q1x = p1[0] + s * u1[0];
                double q1y = p1[1] + s * u1[1];
                double q1z = p1[2] + s * u1[2];

                double q2x = p2[0] + t * u2[0];
                double q2y = p2[1] + t * u2[1];
                double q2z = p2[2] + t * u2[2];

                return new double[] { 0.5 * (q1x + q2x), 0.5 * (q1y + q2y), 0.5 * (q1z + q2z) };
            }
            catch
            {
                return null;
            }
        }

        private static List<double[]> GetTorusCenters(IpfcModelItemOwner itemOwner)
        {
            List<double[]> torusCenters = new List<double[]>();
            try
            {
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null) return torusCenters;

                const double CENTER_TOLERANCE = 2.0;
                for (int i = 0; i < surfaces.Count; i++)
                {
                    try
                    {
                        IpfcSurface surf = (IpfcSurface)surfaces[i];
                        if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                        {
                            if (surf is IpfcTransformedSurface trans && trans.CoordSys != null)
                            {
                                IpfcPoint3D origin = trans.CoordSys.GetOrigin();
                                if (origin != null)
                                {
                                    double[] c = new double[] { origin[0], origin[1], origin[2] };
                                    bool isDuplicate = false;
                                    for (int k = 0; k < torusCenters.Count; k++)
                                    {
                                        if (Distance(c, torusCenters[k]) < CENTER_TOLERANCE)
                                        {
                                            isDuplicate = true;
                                            break;
                                        }
                                    }
                                    if (!isDuplicate)
                                    {
                                        torusCenters.Add(c);
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }
            }
            catch { }
            return torusCenters;
        }

        public static void CreatePipeTree()
        {
            try
            {
                IpfcModelItemOwner itemOwner = WorkingItemOwner;
                IpfcModelItemOwner featureOwner = FeatureItemOwner;

                if (!CheckAndDeleteExistingItems(featureOwner))
                {
                    return;
                }

                int bends = CountDistinctBends(itemOwner);

                if (bends > 1)
                {
                    CreatePipeTreeMultiBend(featureOwner, itemOwner);
                    return;
                }

                List<TerminalSide> terminalSides = FindTerminalSides(itemOwner);
                if (terminalSides.Count < 2)
                {
                    DialogResult askMulti = MessageBox.Show(
                        "Automatic end detection could not resolve 2 terminal ends.\n\n" +
                        "Would you like to manually select Start Point, Three Surfaces, and End Point (Multi-Bend workflow)?",
                        "Manual Selection Mode",
                        MessageBoxButtons.YesNo,
                        MessageBoxIcon.Question);

                    if (askMulti == DialogResult.Yes)
                    {
                        CreatePipeTreeMultiBend(featureOwner, itemOwner);
                    }
                    return;
                }

                EnsureCylindersForTerminalSides(itemOwner, terminalSides);

                if (terminalSides[0].Cylinder == null || terminalSides[1].Cylinder == null)
                {
                    return;
                }

                // Determine shortest pipe leg (startingSide) vs longest leg (endingSide)
                double distToBend0 = double.MaxValue;
                double distToBend1 = double.MaxValue;

                List<double[]> torusCenters = GetTorusCenters(itemOwner);
                if (torusCenters.Count > 0)
                {
                    foreach (var tc in torusCenters)
                    {
                        double d0 = Distance(terminalSides[0].EdgeCenter, tc);
                        double d1 = Distance(terminalSides[1].EdgeCenter, tc);
                        if (d0 < distToBend0) distToBend0 = d0;
                        if (d1 < distToBend1) distToBend1 = d1;
                    }
                }

                double area0 = terminalSides[0].CylinderArea;
                double area1 = terminalSides[1].CylinderArea;

                bool is0Shorter = false;
                if (distToBend0 < double.MaxValue && distToBend1 < double.MaxValue && Math.Abs(distToBend0 - distToBend1) > 0.5)
                {
                    is0Shorter = (distToBend0 < distToBend1);
                }
                else if (area0 > 0.001 && area1 > 0.001 && Math.Abs(area0 - area1) > 0.5)
                {
                    is0Shorter = (area0 < area1);
                }
                else
                {
                    double[] dir1 = GetCylinderAxisDirection(terminalSides[0].Cylinder);
                    double[] dir2 = GetCylinderAxisDirection(terminalSides[1].Cylinder);
                    double[] center1 = terminalSides[0].EdgeCenter;
                    double[] center2 = terminalSides[1].EdgeCenter;
                    double dist1 = area0;
                    double dist2 = area1;

                    if (dir1 != null && dir2 != null && center1 != null && center2 != null)
                    {
                        double[] apexMath = CalculateApexPoint(center1, dir1, center2, dir2);
                        if (apexMath != null)
                        {
                            dist1 = Distance(center1, apexMath);
                            dist2 = Distance(center2, apexMath);
                        }
                    }
                    is0Shorter = (dist1 <= dist2);
                }

                TerminalSide shorterSide = is0Shorter ? terminalSides[0] : terminalSides[1];
                TerminalSide longerSide = is0Shorter ? terminalSides[1] : terminalSides[0];

                DialogResult startChoice = MessageBox.Show(
                    "Where do you want to create the START POINT?\n\n" +
                    "• Click [Yes] to create START POINT on the SMALLEST (shortest) tube .\n" +
                    "• Click [No] to create START POINT on the LONGEST tube .",
                    "Start Point Selection",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

                TerminalSide startingSide = (startChoice == DialogResult.Yes) ? shorterSide : longerSide;
                TerminalSide endingSide = (startChoice == DialogResult.Yes) ? longerSide : shorterSide;


                IpfcModelItem startPoint = CreateDatumPointAtEdgeCenter(featureOwner, startingSide.Edge, "PIPE_START_POINT", PipeComponentPath, out IpfcFeature featStart);
                if (startPoint == null)
                {
                    return;
                }
                SetModelItemName(startPoint, "PIPE_START_POINT", featStart, featureOwner);

                IpfcModelItem axis1 = CreateAxisFromCylinder(featureOwner, startingSide.Cylinder, "A_1", PipeComponentPath, out IpfcFeature featAxis1);
                if (axis1 != null)
                {
                    SetModelItemName(axis1, "A_1", featAxis1, featureOwner);
                }
                else
                {
                    return;
                }

                IpfcModelItem axis2 = CreateAxisFromCylinder(featureOwner, endingSide.Cylinder, "A_2", PipeComponentPath, out IpfcFeature featAxis2);
                if (axis2 != null)
                {
                    SetModelItemName(axis2, "A_2", featAxis2, featureOwner);
                }
                else
                {
                    return;
                }

                IpfcModelItem midpoint = null;
                IpfcFeature featMid = null;
                try
                {
                    IpfcSession sessionContext = (IpfcSession)Session;
                    IpfcSelectionBuffer axisBuffer = sessionContext.CurrentSelectionBuffer;
                    axisBuffer.Clear();

                    IpfcSelection axisSelection1 = new CMpfcSelect().CreateModelItemSelection(axis1, null);
                    IpfcSelection axisSelection2 = new CMpfcSelect().CreateModelItemSelection(axis2, null);
                    axisBuffer.AddSelection(axisSelection1);
                    axisBuffer.AddSelection(axisSelection2);

                    int pointCountBeforeMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT)?.Count ?? 0;
                    int featCountBeforeMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE)?.Count ?? 0;

                    string midpointMacro =
                        "~ Command `ProCmdDatumPointGeneral` ;" +
                        "~ Select `Odui_Dlg_00` `pg_vis_tab` 1 `tab_2`;" +
                        "~ Update `Odui_Dlg_00` `t2.datum_pnt_name` `PIPE_Z_POINT`;" +
                        "~ FocusOut `Odui_Dlg_00` `t2.datum_pnt_name`;" +
                        "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                        "~ Activate `Odui_Dlg_00` `stdbtn_1`;";
                    Session.RunMacro(midpointMacro);
                    Thread.Sleep(350);

                    IpfcModelItems pointsAfterMidpoint = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                    if (pointsAfterMidpoint != null && pointsAfterMidpoint.Count > pointCountBeforeMid)
                    {
                        midpoint = pointsAfterMidpoint[pointsAfterMidpoint.Count - 1];

                        IpfcModelItems featsAfterMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                        if (featsAfterMid != null && featsAfterMid.Count > featCountBeforeMid)
                        {
                            featMid = featsAfterMid[featsAfterMid.Count - 1] as IpfcFeature;
                        }
                        SetModelItemName(midpoint, "PIPE_Z_POINT", featMid, featureOwner);
                    }
                    else
                    {
                    }
                    axisBuffer.Clear();
                }
                catch (Exception)
                {
                }

                IpfcModelItem endPoint = CreateDatumPointAtEdgeCenter(featureOwner, endingSide.Edge, "PIPE_END_POINT", PipeComponentPath, out IpfcFeature featEnd);
                if (endPoint == null)
                {
                    return;
                }
                SetModelItemName(endPoint, "PIPE_END_POINT", featEnd, featureOwner);

                // Final rename sweep across all features to guarantee accurate feature names in tree
                try
                {
                    IpfcModelItems finalFeats = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                    if (finalFeats != null)
                    {
                        for (int f = 0; f < finalFeats.Count; f++)
                        {
                            try
                            {
                                if (!(finalFeats[f] is IpfcFeature feat)) continue;

                                IpfcModelItems subPts = feat.ListSubItems(EpfcModelItemType.EpfcITEM_POINT);
                                if (subPts != null)
                                {
                                    for (int p = 0; p < subPts.Count; p++)
                                    {
                                        if (startPoint != null && subPts[p].Id == startPoint.Id)
                                        {
                                            try { ((IpfcModelItem)feat).SetName("PIPE_START_POINT"); } catch { }
                                        }
                                        else if (midpoint != null && subPts[p].Id == midpoint.Id)
                                        {
                                            try { ((IpfcModelItem)feat).SetName("PIPE_Z_POINT"); } catch { }
                                        }
                                        else if (endPoint != null && subPts[p].Id == endPoint.Id)
                                        {
                                            try { ((IpfcModelItem)feat).SetName("PIPE_END_POINT"); } catch { }
                                        }
                                    }
                                }
                            }
                            catch { }
                        }
                    }
                }
                catch { }

                RegenerateModel();

                Dictionary<string, int> itemsToFind = new Dictionary<string, int>
                {
                    { "PIPE_START_POINT", startPoint.Id },
                    { "PIPE_Z_POINT", midpoint?.Id ?? 0 },
                    { "PIPE_END_POINT", endPoint.Id }
                };

                Dictionary<string, string> nodeNames = FindTreeNodeNames(itemsToFind);

                bool foundStart = nodeNames.TryGetValue("PIPE_START_POINT", out string shorterNode);
                bool foundZ = nodeNames.TryGetValue("PIPE_Z_POINT", out string zRefNode);
                bool foundEnd = nodeNames.TryGetValue("PIPE_END_POINT", out string longerNode);

                if (!foundStart || !foundZ || !foundEnd)
                {
                    return;
                }


                double[] shorterCoords = GetPointCoordinates(startPoint);
                double[] refTargetCoords = midpoint != null ? GetPointCoordinates(midpoint) : GetPointCoordinates(endPoint);

                IpfcModelItem coordinate1 = CreateCoordinateSystem(
                    featureOwner,
                    shorterNode,
                    zRefNode,
                    longerNode,
                    "Axis_Z",
                    "BEND_DATA",
                    withManualPause: true);

                if (coordinate1 != null)
                {
                    RegenerateModel();
                }
                else
                {
                }

                IpfcModelItem coordinate2 = CreateCoordinateSystem(
                    featureOwner,
                    shorterNode,
                    zRefNode,
                    longerNode,
                    "Axis_Z",
                    "PIPE_BOUND_BOX",
                    withManualPause: false);

                if (coordinate2 != null)
                {
                    RegenerateModel();
                    bool isOutward2 = IsZAxisPointingOutward(coordinate2, shorterCoords, refTargetCoords);
                    if (isOutward2)
                    {
                        FlipCoordinateSystemZ(coordinate2);
                        RegenerateModel();
                    }
                }
                else
                {
                }

            }
            catch (Exception)
            {
            }
        }

