        private static bool IsZAxisPointingOutward(
            IpfcModelItem csysItem,
            double[] pOrigin,
            double[] pApex)
        {
            try
            {
                if (csysItem == null || pOrigin == null || pApex == null) return false;

                if (!(csysItem is IpfcCoordSystem csys)) return false;
                IpfcTransform3D transform = csys.CoordSys;
                if (transform == null) return false;
                IpfcVector3D zAxis = transform.GetZAxis();
                if (zAxis == null) return false;

                double[] outward = new double[]
                {
                    pOrigin[0] - pApex[0],
                    pOrigin[1] - pApex[1],
                    pOrigin[2] - pApex[2]
                };

                double outLen = Math.Sqrt(outward[0] * outward[0] + outward[1] * outward[1] + outward[2] * outward[2]);
                double zLen = Math.Sqrt(zAxis[0] * zAxis[0] + zAxis[1] * zAxis[1] + zAxis[2] * zAxis[2]);

                if (outLen < 0.0001 || zLen < 0.0001) return false;

                double dot = (zAxis[0] * outward[0] + zAxis[1] * outward[1] + zAxis[2] * outward[2]) / (outLen * zLen);
                return dot > 0.0;
            }
            catch
            {
                return false;
            }
        }

