                }

                // 5. Select End Point
                IpfcSelection selEnd = PromptUserSelection(
                    "point,edge,datum_point,feature",
                    "Multi-Bend: Select End Point",
                    "Step 5 of 5:\nPlease select the END POINT (or End Circular Edge) in Creo.");
                if (selEnd == null)
                {
