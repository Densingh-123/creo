        private static void RenameCoordinateSystemItem(
            IpfcModelItemOwner itemOwner,
            IpfcModelItem coordinateSystem,
            string coordinateName)
        {
            if (coordinateSystem == null || string.IsNullOrEmpty(coordinateName)) return;

            try
            {
                coordinateSystem.SetName(coordinateName);
            }
            catch { }

            IpfcFeature feat = null;
            try
            {
                if (coordinateSystem is IpfcCoordSystem csysItem)
                {
                    feat = csysItem.GetFeature();
                    if (feat != null)
                    {
                        ((IpfcModelItem)feat).SetName(coordinateName);
                    }
                }
            }
            catch { }

            try
            {
                if (itemOwner != null)
                {
                    IpfcModelItems allFeats = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                    if (allFeats != null)
                    {
                        for (int i = allFeats.Count - 1; i >= 0; i--)
                        {
                            if (allFeats[i] is IpfcFeature f)
                            {
                                bool isMatch = false;
                                if (((IpfcModelItem)f).Id == coordinateSystem.Id) isMatch = true;
                                if (!isMatch)
                                {
                                    IpfcModelItems sub = f.ListSubItems(EpfcModelItemType.EpfcITEM_COORD_SYS);
                                    if (sub != null)
                                    {
                                        for (int s = 0; s < sub.Count; s++)
                                        {
                                            if (sub[s].Id == coordinateSystem.Id) { isMatch = true; break; }
                                        }
                                    }
                                }
                                if (isMatch)
                                {
                                    try { ((IpfcModelItem)f).SetName(coordinateName); } catch { }
                                    feat = f;
                                    break;
                                }
                            }
                        }
                    }
                }
            }
            catch { }

            SetModelItemName(coordinateSystem, coordinateName, feat, itemOwner);
            RegenerateModel();
        }

        private static void CreatePipeTreeMultiBend(IpfcModelItemOwner featureOwner, IpfcModelItemOwner itemOwner)
        {
            try
            {

                // 1. Select Start Point
