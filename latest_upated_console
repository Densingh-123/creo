        private static IpfcModelItem CreateDatumPointFromSelection(
            IpfcModelItemOwner itemOwner,
            IpfcSelection selection,
            string pointName,
            out IpfcFeature createdFeature)
        {
            createdFeature = null;
            if (selection == null) return null;

            try
            {
                IpfcModelItem selItem = selection.get_SelItem();
                IpfcComponentPath path = selection.get_Path() ?? PipeComponentPath;

                if (selItem is IpfcEdge edge)
                {
                    return CreateDatumPointAtEdgeCenter(itemOwner, edge, pointName, path, out createdFeature);
                }

                if (selItem is IpfcPoint pt)
                {
                    SetModelItemName((IpfcModelItem)pt, pointName, null, itemOwner);
                    return (IpfcModelItem)pt;
                }

                if (selItem is IpfcSurface surf)
                {
                    try
                    {
                        IpfcContours contours = surf.ListContours();
                        if (contours != null)
                        {
                            for (int c = 0; c < contours.Count; c++)
                            {
                                IpfcEdges edges = contours[c].ListElements();
                                if (edges != null)
                                {
                                    for (int e = 0; e < edges.Count; e++)
                                    {
                                        if (TryGetCircularEdgeInfo(edges[e], out _, out _))
                                        {
                                            return CreateDatumPointAtEdgeCenter(itemOwner, edges[e], pointName, path, out createdFeature);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }

                IpfcSession creoSession = (IpfcSession)Session;
                IpfcSelectionBuffer selectionBuffer = creoSession.CurrentSelectionBuffer;
                selectionBuffer.Clear();
                selectionBuffer.AddSelection(selection);

                IpfcModelItems pointsBefore = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                int pointCountBefore = pointsBefore?.Count ?? 0;
                IpfcModelItems featsBefore = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                int featCountBefore = featsBefore?.Count ?? 0;

                string pointMacro =
                    "~ Command `ProCmdDatumPointGeneral` ;" +
                    "~ Select `Odui_Dlg_00` `pg_vis_tab` 1 `tab_2`;" +
                    "~ Update `Odui_Dlg_00` `t2.datum_pnt_name` `" + pointName + "`;" +
                    "~ FocusOut `Odui_Dlg_00` `t2.datum_pnt_name`;" +
                    "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

                Session.RunMacro(pointMacro);
                Thread.Sleep(300);

                IpfcModelItems pointsAfter = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                if (pointsAfter != null && pointsAfter.Count > pointCountBefore)
                {
                    IpfcModelItems featsAfter = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                    if (featsAfter != null && featsAfter.Count > featCountBefore)
                    {
                        createdFeature = featsAfter[featsAfter.Count - 1] as IpfcFeature;
                    }

                    IpfcModelItem pointItem = pointsAfter[pointsAfter.Count - 1];
                    SetModelItemName(pointItem, pointName, createdFeature, itemOwner);
                    return pointItem;
                }
            }
            catch (Exception)
            {
            }

            return null;
        }

