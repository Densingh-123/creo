                SetModelItemName(axis1, "A_1", featAxis1, featureOwner);

                // 3. Create Axis A_2 from Surface 2
                IpfcSurface surf2 = selSurf2.get_SelItem() as IpfcSurface;
                IpfcModelItem axis2 = CreateAxisFromCylinder(featureOwner, surf2, "A_2", selSurf2.get_Path() ?? PipeComponentPath, out IpfcFeature featAxis2);
                if (axis2 == null)
                {
                    MessageBox.Show("Failed to create Axis A_2 from Surface 2.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
