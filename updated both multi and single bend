                    _uiAccessor.PerformActionOnElement("Endb_front_select", "disable");
                    _uiAccessor.PerformActionOnElement("endb_front_disable", "image", "/UIAssets/arrow_disabled.png");
                }
                else
                {
                    MessageBox.Show("Select Front Surface in the END_B Fitting", "Warning", MessageBoxButton.OK, MessageBoxImage.Warning, MessageBoxResult.OK, MessageBoxOptions.DefaultDesktopOnly);
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
