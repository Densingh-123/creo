        public void List_COMP()
        {
            try
            {
                IpfcModel model = currentModel;
                AppConstants.Assy_Name = model.InstanceName;
                IpfcModelItemOwner itemown = (IpfcModelItemOwner)model;
                IpfcModelItems items = itemown.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                foreach (IpfcModelItem item in items)
                {
                    IpfcFeature feature = (IpfcFeature)item;
                    if (feature.FeatType == (int)EpfcFeatureType.EpfcFEATTYPE_COMPONENT)
                    {
                        component.Add(item);
                    }
                }

                string binloc = AppDomain.CurrentDomain.BaseDirectory;
                string excelfile = System.IO.Path.Combine(binloc + "Resources", "Fittings_Database.xlsx");

                string targetAColumn = "A";
                string targetBColumn = "B";
                string targetCColumn = "C";

                var workbook = new XLWorkbook(excelfile);
                var worksheet = workbook.Worksheet(1);
                var usedRange = worksheet.RangeUsed();
                AppConstants.lastRow = usedRange.RowCount();
                AppConstants.lastColumn = usedRange.ColumnCount();

                for (int row = 2; row <= AppConstants.lastRow; row++)
                {
                    string columnCValue = worksheet.Cell(row, targetCColumn).GetValue<string>();
                    CreoMethodLists.NUT_NAME.Add(columnCValue);

                    string columnBValue = worksheet.Cell(row, targetBColumn).GetValue<string>();

                    if (columnBValue.ToLower() == "connector")
                    {
                        string columnAValue = worksheet.Cell(row, targetAColumn).GetValue<string>();
                        CreoMethodLists.Connector_NAME.Add(columnAValue);
                    }
                    else if (columnBValue.ToLower() == "sleeve")
                    {
                        string columnAValue = worksheet.Cell(row, targetAColumn).GetValue<string>();
                        CreoMethodLists.Sleeve_NAME.Add(columnAValue);
                    }
                    else if (columnBValue.ToLower() == "ferrules")
                    {
                        string columnAValue = worksheet.Cell(row, targetAColumn).GetValue<string>();
                        CreoMethodLists.Ferrule_NAME.Add(columnAValue);
                    }
                }
                Find_COMP();
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }

        public void Find_COMP()
        {
            try
            {
                IpfcSession new_session = (IpfcSession)session;
                new_session.CurrentSelectionBuffer.Clear();
                for (int i = 0; i < component.Count; i++)
                {
                    IpfcModelItem item = component[i];
                    IpfcFeature feature = (IpfcFeature)item;
                    IpfcComponentFeat Part = (IpfcComponentFeat)feature;
                    string comp_Name = Part.ModelDescr.InstanceName;
                    foreach (string columnAValue in CreoMethodLists.Connector_NAME)
                    {
                        if (columnAValue == comp_Name)
                        {
                            Startend_point(item, "Connector");
                            goto go;
                        }
                    }
                    foreach (string columnAValue in CreoMethodLists.Sleeve_NAME)
                    {
                        if (columnAValue == comp_Name)
                        {
                            Startend_point(item, "Sleeve");
                            goto go;
                        }
                    }
                    foreach (string columnAValue in CreoMethodLists.Ferrule_NAME)
                    {
                        if (columnAValue == comp_Name)
                        {
                            Startend_point(item, "Ferrule");
                            goto go;
                        }
                    }
                    foreach (string columnAValue in CreoMethodLists.NUT_NAME)
                    {
                        if (columnAValue == comp_Name)
                        {
                            Startend_point(item, "Nut");
                            goto go;
                        }
                    }
                    if (comp_Name.ToLower().Contains(AppConstants.Assy_Name.ToLower()))
                    {
                        goto go;
                    }
                go: { }
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }

        }

