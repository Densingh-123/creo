        public void Tubeendscalculation()
        {
            try
            {
                CultureInfo culture = CultureInfo.InvariantCulture;
                CultureInfo.CurrentCulture = culture;

                string binloc = AppDomain.CurrentDomain.BaseDirectory;
                string xmlLoccation = System.IO.Path.Combine(binloc, "HydraulicTube.exe.config");
                XmlDocument doc = new XmlDocument();
                doc.Load(xmlLoccation);
                var tubeEnds = doc.SelectNodes("/configuration/Tolerances/TubeEnds/LengthRange");

                foreach (XmlNode lengthRange in tubeEnds)
                {
                    string length = lengthRange.SelectSingleNode("Length").InnerText;
                    var match = Regex.Match(length, @"([≤<=>]*)\s*(\d+)\s*mm");
                    string symbol = match.Groups[1].Value;
                    double _length = double.Parse(match.Groups[2].Value);
                    bool comparisonResult = CompareLengths(symbol, _length, AppConstants.totalpipelength);
                    if (comparisonResult == true)
                    {
                        var bendsList = lengthRange.SelectNodes("Bends");
                        foreach (XmlNode bends in bendsList)
                        {

                            string bendrange = bends.SelectSingleNode("BendsRange").InnerText;
                            var match1 = Regex.Match(bendrange, @"([≤<=>]*)\s*(\d+)");
                            var match2 = Regex.Match(bendrange, @"(\d+)\s*([≤<=>]+)\s*b\s*([≤<=>]+)\s*(\d+)");

                            if (match2.Success)
                            {
                                double lowerBound = double.Parse(match2.Groups[1].Value);
                                string lowerSymbol = match2.Groups[2].Value;
                                string upperSymbol = match2.Groups[3].Value;
                                double upperBound = double.Parse(match2.Groups[4].Value);

                                bool totalbends = CompareLengths(lowerSymbol, lowerBound, upperSymbol, upperBound, AppConstants.Bendcount);

                                if (totalbends)
                                {
                                    AppConstants.TubeValue = bends.SelectSingleNode("Diameter/DiameterValue").InnerText;
                                    Regex regex = new Regex(@"\d+");
                                    Match matches = regex.Match(AppConstants.TubeValue);
                                    AppConstants.TubeValue = matches.Value;
                                    break;
                                }
                            }
                            else if (match1.Success)
                            {
                                string symbols = match1.Groups[1].Value;
                                double range = double.Parse(match1.Groups[2].Value);
                                bool totalbends = CompareLengths(symbols, range, AppConstants.Bendcount);
                                if (totalbends == true)
                                {

                                    AppConstants.TubeValue = bends.SelectSingleNode("Diameter/DiameterValue").InnerText;
                                    Regex regex = new Regex(@"\d+");
                                    Match matches = regex.Match(AppConstants.TubeValue);
                                    AppConstants.TubeValue = matches.Value;
                                    break;
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }

        static bool CompareLengths(string symbol, double length, double valueToCompare)
        {
            switch (symbol)
            {
                case "≤":
                    return valueToCompare <= length;
                case "<":
                    return valueToCompare < length;
                case "=":
                    return valueToCompare == length;
                case ">":
                    return valueToCompare > length;
                case "≥":
                    return valueToCompare >= length;
                default:
                    throw new InvalidOperationException($"Unsupported comparison symbol: {symbol}");
            }
        }

        private static bool CompareLengths(string lowerSymbol, double lowerBound, string upperSymbol, double upperBound, double value)
        {
            bool isWithinLowerBound = false;
            bool isWithinUpperBound = false;

            switch (lowerSymbol)
            {
                case "≤":
                    isWithinLowerBound = value >= lowerBound;
                    break;
                case "<":
                    isWithinLowerBound = value > lowerBound;
                    break;
                case "=":
                    isWithinLowerBound = value == lowerBound;
                    break;
            }

            switch (upperSymbol)
            {
                case "≤":
                    isWithinUpperBound = value <= upperBound;
                    break;
                case "<":
                    isWithinUpperBound = value < upperBound;
                    break;
                case "=":
                    isWithinUpperBound = value == upperBound;
                    break;
            }

            return isWithinLowerBound && isWithinUpperBound;
        }

