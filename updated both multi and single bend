        public void Fetchvalue_BLOC()
        {
            try
            {
                string BLOC_filePath = System.IO.Path.GetTempPath() + "\\BLOC.txt.1";
                if (!File.Exists(BLOC_filePath))
                {
                    MessageBox.Show("BEND_LOCS not available, Please rerun the application after running the Bend Location mapkey (PPL).", "Warning", MessageBoxButton.OK, MessageBoxImage.Warning, MessageBoxResult.OK, MessageBoxOptions.DefaultDesktopOnly);
                    CreoDisconnect();
                    Environment.Exit(0);
                }
                string[] lines = File.ReadAllLines(BLOC_filePath);
                foreach (string line in lines)
                {
                    try
                    {
                        if (line.Contains("Bend Location Csys  : "))
                        {
                            string pattern = @":\s*(.*)";
                            Match match = Regex.Match(line, pattern);
                            if (match.Success)
                            {
                                AppConstants.Bend_Location_Csys = match.Groups[1].Value;
                            }
                            if (AppConstants.Bend_Location_Csys.ToLower().Contains(("n/a")))
                            {
                                File.Delete(System.IO.Path.GetTempPath() + "\\BLOC.txt.1");
                                MessageBox.Show("Delete the empty Bend Location table and run (PPL) map keys for proper Bend location data. ", "Warning", MessageBoxButton.OK, MessageBoxImage.Warning, MessageBoxResult.OK, MessageBoxOptions.DefaultDesktopOnly);
                                CreoDisconnect();
                                Environment.Exit(0);


                            }

                        }
                        string[] values = line.Split(new char[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
                        double result;
                        if (values.Length >= 4)
                        {
                            if (double.TryParse(values[0], out result))
                            {
                                CultureInfo culture = CultureInfo.InvariantCulture;
                                CultureInfo.CurrentCulture = culture;
                                string N = values[0];
                                double n = double.Parse(N, CultureInfo.InvariantCulture);
                                CreoMethodLists.num_point.Add(n);
                                if (double.TryParse(values[1], out result))
                                {
                                    string X = values[1];
                                    double x = double.Parse(X, CultureInfo.InvariantCulture);
                                    CreoMethodLists.X_list.Add(x);
                                }
                                if (double.TryParse(values[2], out result))
                                {
                                    string Y = values[2];
                                    double y = double.Parse(Y, CultureInfo.InvariantCulture);
                                    CreoMethodLists.Y_list.Add(y);
                                }
                                if (double.TryParse(values[3], out result))
                                {
                                    string Z = values[3];
                                    double z = double.Parse(Z, CultureInfo.InvariantCulture);
                                    CreoMethodLists.Z_list.Add(z);
                                }
                            }
                        }
                    }
                    catch
                    {
                        continue;
                    }
                }
                AppConstants.Bendcount = CreoMethodLists.num_point.Count - 2;
                File.Delete(System.IO.Path.GetTempPath() + "\\BLOC.txt.1");
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }

