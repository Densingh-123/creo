        private void KillProcess(string processName)
        {
            Process[] allrunningProcess = Process.GetProcessesByName(processName);
            foreach (Process runningProcess in allrunningProcess)
            {
                try
                {
                    runningProcess.Kill();
                }
                catch
                {
                    continue;
                }
            }
        }

