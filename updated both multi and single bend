        public void ChkPipeLine_Ref()
        {
            try
            {
                bool ismsgbox = false;
                ObjCreoMacros.ref_file(this);
                string tempdirectory = System.IO.Path.GetTempPath();
                string filePath = tempdirectory + "reference.txt.1";
                IpfcModel model = currentModel;
                IpfcModelItemOwner modelItemOwner = (IpfcModelItemOwner)model;
                IpfcModelItems items = modelItemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                foreach (IpfcModelItem item in items)
                {
                    IpfcFeature feat = (IpfcFeature)item;
                    if (feat.FeatType == (int)EpfcFeatureType.EpfcFEATTYPE_PIPE_SET_START || feat.FeatType == (int)EpfcFeatureType.EpfcFEATTYPE_PIPE_POINT_TO_POINT || feat.FeatType == (int)EpfcFeatureType.EpfcFEATTYPE_PIPE_EXTEND)
                    {
                        IpfcFeatures parents = feat.ListParents();
                        foreach (IpfcModelItem parent in parents)
                        {
                            IpfcFeature subfeat = (IpfcFeature)parent;

                            if (subfeat.FeatType == (int)EpfcFeatureType.EpfcFEATTYPE_COMPONENT)
                            {
                                string FeatName = feat.FeatTypeName;
                                TextInfo textInfo = CultureInfo.CurrentCulture.TextInfo;
                                string result = textInfo.ToTitleCase(FeatName.ToLower());
                                int featid = item.Id;
                                string Name = result + " id " + featid;
                                string asm_name = model.FileName.ToUpper();
                                string Top_chk = "(Top Level) ->";
                                string Csys = "Coordinate System";

                                string[] lines = File.ReadAllLines(filePath);
                                for (int l = 0; l < lines.Length; l++)
                                {
                                    string line = lines[l];
                                    if (line.Contains(Name))
                                    {
                                        if (line.Contains(asm_name))
                                        {
                                            if (line.Contains(Top_chk))
                                            {
                                                string nxt1_line = lines[l + 1];
                                                if (nxt1_line.Contains(Csys))
                                                {
                                                    MessageBoxResult Msgboxresult = MessageBox.Show("The active pipe assembly does not comply with the CPDD-0103 model practice standards. Do you still want to proceed? \n \n(Not used points reference for routing)", "Information", MessageBoxButton.YesNo, MessageBoxImage.Information, MessageBoxResult.Yes, MessageBoxOptions.DefaultDesktopOnly);
                                                    if (Msgboxresult == MessageBoxResult.Yes)
                                                    {
                                                        ismsgbox = true;
                                                        break;
                                                    }
                                                    else
                                                    {
                                                        CreoDisconnect();
                                                        Environment.Exit(1);
                                                    }

                                                }
                                                string nxt2_line = lines[l + 2];
                                                if (nxt2_line.Contains(Csys))
                                                {
                                                    MessageBoxResult Msgboxresult = MessageBox.Show("The active pipe assembly does not comply with the CPDD-0103 model practice standards. Do you still want to proceed? \n \n(Not used points reference for routing)", "Information", MessageBoxButton.YesNo, MessageBoxImage.Information, MessageBoxResult.Yes, MessageBoxOptions.DefaultDesktopOnly);
                                                    if (Msgboxresult == MessageBoxResult.Yes)
                                                    {
                                                        ismsgbox = true;
                                                        break;
                                                    }
                                                    else
                                                    {
                                                        CreoDisconnect();
                                                        Environment.Exit(1);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (ismsgbox)
