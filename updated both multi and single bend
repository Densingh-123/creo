        {
            try
            {
                IpfcSelectionOptions selectionOptions = new CCpfcSelectionOptions().Create("surface");
                selectionOptions.MaxNumSels = 1;
                IpfcSelections selections = session.Select(selectionOptions, null);
                if (selections.Count <= 0)
                    return;
                IpfcSelection pipePartSel = selections[0];
                IpfcModelItem item = (IpfcModelItem)pipePartSel.get_SelItem();
                IpfcModel modelselected = (IpfcModel)pipePartSel.SelModel;

                string Non_STD_EndA_Partnumber = modelselected.InstanceName;
                IpfcComponentPath path = pipePartSel.get_Path();
                int Non_std_EndA_componentID = path.ComponentIds[0];
                int EndA_Frontid = item.Id;

                pipePartSel.UnHighlight();

                if (AppConstants.endacomponentId == Non_std_EndA_componentID)
                {
                    IpfcModelItemOwner modelItemOwner = (IpfcModelItemOwner)modelselected;
                    IpfcModelItems items = modelItemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                    foreach (IpfcSurface Surf in items)
                    {
                        try
                        {
                            if (Surf.GetSurfaceDescriptor().GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                            {
                                IpfcFeature feature = Surf.GetFeature();
                                if (feature.FeatType != (int)EpfcFeatureType.EpfcFEATTYPE_ROUND)
                                {
                                    IpfcModelItem innersurf_item = (IpfcModelItem)Surf;
                                    AppConstants.EndA_Innersurface = innersurf_item.Id.ToString();
                                }
                                break;
                            }
                        }
                        catch
                        {
                            continue;
                        }
                    }

                    IpfcSurface ModelSurface = (IpfcSurface)item;
                    IpfcContours ListContures = ModelSurface.ListContours();
                    foreach (IpfcContour Contour in ListContures)
                    {
                        if (Contour.InternalTraversal == (int)EpfcContourTraversal.EpfcCONTOUR_TRAV_EXTERNAL)
                        {
                            IpfcEdges ModelEdegs = (IpfcEdges)Contour.ListElements();
                            foreach (IpfcEdge ModelEdge in ModelEdegs)
                            {
                                IpfcModelItem edge_item = (IpfcModelItem)ModelEdge.Edge1;
                                AppConstants.EndA_FrontEdge = edge_item.Id.ToString();
                                break;
                            }
                            break;
                        }
                    }
                    _uiAccessor.PerformActionOnElement("EndA_Textbox_Front", "clear");
                    _uiAccessor.UpdateElement("EndA_Textbox_Front", " " + Non_STD_EndA_Partnumber + "(" + "Surf: " + EndA_Frontid + ")");
                    _uiAccessor.PerformActionOnElement("EndA_Textbox_Front", "disable");
                    _uiAccessor.PerformActionOnElement("Enda_front_select", "disable");
                    _uiAccessor.PerformActionOnElement("enda_front_disable", "image", "/UIAssets/arrow_disabled.png");
                }
                else
                {
                    MessageBox.Show("Select Front Surface in the END_A Fitting", "Warning", MessageBoxButton.OK, MessageBoxImage.Warning, MessageBoxResult.OK, MessageBoxOptions.DefaultDesktopOnly);
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }

