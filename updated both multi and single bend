        public void FitEndASelect()
        {
            try
            {
                IpfcSelectionOptions selectionOptions = new CCpfcSelectionOptions().Create("component");
                selectionOptions.MaxNumSels = 1;
                IpfcSelections selections = session.Select(selectionOptions, null);
                if (selections.Count <= 0)
                    return;
                IpfcSelection pipePartSel = selections[0];
                IpfcModelItem item = (IpfcModelItem)pipePartSel.get_SelItem();
                IpfcModel modelselected = (IpfcModel)pipePartSel.SelModel;
                IpfcAssembly assy = (IpfcAssembly)modelselected;
                IpfcModelItem Pnt_item = Points[0];
                IpfcSelection Pnt_sel = new CMpfcSelect().CreateModelItemSelection(Pnt_item, null);
                Cintseq ids = new Cintseq();
                ids.Set(0, item.Id);
                IpfcComponentPath com_path = new CMpfcAssembly().CreateComponentPath(assy, ids);
                IpfcSelection COMP_sel = new CMpfcSelect().CreateComponentSelection(com_path);
                IpfcSelectionPair selectionPair = new CCpfcSelectionPair().Create(Pnt_sel, COMP_sel);
                IpfcSelectionEvaluator selectionEvaluator = new CMpfcInterference().CreateSelectionEvaluator(selectionPair);
                IpfcCriticalDistanceData distanceData = selectionEvaluator.ComputeNearestCriticalDistance();
                double Distance_A = distanceData.Distance;
                Pnt_item = Points[Points.Count - 1];
                Pnt_sel = new CMpfcSelect().CreateModelItemSelection(Pnt_item, null);
                selectionPair = new CCpfcSelectionPair().Create(Pnt_sel, COMP_sel);
                selectionEvaluator = new CMpfcInterference().CreateSelectionEvaluator(selectionPair);
                distanceData = selectionEvaluator.ComputeNearestCriticalDistance();
                double Distance_B = distanceData.Distance;
                if (Distance_A < Distance_B)
                {
                    IpfcFeature feature = (IpfcFeature)item;
                    IpfcComponentFeat Part = (IpfcComponentFeat)feature;
                    string Fitting_Name = Part.ModelDescr.InstanceName;

                    AppConstants.Non_EndA_componentID = item.Id;
                    AppConstants.endacomponentId = item.Id;
                    AppConstants.Non_EndA = Fitting_Name;

                    _uiAccessor.PerformActionOnElement("EndA_Partnumber", "clear");
                    _uiAccessor.UpdateElement("EndA_Partnumber", " " + Fitting_Name);
                    _uiAccessor.PerformActionOnElement("EndA_Partnumber", "disable");

                    IpfcModelDescriptor compModelDesc = Part.ModelDescr;
                    IpfcModel compModel = session.GetModelFromDescr(compModelDesc);
                    IpfcParameterOwner param = (IpfcParameterOwner)compModel;
                    IpfcParameter parameter = param.GetParam("DESCRIPTION");
                    if (parameter != null)
                    {
                        string Description = parameter.GetScaledValue().StringValue;
                        _uiAccessor.PerformActionOnElement("EndA_Description", "clear");
                        _uiAccessor.UpdateElement("EndA_Description", " " + Description);
                        _uiAccessor.PerformActionOnElement("EndA_Description", "disable");
                        _uiAccessor.PerformActionOnElement("EndA_fit_Slt", "disable");
                        _uiAccessor.PerformActionOnElement("Enda_Fit_disabled", "image", "/UIAssets/arrow_disabled.png");
                    }
                    else
                    {
                        _uiAccessor.PerformActionOnElement("EndA_Description", "clear");
                        _uiAccessor.UpdateElement("EndA_Description", " No Description");
                        _uiAccessor.PerformActionOnElement("EndA_Description", "disable");
                        _uiAccessor.PerformActionOnElement("EndA_fit_Slt", "disable");
                        _uiAccessor.PerformActionOnElement("Enda_Fit_disabled", "image", "/UIAssets/arrow_disabled.png");
