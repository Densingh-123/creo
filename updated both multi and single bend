        public void Multi_CSYSChk()
        {
            int Csys_count = 0;
            IpfcModel model = currentModel;
            IpfcModelItemOwner itemown = (IpfcModelItemOwner)model;
            IpfcModelItems items = itemown.ListItems(EpfcModelItemType.EpfcITEM_COORD_SYS);
            foreach (IpfcModelItem item in items)
            {
                string Coor_sys = item.GetName();
                if (Coor_sys.ToLower() == AppConstants.Bend_Location_Csys.ToLower())
                {
                    Csys_count++;
                }
            }
            IpfcModelItems Comp_items = itemown.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
            foreach (IpfcModelItem Comp_item in Comp_items)
            {
                IpfcFeature feature = (IpfcFeature)Comp_item;
                if (feature.FeatType == (int)EpfcFeatureType.EpfcFEATTYPE_COMPONENT)
                {
                    IpfcComponentFeat Part = (IpfcComponentFeat)feature;
                    IpfcModelDescriptor compModelDesc = Part.ModelDescr;
