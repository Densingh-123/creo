        public void GetSurface(IpfcModel Model)
        {
            try
            {
                IpfcModelItemOwner MdlOwner = (IpfcModelItemOwner)Model;
                IpfcModelItems ModelItems = MdlOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                List<double[]> Surface_area = new List<double[]>();

                for (int i = 0; i < ModelItems.Count; i++)
                {
                    IpfcModelItem item = ModelItems[i];
                    IpfcSurface Surface = (IpfcSurface)item;
                    if (Surface.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_PLANE)
                    {
                        double AreaValue = Surface.EvalArea();
                        Surface_area.Add(new double[] { AreaValue, item.Id });
                    }
                }

                var topTwoSurfaces = Surface_area
                        .OrderByDescending(x => x[0])
                        .Take(2)
                        .ToList();
                int surfaceId1 = -1;
                int surfaceId2 = -1;
                if (topTwoSurfaces.Count >= 1)
                {
                    double maxArea1 = topTwoSurfaces[0][0];
                    surfaceId1 = (int)topTwoSurfaces[0][1];
                    Items.Add(surfaceId1);

                }

                if (topTwoSurfaces.Count == 2)
                {
                    double maxArea2 = topTwoSurfaces[1][0];
                    surfaceId2 = (int)topTwoSurfaces[1][1];
                    Items.Add(surfaceId2);
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }

        public void formedenddistancecalculation(List<int> surfaceItems, int COMP_ID)
        {
            try
            {
                IpfcSession new_session = (IpfcSession)session;
                IpfcAssembly assy = (IpfcAssembly)currentModel;
                foreach (int Surf_item in surfaceItems)
                {
                    IpfcModelItemOwner MdlOwner = (IpfcModelItemOwner)Tubemodel;
                    IpfcModelItem modelItem1 = MdlOwner.GetItemById(1, Surf_item);
                    double Distance_A = 0;
                    double Distance_B = 0;

                    IpfcModelItem Pnt_item;
                    IpfcSelection Pnt_sel;
                    IpfcSelection Surf_sel;

                    Pnt_item = Points[0];
                    int pid = Pnt_item.Id;
                    Pnt_sel = new CMpfcSelect().CreateModelItemSelection(Pnt_item, null);
                    //new_session.CurrentSelectionBuffer.AddSelection(Pnt_sel);
                    Cintseq ids = new Cintseq();
                    ids.Set(0, COMP_ID);
                    IpfcComponentPath com_path = new CMpfcAssembly().CreateComponentPath(assy, ids);
                    Surf_sel = new CMpfcSelect().CreateModelItemSelection(modelItem1, com_path);

                    //new_session.CurrentSelectionBuffer.AddSelection(Surf_sel);

                    if (Pnt_sel != null)
                    {
                        IpfcSelectionPair selectionPair = new CCpfcSelectionPair().Create(Pnt_sel, Surf_sel);
                        IpfcSelectionEvaluator selectionEvaluator = new CMpfcInterference().CreateSelectionEvaluator(selectionPair);
                        IpfcCriticalDistanceData distanceData = selectionEvaluator.ComputeNearestCriticalDistance();
                        Distance_A = distanceData.Distance;
                    }

                    new_session.CurrentSelectionBuffer.Clear();
                    Pnt_item = Points[Points.Count - 1];
                    pid = Pnt_item.Id;
                    Pnt_sel = new CMpfcSelect().CreateModelItemSelection(Pnt_item, null);


                    if (Pnt_sel != null)
                    {
                        IpfcSelectionPair selectionPair = new CCpfcSelectionPair().Create(Pnt_sel, Surf_sel);
                        IpfcSelectionEvaluator selectionEvaluator = new CMpfcInterference().CreateSelectionEvaluator(selectionPair);
                        IpfcCriticalDistanceData distanceData = selectionEvaluator.ComputeNearestCriticalDistance();
                        Distance_B = distanceData.Distance;
                    }
                    if (Distance_A < Distance_B)
                    {
                        if (AppConstants.FrstMaxEdgesurface == null)
                        {
                            IpfcModelItem modelItem = MdlOwner.GetItemById(1, Surf_item);
                            IpfcSurface modelSurface = (IpfcSurface)modelItem;
                            IpfcContours listContours = modelSurface.ListContours();

                            foreach (IpfcContour contour in listContours)
                            {
                                if (contour.InternalTraversal == (int)EpfcContourTraversal.EpfcCONTOUR_TRAV_EXTERNAL)
                                {
                                    IpfcEdges modelEdges = (IpfcEdges)contour.ListElements();
                                    foreach (IpfcEdge modelEdge in modelEdges)
                                    {
                                        IpfcModelItem edgeItem = (IpfcModelItem)modelEdge.Edge1;
                                        AppConstants.FrstMaxEdgesurface = edgeItem.Id.ToString();
                                        break;
                                    }
                                    break;
                                }
                            }
                        }
                    }
                    else
                    {
                        if (AppConstants.ScndMaxEdgesurface == null)
                        {
                            IpfcModelItem modelItem = MdlOwner.GetItemById(1, Surf_item);
                            IpfcSurface modelSurface = (IpfcSurface)modelItem;
                            IpfcContours listContours = modelSurface.ListContours();

                            foreach (IpfcContour contour in listContours)
                            {
                                if (contour.InternalTraversal == (int)EpfcContourTraversal.EpfcCONTOUR_TRAV_EXTERNAL)
                                {
                                    IpfcEdges modelEdges = (IpfcEdges)contour.ListElements();
                                    foreach (IpfcEdge modelEdge in modelEdges)
                                    {
                                        IpfcModelItem edgeItem = (IpfcModelItem)modelEdge.Edge1;
                                        AppConstants.ScndMaxEdgesurface = edgeItem.Id.ToString();
                                        break;
