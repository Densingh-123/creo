        public void drawingscheck()
        {
            try
            {
                IpfcModel _model = session.CurrentModel;
                currentModel = session.CurrentModel;
                if (_model.Type != 0)
                {
                    MessageBox.Show("The current model is not a proper assembly.", "Warning", MessageBoxButton.OK, MessageBoxImage.Warning, MessageBoxResult.OK, MessageBoxOptions.DefaultDesktopOnly);
                    Environment.Exit(0);
                    CreoDisconnect();
                }
                else
                {
                    IpfcModel ParrentModel3D = currentModel;
                }
                bool ismsgboxvisible = false;
                string drawing = currentModel.FullName;

                string asmtodrw = drawing.ToLower();
                asmtodrw += ".drw";
                string workdir = session.GetCurrentDirectory();
                string[] filesInDirectory = Directory.GetFiles(workdir);
                foreach (string file in filesInDirectory)
                {
                    try
                    {
                        string filename = System.IO.Path.GetFileNameWithoutExtension(file);
                        if (filename == asmtodrw)
                        {
                            if (!ismsgboxvisible)
                            {
                                MessageBoxResult result = MessageBox.Show("Drawing with same PN " + "\" " + drawing + ".drw" + " \"" + " is already available in workspace. Do you want to continue.", "Information", MessageBoxButton.YesNo, MessageBoxImage.Information, MessageBoxResult.Yes, MessageBoxOptions.DefaultDesktopOnly);
                                if (result == MessageBoxResult.No)
                                {
                                    CreoDisconnect();
                                    Environment.Exit(0);
                                }
                                ismsgboxvisible = true;
                            }
                            CreoMethodLists.filesToRename.Add(file);
                        }
                    }
                    catch
                    {
                        continue;
                    }
                }
                foreach (string fileToRename in CreoMethodLists.filesToRename)
                {
                    try
                    {
                        string filename = System.IO.Path.GetFileNameWithoutExtension(fileToRename);
                        string filenewname = fileToRename.Replace(filename, filename + "_Backup");
                        if (File.Exists(filenewname))
                        {
                            FileSystem.DeleteFile(filenewname, UIOption.OnlyErrorDialogs, RecycleOption.SendToRecycleBin);
                            File.Move(fileToRename, filenewname);
                        }
                        else
                        {
                            File.Move(fileToRename, filenewname);
                        }
                    }
                    catch
                    {
                        continue;
                    }
                }
                IpfcModels models = session.ListModels();
                foreach (IpfcModel model in models)
                {
                    try
                    {
                        string ModelName = model.FileName;
                        if (ModelName == asmtodrw)
                        {
                            model.Erase();
                        }
                    }
                    catch
                    {
                        continue;
                    }
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }

