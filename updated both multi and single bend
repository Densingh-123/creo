        public void drawingsave(_2DDrawing objdrawing)
        {
            try
            {
                foreach (string fileToRename in CreoMethodLists.filesToRename)
                {
                    try
                    {
                        string filename = System.IO.Path.GetFileNameWithoutExtension(fileToRename);
                        string filenewname = fileToRename.Replace(filename, filename + "_Backup");
                        File.Move(filenewname, fileToRename);
                    }
                    catch
                    {
                        continue;
                    }
                }
                IpfcModel model = currentModel;
                if (model.Type == (int)EpfcModelType.EpfcMDL_DRAWING)
                {
                    string instancename = model.InstanceName;
                    IpfcModelDescriptor ModelDescriptor = new CCpfcModelDescriptor().Create((int)EpfcModelType.EpfcMDL_DRAWING, instancename, null);
                    string workingDirectory = session.GetCurrentDirectory();
                    ModelDescriptor.Path = workingDirectory;
                    model.Backup(ModelDescriptor);
                }
                else
                {
                    session.RunMacro("%/ocd");
                    CreoStatus();

                    IpfcWindow window = session.GetModelWindow(objdrawing.currentdwg);
                    window.Activate();

                    string instancename = model.InstanceName;
                    IpfcModelDescriptor ModelDescriptor = new CCpfcModelDescriptor().Create((int)EpfcModelType.EpfcMDL_DRAWING, instancename, null);
                    string workingDirectory = session.GetCurrentDirectory();
                    ModelDescriptor.Path = workingDirectory;
                    objdrawing.currentdwg.Backup(ModelDescriptor);
                }
            }
            catch (Exception e)
            {
                string exceptione = e.ToString();
                LogManager.readlogCatch(exceptione);
            }
        }



