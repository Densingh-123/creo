                                if (feature.FeatType != (int)EpfcFeatureType.EpfcFEATTYPE_ROUND)
                                {
                                    IpfcModelItem innersurf_item = (IpfcModelItem)Surf;
                                    AppConstants.EndB_Innersurface = innersurf_item.Id.ToString();
                                }
                                break;
                            }
                        }
                        catch
                        {
                            continue;
                        }
                    }

                    IpfcSurface ModelSurface = (IpfcSurface)item;
                    IpfcContours ListContures = ModelSurface.ListContours();
                    foreach (IpfcContour Contour in ListContures)
                    {
                        if (Contour.InternalTraversal == (int)EpfcContourTraversal.EpfcCONTOUR_TRAV_EXTERNAL)
                        {
                            IpfcEdges ModelEdegs = (IpfcEdges)Contour.ListElements();
                            foreach (IpfcEdge ModelEdge in ModelEdegs)
                            {
                                IpfcModelItem edge_item = (IpfcModelItem)ModelEdge.Edge1;
                                AppConstants.EndB_FrontEdge = edge_item.Id.ToString();
                                break;
                            }
                            break;
                        }
                    }
                    _uiAccessor.PerformActionOnElement("EndB_Textbox_Front", "clear");
                    _uiAccessor.UpdateElement("EndB_Textbox_Front", " " + Non_STD_EndB_Partnumber + "(" + "Surf: " + EndB_Frontid + ")");
