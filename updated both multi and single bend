        public void LeaderNote(int i, int count, string Leadernotevalue)
        {
            int midcount = count / 2;
            //new_session.CurrentSelectionBuffer.Clear();
            IpfcModel2D LeaderModel2D = currentModel as IpfcModel2D;
            if (LeaderModel2D == null)
            {
                LogManager.readlogCatch("LeaderNote: current model is not a 2D drawing.");
                return;
            }
            IpfcDetailItemOwner DeatilOwner = LeaderModel2D as IpfcDetailItemOwner;
            IpfcDetailTextLines TextLines = new CpfcDetailTextLines();
            string[] lines = Regex.Split(Leadernotevalue, "\\n");
            foreach (string line in lines)
            {
                IpfcDetailText Text = new CCpfcDetailText().Create(line);
                IpfcDetailTexts Texts = new CpfcDetailTexts();
                Texts.Append(Text);
                IpfcDetailTextLine Line = new CCpfcDetailTextLine().Create((CpfcDetailTexts)Texts);
                TextLines.Append(Line);
            }

            var random = new Random();
            //int index = random.Next(1, ModelItemcCurveList.Count / 2);
            //IpfcModelItem curveitem = ModelItemcCurveList[0];
            IpfcView2Ds ViewList = LeaderModel2D.List2DViews();
            foreach (IpfcView2D view in ViewList)
            {
                try
                {
                    if (view.GetSheetNumber() == 1)
                    {
                        if (view.Name == "- FACE")
                        {
                            IpfcOutline3D outline = view.Outline;
                            CpfcPoint3D location = new CpfcPoint3D();
                            if (i < midcount)
                            {
                                double one = outline[0][0];
                                double two = outline[0][1];
                                double three = outline[1][0];
                                double four = outline[1][1];

                                location.Set(0, (outline[0][0]) - 10);
                                location.Set(1, (outline[1][1]) - Leadernote_left);
                                switch (Sheetsize)
                                {
                                    case "A1":
                                        Leadernote_left = Leadernote_left + (TextLines.Count * 5 + 15);
                                        break;
                                    case "A2":
                                        Leadernote_left = Leadernote_left + (TextLines.Count * 10 + 5);
                                        break;
                                    case "A3":
                                        Leadernote_left = Leadernote_left + (TextLines.Count * 10 + 30);
                                        break;
                                    case "A4":
                                        Leadernote_left = Leadernote_left + (TextLines.Count * 10 + 60);
                                        break;
                                }
                            }
                            else
                            {
                                location.Set(0, (outline[1][0]) + 10);
                                location.Set(1, (outline[1][1]) - Leadernote_right);
                                switch (Sheetsize)
                                {
                                    case "A1":
                                        Leadernote_right = Leadernote_right + (TextLines.Count * 5 + 15);
                                        break;
                                    case "A2":
                                        Leadernote_right = Leadernote_right + (TextLines.Count * 10 + 5);
                                        break;
                                    case "A3":
                                        Leadernote_right = Leadernote_right + (TextLines.Count * 10 + 30);
                                        break;
                                    case "A4":
                                        Leadernote_right = Leadernote_right + (TextLines.Count * 10 + 60);
                                        break;
                                }
                            }
                            IpfcFreeAttachment FreeAttachment = new CCpfcFreeAttachment().Create(location);
                            IpfcAttachment Attachment = (IpfcAttachment)FreeAttachment;
                            IpfcModel ModelView = view.GetModel();
                            IpfcSelection SelView = new CMpfcSelect().CreateModelSelection(ModelView);
                            SelView.set_SelView2D(view);
                            //SelView.set_SelItem(curveitem);
                            IpfcSession new_session = (IpfcSession)session;
                            new_session.CurrentSelectionBuffer.AddSelection(SelView);
                            IpfcParametricAttachment parametricAttachment = new CCpfcParametricAttachment().Create(SelView);
                            IpfcAttachment LAttachment = (IpfcAttachment)parametricAttachment;
                            IpfcDetailNoteItem LeaderNote;
                            try
                            {
                                IpfcLeaderAttachment LeaderAttachment = new CCpfcLeaderAttachment().Create(LAttachment);
                                IpfcLeaderAttachments LeaderAttachments = new CpfcLeaderAttachments();
                                LeaderAttachments.Append(LeaderAttachment);
                                LeaderNote = DeatilOwner.CreateLeaderNote((CpfcDetailTextLines)TextLines, Attachment, (CpfcLeaderAttachments)LeaderAttachments, null);
                            }
                            catch
                            {
                                LeaderNote = DeatilOwner.CreateFreeNote((CpfcDetailTextLines)TextLines, FreeAttachment);
                            }
                            IpfcAnnotationTextStyle Textstyle = new CCpfcAnnotationTextStyle().Create();
                            if (i < midcount)
                            {
                                Textstyle.SetHorizontalJustification((int)EpfcHorizontalJustification.EpfcH_JUSTIFY_RIGHT);
                                LeaderNote.SetNoteTextStyle(Textstyle);
                            }
                            else
                            {
                                Textstyle.SetHorizontalJustification((int)EpfcHorizontalJustification.EpfcH_JUSTIFY_LEFT);
                                LeaderNote.SetNoteTextStyle(Textstyle);
                            }
                            LeaderNote.Show();
                            noof_leadernote = noof_leadernote + 1;
                            //Logger.Log($"Annotation Added");
                        }
                    }
                }
                catch (Exception)
                { //Logger.Log("Failed_" + ex.Message); }
                }
            }

