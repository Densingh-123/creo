        private static bool TryGetCircularEdgeInfo(IpfcEdge edge, out double[] center, out double radius)
        {
            center = null;
            radius = 0.0;
            try
            {
                IpfcGeomCurve geomCurve = edge as IpfcGeomCurve;
                if (geomCurve == null) return false;

                IpfcCurveDescriptor desc = geomCurve.GetCurveDescriptor();
                if (desc == null) return false;

                int curveType = (int)desc.GetCurveType();

                if (curveType == (int)EpfcCurveType.EpfcCURVE_ARC)
                {
                    IpfcArcDescriptor arcDesc = (IpfcArcDescriptor)desc;
                    CpfcPoint3D arcCenter = (CpfcPoint3D)arcDesc.Center;
                    if (arcCenter != null)
                    {
                        center = new double[] { arcCenter[0], arcCenter[1], arcCenter[2] };
                        radius = arcDesc.Radius;
                        return radius > 0.001;
                    }
                }
                else if (curveType == (int)EpfcCurveType.EpfcCURVE_CIRCLE)
                {
                    IpfcCircleDescriptor circleDesc = (IpfcCircleDescriptor)desc;
                    CpfcPoint3D circleCenter = (CpfcPoint3D)circleDesc.Center;
                    if (circleCenter != null)
                    {
                        center = new double[] { circleCenter[0], circleCenter[1], circleCenter[2] };
                        radius = circleDesc.Radius;
                        return radius > 0.001;
                    }
                }
            }
            catch { }
            return false;
        }

        private static bool IsTorusAdjacentPlane(IpfcSurface planeSurf)
        {
            try
            {
                if (planeSurf == null) return false;
                IpfcContours contours = planeSurf.ListContours();
                if (contours == null) return false;

                for (int c = 0; c < contours.Count; c++)
                {
                    IpfcContour contour = contours[c];
                    IpfcEdges edges = contour.ListElements();
                    if (edges == null) continue;

                    for (int e = 0; e < edges.Count; e++)
                    {
                        IpfcEdge edge = edges[e];
                        try
                        {
                            IpfcSurface s1 = edge.Surface1;
                            IpfcSurface s2 = edge.Surface2;
                            if (s1 != null && s1.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS) return true;
                            if (s2 != null && s2.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS) return true;
                        }
                        catch { }
                    }
                }
            }
            catch { }
            return false;
        }

        private static List<TerminalSide> FindTerminalSides(IpfcModelItemOwner itemOwner)
        {
            List<TerminalSide> allCandidates = new List<TerminalSide>();

            IpfcModelItems edgeItems = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_EDGE);
            if (edgeItems == null || edgeItems.Count == 0)
                return allCandidates;

            // Collect all circular edges that strictly lie on a planar end face (not on torus)
            for (int e = 0; e < edgeItems.Count; e++)
            {
                IpfcEdge edge = (IpfcEdge)edgeItems[e];
                if (!TryGetCircularEdgeInfo(edge, out double[] center, out double radius))
                    continue;

                IpfcSurface planeSurf = null;
                IpfcSurface cylSurf = null;

                try
                {
                    IpfcSurface s1 = edge.Surface1;
                    IpfcSurface s2 = edge.Surface2;

                    if (s1 != null && s2 != null)
                    {
                        int t1 = s1.GetSurfaceType();
                        int t2 = s2.GetSurfaceType();

                        // Reject any edge that touches a torus surface (torus plane surface)
                        if (t1 == (int)EpfcSurfaceType.EpfcSURFACE_TORUS || t2 == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                            continue;

                        if (t1 == (int)EpfcSurfaceType.EpfcSURFACE_PLANE)
                        {
                            planeSurf = s1;
                            if (t2 == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                                cylSurf = s2;
                        }
                        else if (t2 == (int)EpfcSurfaceType.EpfcSURFACE_PLANE)
                        {
                            planeSurf = s2;
                            if (t1 == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                                cylSurf = s1;
                        }
                    }
                }
                catch { }

                // Only accept circular edges that strictly belong to a planar cut end (not on torus)
                if (planeSurf != null)
                {
                    if (IsTorusAdjacentPlane(planeSurf))
                        continue;

                    double cylArea = 0.0;
                    if (cylSurf != null)
                    {
                        try { cylArea = cylSurf.EvalArea(); } catch { }
                    }

                    allCandidates.Add(new TerminalSide
                    {
                        Plane = planeSurf,
                        Edge = edge,
                        Cylinder = cylSurf,
                        EdgeCenter = center,
                        EdgeRadius = radius,
                        PlaneOrigin = center,
                        CylinderArea = cylArea,
                        PlaneIndex = allCandidates.Count
                    });
                }
            }

            // Cluster concentric circular edges at each planar end face and select the INNER ARC (smaller radius)
            List<TerminalSide> distinctEnds = new List<TerminalSide>();
            const double CLUSTER_TOLERANCE = 1.0;

            foreach (var cand in allCandidates)
            {
                bool merged = false;
                for (int i = 0; i < distinctEnds.Count; i++)
                {
                    if (Distance(cand.EdgeCenter, distinctEnds[i].EdgeCenter) < CLUSTER_TOLERANCE)
                    {
                        // Always select the INNER ARC (smaller radius edge)
                        if (cand.EdgeRadius < distinctEnds[i].EdgeRadius && cand.EdgeRadius > 0.001)
                        {
                            distinctEnds[i].Edge = cand.Edge;
                            distinctEnds[i].EdgeRadius = cand.EdgeRadius;
                            distinctEnds[i].EdgeCenter = cand.EdgeCenter;
                            distinctEnds[i].PlaneOrigin = cand.EdgeCenter;
                        }
                        if (distinctEnds[i].Cylinder == null && cand.Cylinder != null)
                        {
                            distinctEnds[i].Cylinder = cand.Cylinder;
                            distinctEnds[i].CylinderArea = cand.CylinderArea;
                        }
                        merged = true;
                        break;
                    }
                }

                if (!merged)
                {
                    distinctEnds.Add(cand);
                }
            }

            if (distinctEnds.Count <= 2)
                return distinctEnds;

            // If more than 2 candidates, pick the two furthest apart
            TerminalSide bestSide1 = null;
            TerminalSide bestSide2 = null;
            double largestDistance = -1.0;

            for (int i = 0; i < distinctEnds.Count; i++)
            {
                for (int j = i + 1; j < distinctEnds.Count; j++)
                {
                    double dist = Distance(distinctEnds[i].EdgeCenter, distinctEnds[j].EdgeCenter);
                    if (dist > largestDistance)
                    {
                        largestDistance = dist;
                        bestSide1 = distinctEnds[i];
                        bestSide2 = distinctEnds[j];
                    }
                }
            }

            List<TerminalSide> result = new List<TerminalSide>();
            if (bestSide1 != null) result.Add(bestSide1);
            if (bestSide2 != null) result.Add(bestSide2);
            return result;
        }

        private static void EnsureCylindersForTerminalSides(
            IpfcModelItemOwner itemOwner,
            List<TerminalSide> terminalSides)
        {
            if (terminalSides.Count < 2) return;

            IpfcModelItems surfaceItems = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
            if (surfaceItems == null) return;

            List<CylinderInfo> cylinders = new List<CylinderInfo>();
            for (int i = 0; i < surfaceItems.Count; i++)
            {
                IpfcSurface surf = (IpfcSurface)surfaceItems[i];
                if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                {
                    double area = 0.0;
                    try { area = surf.EvalArea(); } catch { }

                    cylinders.Add(new CylinderInfo
                    {
                        Surface = surf,
                        Area = area,
                        Index = cylinders.Count
                    });
                }
            }

            for (int s = 0; s < terminalSides.Count; s++)
            {
                if (terminalSides[s].Cylinder == null && cylinders.Count > 0)
                {
                    CylinderInfo bestCyl = null;
                    double minDistance = double.MaxValue;

                    for (int c = 0; c < cylinders.Count; c++)
                    {
                        double dist = GetSafeEdgeToSurfaceDistance(terminalSides[s].Edge, cylinders[c].Surface);
                        if (dist < minDistance || (Math.Abs(dist - minDistance) < 0.1 && cylinders[c].Area > (bestCyl?.Area ?? 0)))
                        {
                            minDistance = dist;
                            bestCyl = cylinders[c];
                        }
                    }

                    if (bestCyl != null)
                    {
                        terminalSides[s].Cylinder = bestCyl.Surface;
                        terminalSides[s].CylinderArea = bestCyl.Area;
                    }
                }
                else if (terminalSides[s].Cylinder != null && terminalSides[s].CylinderArea <= 0.001)
                {
                    try { terminalSides[s].CylinderArea = terminalSides[s].Cylinder.EvalArea(); } catch { }
                }
            }
        }

        private static double GetSafeEdgeToSurfaceDistance(IpfcEdge edge, IpfcSurface surf)
        {
            try
            {
                return GetSelectionDistance((IpfcModelItem)edge, (IpfcModelItem)surf);
            }
            catch
            {
                return double.MaxValue;
            }
        }


        private static IpfcModelItem CreateDatumPointAtEdgeCenter(
            IpfcModelItemOwner itemOwner,
            IpfcEdge edge,
            string pointName)
        {
            try
            {
                IpfcSession creoSession = (IpfcSession)Session;
                IpfcSelectionBuffer selectionBuffer = creoSession.CurrentSelectionBuffer;
                selectionBuffer.Clear();

                IpfcSelection edgeSelection = new CMpfcSelect()
                    .CreateModelItemSelection((IpfcModelItem)edge, null);
                selectionBuffer.AddSelection(edgeSelection);

                IpfcModelItems pointsBefore = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                int pointCountBefore = pointsBefore?.Count ?? 0;

                IpfcModelItems featsBefore = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                int featCountBefore = featsBefore?.Count ?? 0;

                string pointMacro =
                    "~ Command `ProCmdDatumPointGeneral` ;" +
                    "~ Trigger `Odui_Dlg_00` `t1.RefsTable` 2 `0` `c2`;" +
                    "~ Focus `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ FocusIn `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ Select `Odui_Dlg_00` `t1.RefsTable` 2 `0` `c2`;" +
                    "~ FocusOut `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ Open `Odui_Dlg_00` `ConstrTypeOptionMenu_OPTMENU1`;" +
                    "~ Trigger `Odui_Dlg_00` `t1.RefsTable` 2 `` ``;" +
                    "~ Timer `` `` `CollectorWdg_FocusTimer`;" +
                    "~ Close `Odui_Dlg_00` `ConstrTypeOptionMenu_OPTMENU1`;" +
                    "~ Select `Odui_Dlg_00` `ConstrTypeOptionMenu_OPTMENU1` 1 `DTMPNT_CONSTR_TYPE_CENTER`;" +
                    "~ FocusOut `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

                Session.RunMacro(pointMacro);
                Thread.Sleep(300);

                IpfcModelItems pointsAfter = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                if (pointsAfter == null || pointsAfter.Count <= pointCountBefore)
                {
                    return null;
                }

                IpfcModelItems featsAfter = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (featsAfter != null && featsAfter.Count > featCountBefore && !string.IsNullOrEmpty(pointName))
                {
                    try { ((IpfcModelItem)featsAfter[featsAfter.Count - 1])?.SetName(pointName); } catch { }
                }

                return pointsAfter[pointsAfter.Count - 1];
            }
            catch
            {
                return null;
            }
        }

