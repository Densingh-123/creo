        public static void Main()
        {
            Connect();
            if (Session == null)
            {
                MessageBox.Show(
                    "Could not connect to an active Creo session.",
                    "Connection Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
                return;
            }

            IpfcModel model = Session.CurrentModel;
