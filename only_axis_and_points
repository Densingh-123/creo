        private static bool IsYAxisPointingOutward(
            IpfcModelItem csysItem,
            double[] pOrigin,
            double[] pApex)
        {
            try
            {
                if (csysItem == null || pOrigin == null || pApex == null) return false;

                IpfcCoordSystem csys = csysItem as IpfcCoordSystem;
                if (csys == null) return false;

                IpfcTransform3D transform = csys.CoordSys;
                if (transform == null) return false;

                IpfcVector3D yAxis = transform.GetYAxis();
                if (yAxis == null) return false;

                double[] outward = new double[]
                {
                    pOrigin[0] - pApex[0],
                    pOrigin[1] - pApex[1],
                    pOrigin[2] - pApex[2]
                };

                double outLen = Math.Sqrt(outward[0] * outward[0] + outward[1] * outward[1] + outward[2] * outward[2]);
                double yLen = Math.Sqrt(yAxis[0] * yAxis[0] + yAxis[1] * yAxis[1] + yAxis[2] * yAxis[2]);

                if (outLen < 0.0001 || yLen < 0.0001) return false;

                double dot = (yAxis[0] * outward[0] + yAxis[1] * outward[1] + yAxis[2] * outward[2]) / (outLen * yLen);
                return dot > 0.0;
            }
            catch
            {
                return false;
            }
        }

