        public static void Main()
        {
            Connect();
            if (Session == null)
            {
                MessageBox.Show(
                    "Could not connect to an active Creo session.",
                    "Connection Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
                return;
            }

            IpfcModel model = Session.CurrentModel;
            if (model == null)
            {
                MessageBox.Show(
                    "No active model found in Creo. Please open a model first.",
                    "No Model",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);
                return;
            }

            // Initialize working model (handles both Assembly and Part)
            if (!InitializeWorkingModel(model))
            {
                return;
            }

            CreatePipeTree();
        }

        private static bool InitializeWorkingModel(IpfcModel model)
        {
            try
            {
                bool isAssembly = model is IpfcAssembly;

                if (isAssembly)
                {
                    List<IpfcModel> allComponents = new List<IpfcModel>();
                    HashSet<string> visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    CollectAllComponents((IpfcAssembly)model, allComponents, visited);

                    IpfcModel bestPipeModel = null;
                    double bestSpan = -1.0;

                    for (int i = 0; i < allComponents.Count; i++)
                    {
                        IpfcModel comp = allComponents[i];
                        string name = "";
                        try { name = comp.InstanceName ?? ""; } catch { }

                        // Skip standard fittings, nuts, ferrules, seals
                        if (name.IndexOf("NUT", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("FERRULE", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("FTG", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("FITTING", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("SEAL", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("O-RING", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("ORING", StringComparison.OrdinalIgnoreCase) >= 0 ||
                            name.IndexOf("CLAMP", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            continue;
                        }

                        int bends = CountDistinctBends((IpfcModelItemOwner)comp);
                        List<TerminalSide> ends = FindTerminalSides((IpfcModelItemOwner)comp);

                        if (ends.Count >= 2 && bends >= 1)
                        {
                            double span = Distance(ends[0].EdgeCenter, ends[1].EdgeCenter);

                            if (name.IndexOf("TUBE", StringComparison.OrdinalIgnoreCase) >= 0 ||
                                name.IndexOf("PIPE", StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                bestPipeModel = comp;
                                break;
                            }

                            if (span > bestSpan)
                            {
                                bestSpan = span;
                                bestPipeModel = comp;
                            }
                        }
                    }

                    if (bestPipeModel != null)
                    {
                        if (OpenModelInNewWindow(bestPipeModel))
                        {
                            WorkingModel = bestPipeModel;
                            WorkingItemOwner = (IpfcModelItemOwner)bestPipeModel;
                            FeatureItemOwner = (IpfcModelItemOwner)bestPipeModel;
                            return true;
                        }
                        else
                        {
                            WorkingModel = bestPipeModel;
                            WorkingItemOwner = (IpfcModelItemOwner)bestPipeModel;
                            FeatureItemOwner = (IpfcModelItemOwner)model;
                            return true;
                        }
                    }

                    int asmBends = CountDistinctBends((IpfcModelItemOwner)model);
                    List<TerminalSide> asmEnds = FindTerminalSides((IpfcModelItemOwner)model);

                    if (asmEnds.Count >= 2 && asmBends >= 1)
                    {
                        WorkingModel = model;
                        WorkingItemOwner = (IpfcModelItemOwner)model;
                        FeatureItemOwner = (IpfcModelItemOwner)model;
                        return true;
                    }

                    MessageBox.Show(
                        "No bent pipe found in the active assembly hierarchy.",
                        "No Pipe Found",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning);

                    return false;
                }
                else
                {
                    // Standalone PART
                    int partBends = CountDistinctBends((IpfcModelItemOwner)model);
                    List<TerminalSide> partEnds = FindTerminalSides((IpfcModelItemOwner)model);

                    if (partEnds.Count >= 2)
                    {
                        WorkingModel = model;
                        WorkingItemOwner = (IpfcModelItemOwner)model;
                        FeatureItemOwner = (IpfcModelItemOwner)model;
                        return true;
                    }
                    else
                    {
                        MessageBox.Show(
                            "The open model is not a recognized pipe geometry (found " + partEnds.Count + " terminal ends).",
                            "Invalid Model",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning);
                        return false;
                    }
                }
            }
            catch
            {
                return false;
            }
        }

        private static int CountDistinctBends(IpfcModelItemOwner itemOwner)
        {
            try
            {
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null || surfaces.Count < 2) return 0;

                List<double[]> torusCenters = new List<double[]>();
                const double CENTER_TOLERANCE = 2.0;
                int totalTorusCount = 0;

                for (int i = 0; i < surfaces.Count; i++)
                {
                    try
                    {
                        IpfcSurface surf = (IpfcSurface)surfaces[i];
                        if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                        {
                            totalTorusCount++;
                            IpfcTransformedSurface trans = surf as IpfcTransformedSurface;
                            if (trans != null && trans.CoordSys != null)
                            {
                                IpfcPoint3D origin = trans.CoordSys.GetOrigin();
                                if (origin != null)
                                {
                                    double[] c = new double[] { origin[0], origin[1], origin[2] };
                                    bool isDuplicate = false;
                                    for (int k = 0; k < torusCenters.Count; k++)
                                    {
                                        if (Distance(c, torusCenters[k]) < CENTER_TOLERANCE)
                                        {
                                            isDuplicate = true;
                                            break;
                                        }
                                    }
                                    if (!isDuplicate)
                                    {
                                        torusCenters.Add(c);
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }

                if (torusCenters.Count > 0)
                {
                    return torusCenters.Count;
                }

                if (totalTorusCount > 0)
                {
                    return Math.Max(1, totalTorusCount / 2);
                }

                List<double[]> cylinderDirs = new List<double[]>();
                for (int i = 0; i < surfaces.Count; i++)
                {
                    try
                    {
                        IpfcSurface surf = (IpfcSurface)surfaces[i];
                        if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                        {
                            double[] dir = GetCylinderAxisDirection(surf);
                            if (dir != null)
                            {
                                bool isDuplicate = false;
                                for (int k = 0; k < cylinderDirs.Count; k++)
                                {
                                    double dot = Math.Abs(dir[0] * cylinderDirs[k][0] + dir[1] * cylinderDirs[k][1] + dir[2] * cylinderDirs[k][2]);
                                    if (dot > 0.995)
                                    {
                                        isDuplicate = true;
                                        break;
                                    }
                                }
                                if (!isDuplicate)
                                {
                                    cylinderDirs.Add(dir);
                                }
                            }
                        }
                    }
                    catch { }
                }

                if (cylinderDirs.Count >= 2)
                {
                    return cylinderDirs.Count - 1;
                }

                return 0;
            }
            catch
            {
                return 0;
            }
        }

        private static void CollectAllComponents(IpfcAssembly assembly, List<IpfcModel> collectedModels, HashSet<string> visitedNames)
        {
            try
            {
                IpfcModelItemOwner asmOwner = (IpfcModelItemOwner)assembly;
                IpfcModelItems features = asmOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (features == null) return;

                for (int i = 0; i < features.Count; i++)
                {
                    try
                    {
                        IpfcModelItem feat = features[i];
                        if (feat is IpfcComponentFeat compFeat)
                        {
                            IpfcModelDescriptor descr = compFeat.ModelDescr;
                            if (descr == null) continue;

                            IpfcModel compModel = Session.GetModelFromDescr(descr);
                            if (compModel == null) continue;

                            string name = compModel.InstanceName;
                            if (visitedNames.Contains(name)) continue;
                            visitedNames.Add(name);

                            if (compModel is IpfcAssembly subAsm)
                            {
                                CollectAllComponents(subAsm, collectedModels, visitedNames);
                            }
                            else if (compModel is IpfcSolid || compModel is IpfcPart)
                            {
                                collectedModels.Add(compModel);
                            }
                        }
                    }
                    catch { }
                }
            }
            catch { }
        }

        private static bool OpenModelInNewWindow(IpfcModel model)
        {
            try
            {
                IpfcWindow window = null;
                try { window = Session.GetModelWindow(model); } catch { }

                if (window == null)
                {
                    try { window = Session.CreateModelWindow(model); } catch { }
                }

                if (window != null)
                {
                    window.Activate();
                    model.Display();
                    window.Refresh();
                }
                else
                {
                    model.DisplayInNewWindow();
                    try
                    {
                        window = Session.GetModelWindow(model);
                        window?.Activate();
                    }
                    catch { }
                }

                Thread.Sleep(350);
                return true;
            }
            catch
            {
                return false;
            }
        }

        private static double[] GetCylinderAxisDirection(IpfcSurface cylSurf)
        {
            try
            {
                IpfcTransformedSurface transSurf = cylSurf as IpfcTransformedSurface;
                if (transSurf != null && transSurf.CoordSys != null)
                {
                    IpfcVector3D zAxis = transSurf.CoordSys.GetZAxis();
                    if (zAxis != null)
                    {
                        double len = Math.Sqrt(zAxis[0] * zAxis[0] + zAxis[1] * zAxis[1] + zAxis[2] * zAxis[2]);
                        if (len > 0.0001)
                        {
                            return new double[] { zAxis[0] / len, zAxis[1] / len, zAxis[2] / len };
                        }
                    }
                }
            }
            catch { }
            return null;
        }

        private static bool IsPipeTargetName(string name)
        {
            if (string.IsNullOrEmpty(name)) return false;
            string upper = name.ToUpperInvariant().Trim();

            return upper == "A_1" ||
                   upper == "A_2" ||
                   upper == "PIPE_START_POINT" ||
                   upper == "PIPE_Z_POINT" ||
                   upper == "PIPE_END_POINT" ||
                   upper == "PIPE_AXIS_START" ||
                   upper == "PIPE_AXIS_END" ||
                   upper == "BEND_DATA" ||
                   upper == "PIPE_BOUND_BOX" ||
                   upper.Contains("PIPE_START") ||
                   upper.Contains("PIPE_END") ||
                   upper.Contains("PIPE_Z") ||
                   upper.Contains("PIPE_AXIS") ||
                   upper.Contains("BEND_DATA") ||
                   upper.Contains("BOUND_BOX");
        }

        private static bool CheckAndDeleteExistingItems(IpfcModelItemOwner featureOwner)
        {
            List<string> existingItems = new List<string>();

            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_COORD_SYS), "Coord System", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_AXIS), "Axis", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT), "Point", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE), "Feature", existingItems);

            if (existingItems.Count == 0)
            {
                return true;
            }

            DialogResult result = MessageBox.Show(
                "The following existing items were found:\n\n" +
                string.Join("\n", existingItems) +
                "\n\nDo you want to DELETE all of them and create new ones?",
                "Existing Items Found",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning);

            if (result == DialogResult.No)
            {
                return false;
            }

            // Delete all existing items simultaneously in one pass
            DeleteAllExistingPipeItemsAllAtOnce(featureOwner);
            return true;
        }

        private static void CollectPipeItems(IpfcModelItems items, string prefix, List<string> existingItems)
        {
            if (items == null) return;
            for (int i = 0; i < items.Count; i++)
            {
                try
                {
                    string name = items[i].GetName();
                    if (IsPipeTargetName(name))
                    {
                        string entry = prefix + ": " + name;
                        if (!existingItems.Contains(entry))
                            existingItems.Add(entry);
                    }
                }
                catch { }
            }
        }

        private static void DeleteAllExistingPipeItemsAllAtOnce(IpfcModelItemOwner featureOwner)
        {
            try
            {
                IpfcSession creoSession = (IpfcSession)Session;
                IpfcSelectionBuffer buffer = creoSession.CurrentSelectionBuffer;
                buffer.Clear();

                HashSet<string> addedKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                EpfcModelItemType[] types = new[]
                {
                        EpfcModelItemType.EpfcITEM_COORD_SYS,
                        EpfcModelItemType.EpfcITEM_AXIS,
                        EpfcModelItemType.EpfcITEM_POINT,
                        EpfcModelItemType.EpfcITEM_FEATURE
                    };

                foreach (var type in types)
                {
                    try
                    {
                        IpfcModelItems items = featureOwner.ListItems(type);
                        if (items != null)
                        {
                            for (int i = 0; i < items.Count; i++)
                            {
                                try
                                {
                                    IpfcModelItem item = items[i];
                                    string name = item.GetName();
                                    if (IsPipeTargetName(name))
                                    {
                                        int id = 0;
                                        try { id = item.Id; } catch { }
                                        string key = type.ToString() + "_" + id + "_" + name;
                                        if (!addedKeys.Contains(key))
                                        {
                                            addedKeys.Add(key);
                                            IpfcSelection sel = new CMpfcSelect().CreateModelItemSelection(item, null);
                                            buffer.AddSelection(sel);
                                        }
                                    }
                                }
                                catch { }
                            }
                        }
                    }
                    catch { }
                }

                if (buffer.Contents != null && buffer.Contents.Count > 0)
                {
                    string singleDeleteMacro =
                        "~ Command `ProCmdEditDelete` ;" +
                        "~ Command `ProCmdFeatDelete` ;" +
                        "~ Activate `del_feat_dlg` `OK`;" +
                        "~ Activate `del_feat_dlg` `stdbtn_1`;" +
                        "~ Activate `del_feat_dlg` `delete_btn`;" +
                        "~ Activate `del_feat_dlg` `ok_btn`;" +
                        "~ Activate `del_feat_dlg` `CommitBtn`;" +
                        "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                        "~ Activate `Odui_Dlg_00` `stdbtn_1`;" +
                        "~ Activate `main_dlg_cur` `stdbtn_1`;";

                    Session.RunMacro(singleDeleteMacro);
                    Thread.Sleep(300);
                    buffer.Clear();
                }

                IpfcSolid solid = featureOwner as IpfcSolid ?? Session.CurrentModel as IpfcSolid;
                solid?.Regenerate(null);
                Session.get_CurrentWindow().Repaint();
            }
            catch { }
        }

        private static double[] CalculateApexPoint(double[] p1, double[] u1, double[] p2, double[] u2)
        {
            try
            {
                if (p1 == null || u1 == null || p2 == null || u2 == null) return null;
                double u1DotU2 = u1[0] * u2[0] + u1[1] * u2[1] + u1[2] * u2[2];
                double denom = 1.0 - u1DotU2 * u1DotU2;
                if (Math.Abs(denom) < 0.0001) return null;

                double[] w0 = new double[] { p1[0] - p2[0], p1[1] - p2[1], p1[2] - p2[2] };
                double d = u1[0] * w0[0] + u1[1] * w0[1] + u1[2] * w0[2];
                double e = u2[0] * w0[0] + u2[1] * w0[1] + u2[2] * w0[2];

                double s = (u1DotU2 * e - d) / denom;
                double t = (e - u1DotU2 * d) / denom;

                double q1x = p1[0] + s * u1[0];
                double q1y = p1[1] + s * u1[1];
                double q1z = p1[2] + s * u1[2];

                double q2x = p2[0] + t * u2[0];
                double q2y = p2[1] + t * u2[1];
                double q2z = p2[2] + t * u2[2];

                return new double[] { 0.5 * (q1x + q2x), 0.5 * (q1y + q2y), 0.5 * (q1z + q2z) };
            }
            catch
            {
                return null;
            }
        }

        private static double[] GetTorusBendCenter(IpfcModelItemOwner itemOwner)
        {
            try
            {
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null) return null;

                for (int i = 0; i < surfaces.Count; i++)
                {
                    IpfcSurface surf = (IpfcSurface)surfaces[i];
                    if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                    {
                        IpfcTransformedSurface trans = surf as IpfcTransformedSurface;
                        if (trans != null && trans.CoordSys != null)
                        {
                            IpfcPoint3D origin = trans.CoordSys.GetOrigin();
                            if (origin != null)
                            {
                                return new double[] { origin[0], origin[1], origin[2] };
                            }
                        }
                    }
                }
            }
            catch { }
            return null;
        }

        public static void CreatePipeTree()
        {
            try
            {
                IpfcModelItemOwner itemOwner = WorkingItemOwner;
                IpfcModelItemOwner featureOwner = FeatureItemOwner;

                IpfcSolid solid = Session.CurrentModel as IpfcSolid;
                if (!CheckAndDeleteExistingItems(featureOwner))
                {
                    return;
                }

                // 1. Find all valid planar end surfaces (strictly excluding torus planes)
                List<TerminalSide> terminalSides = FindTerminalSides(itemOwner);
                if (terminalSides.Count < 2)
                {
                    return;
                }

                EnsureCylindersForTerminalSides(itemOwner, terminalSides);

                // 2. Find bend center or apex
                double[] bendPoint = GetTorusBendCenter(itemOwner);
                if (bendPoint == null && terminalSides[0].Cylinder != null && terminalSides[1].Cylinder != null)
                {
                    double[] dir1 = GetCylinderAxisDirection(terminalSides[0].Cylinder);
                    double[] dir2 = GetCylinderAxisDirection(terminalSides[1].Cylinder);
                    if (dir1 != null && dir2 != null)
                    {
                        bendPoint = CalculateApexPoint(terminalSides[0].EdgeCenter, dir1, terminalSides[1].EdgeCenter, dir2);
                    }
                }

                // 3. The plane nearer to the bend is strictly the start point plane (shortest pipe leg)
                TerminalSide startingSide = null;
                TerminalSide endingSide = null;

                if (terminalSides.Count == 2)
                {
                    double d0 = (bendPoint != null) ? Distance(terminalSides[0].EdgeCenter, bendPoint) : terminalSides[0].CylinderArea;
                    double d1 = (bendPoint != null) ? Distance(terminalSides[1].EdgeCenter, bendPoint) : terminalSides[1].CylinderArea;

                    startingSide = (d0 <= d1) ? terminalSides[0] : terminalSides[1];
                    endingSide = (d0 <= d1) ? terminalSides[1] : terminalSides[0];
                }
                else
                {
                    terminalSides.Sort((a, b) =>
                    {
                        double da = (bendPoint != null) ? Distance(a.EdgeCenter, bendPoint) : a.CylinderArea;
                        double db = (bendPoint != null) ? Distance(b.EdgeCenter, bendPoint) : b.CylinderArea;
                        return da.CompareTo(db);
                    });

                    startingSide = terminalSides[0];
                    endingSide = terminalSides[terminalSides.Count - 1];
                }

                if (startingSide == null || endingSide == null || startingSide.Cylinder == null || endingSide.Cylinder == null)
                {
                    return;
                }

                // 4. Create PIPE_START_POINT on inner circular edge of the plane nearer to the bend
                IpfcModelItem startPoint = CreateDatumPointAtEdgeCenter(featureOwner, startingSide.Edge, "PIPE_START_POINT");
                if (startPoint == null)
                {
                    return;
                }
                SetModelItemName(startPoint, "PIPE_START_POINT");

                // 5. Create Axis A_1 on the shorter leg cylinder
                IpfcModelItem axis1 = CreateAxisFromCylinder(featureOwner, startingSide.Cylinder, "A_1");
                if (axis1 != null)
                {
                    SetModelItemName(axis1, "A_1");
                }
                else
                {
                    return;
                }

                // 6. Create Axis A_2 on the longer leg cylinder
                IpfcModelItem axis2 = CreateAxisFromCylinder(featureOwner, endingSide.Cylinder, "A_2");
                if (axis2 != null)
                {
                    SetModelItemName(axis2, "A_2");
                }
                else
                {
                    return;
                }

                // 7. Create Midpoint/Apex PIPE_Z_POINT at intersection of A_1 and A_2
                IpfcModelItem midpoint = null;
                try
                {
                    IpfcSession sessionContext = (IpfcSession)Session;
                    IpfcSelectionBuffer axisBuffer = sessionContext.CurrentSelectionBuffer;
                    axisBuffer.Clear();

                    IpfcSelection axisSelection1 = new CMpfcSelect().CreateModelItemSelection(axis1, null);
                    IpfcSelection axisSelection2 = new CMpfcSelect().CreateModelItemSelection(axis2, null);
                    axisBuffer.AddSelection(axisSelection1);
                    axisBuffer.AddSelection(axisSelection2);

                    int pointCountBeforeMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT)?.Count ?? 0;
                    int featCountBeforeMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE)?.Count ?? 0;

                    string midpointMacro =
                        "~ Command `ProCmdDatumPointGeneral` ;" +
                        "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                        "~ Activate `Odui_Dlg_00` `stdbtn_1`;";
                    Session.RunMacro(midpointMacro);
                    Thread.Sleep(350);

                    IpfcModelItems pointsAfterMidpoint = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                    if (pointsAfterMidpoint != null && pointsAfterMidpoint.Count > pointCountBeforeMid)
                    {
                        midpoint = pointsAfterMidpoint[pointsAfterMidpoint.Count - 1];
                        SetModelItemName(midpoint, "PIPE_Z_POINT");

                        IpfcModelItems featsAfterMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                        if (featsAfterMid != null && featsAfterMid.Count > featCountBeforeMid)
                        {
                            try { ((IpfcModelItem)featsAfterMid[featsAfterMid.Count - 1])?.SetName("PIPE_Z_POINT"); } catch { }
                        }
                    }
                    axisBuffer.Clear();
                }
                catch { }

                // 8. Create PIPE_END_POINT on inner circular edge of the longer leg planar end surface
                IpfcModelItem endPoint = CreateDatumPointAtEdgeCenter(featureOwner, endingSide.Edge, "PIPE_END_POINT");
                if (endPoint == null)
                {
                    return;
                }
                SetModelItemName(endPoint, "PIPE_END_POINT");

                solid?.Regenerate(null);
                Session.get_CurrentWindow().Repaint();
            }
            catch { }
        }

        private static void SetModelItemName(IpfcModelItem modelItem, string name)
        {
            try
            {
                if (modelItem == null) return;
                modelItem.SetName(name);

                if (modelItem is IpfcAxis axis)
                {
                    try { ((IpfcModelItem)axis.GetFeature())?.SetName(name); } catch { }
                }
                else if (modelItem is IpfcCoordSystem csys)
                {
                    try { ((IpfcModelItem)csys.GetFeature())?.SetName(name); } catch { }
                }
            }
            catch { }
        }

        private static bool TryGetCircularEdgeInfo(IpfcEdge edge, out double[] center, out double radius)
        {
            center = null;
            radius = 0.0;
            try
            {
                IpfcGeomCurve geomCurve = edge as IpfcGeomCurve;
                if (geomCurve == null) return false;

                IpfcCurveDescriptor desc = geomCurve.GetCurveDescriptor();
                if (desc == null) return false;

                int curveType = (int)desc.GetCurveType();

                if (curveType == (int)EpfcCurveType.EpfcCURVE_ARC)
                {
                    IpfcArcDescriptor arcDesc = (IpfcArcDescriptor)desc;
                    CpfcPoint3D arcCenter = (CpfcPoint3D)arcDesc.Center;
                    if (arcCenter != null)
                    {
                        center = new double[] { arcCenter[0], arcCenter[1], arcCenter[2] };
                        radius = arcDesc.Radius;
                        return radius > 0.001;
                    }
                }
                else if (curveType == (int)EpfcCurveType.EpfcCURVE_CIRCLE)
                {
                    IpfcCircleDescriptor circleDesc = (IpfcCircleDescriptor)desc;
                    CpfcPoint3D circleCenter = (CpfcPoint3D)circleDesc.Center;
                    if (circleCenter != null)
                    {
                        center = new double[] { circleCenter[0], circleCenter[1], circleCenter[2] };
                        radius = circleDesc.Radius;
                        return radius > 0.001;
                    }
                }
            }
            catch { }
            return false;
        }

        private static List<TerminalSide> FindTerminalSides(IpfcModelItemOwner itemOwner)
        {
            List<TerminalSide> validPlanes = new List<TerminalSide>();
            try
            {
                IpfcModelItems surfaceItems = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaceItems == null) return validPlanes;

                for (int s = 0; s < surfaceItems.Count; s++)
                {
                    IpfcSurface surf = (IpfcSurface)surfaceItems[s];
                    if (surf.GetSurfaceType() != (int)EpfcSurfaceType.EpfcSURFACE_PLANE)
                        continue;

                    IpfcContours contours = null;
                    try { contours = surf.ListContours(); } catch { }
                    if (contours == null || contours.Count == 0)
                        continue;

                    bool touchesTorus = false;
                    IpfcEdge bestInnerEdge = null;
                    double bestInnerRadius = double.MaxValue;
                    double[] bestEdgeCenter = null;
                    IpfcSurface adjacentCylinder = null;

                    for (int c = 0; c < contours.Count; c++)
                    {
                        IpfcContour contour = contours[c];
                        IpfcEdges edges = null;
                        try { edges = contour.ListElements(); } catch { }
                        if (edges == null) continue;

                        for (int e = 0; e < edges.Count; e++)
                        {
                            IpfcEdge edge = edges[e];
                            try
                            {
                                IpfcSurface s1 = edge.Surface1;
                                IpfcSurface s2 = edge.Surface2;

                                // STRICT REJECTION: Reject any edge/plane touching a torus surface
                                if ((s1 != null && s1.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS) ||
                                    (s2 != null && s2.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS))
                                {
                                    touchesTorus = true;
                                    break;
                                }

                                if (TryGetCircularEdgeInfo(edge, out double[] edgeCenter, out double edgeRadius))
                                {
                                    if (edgeRadius > 0.001)
                                    {
                                        IpfcSurface otherSurf = (s1 == surf) ? s2 : s1;
                                        if (otherSurf != null && otherSurf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                                        {
                                            adjacentCylinder = otherSurf;
                                        }

                                        // Select internal edge (smaller radius)
                                        if (edgeRadius < bestInnerRadius)
                                        {
                                            bestInnerRadius = edgeRadius;
                                            bestInnerEdge = edge;
                                            bestEdgeCenter = edgeCenter;
                                        }
                                    }
                                }
                            }
                            catch { }
                        }

                        if (touchesTorus) break;
                    }

                    if (!touchesTorus && bestInnerEdge != null && bestEdgeCenter != null)
                    {
                        double cylArea = 0.0;
                        if (adjacentCylinder != null)
                        {
                            try { cylArea = adjacentCylinder.EvalArea(); } catch { }
                        }

                        validPlanes.Add(new TerminalSide
                        {
                            Plane = surf,
                            Edge = bestInnerEdge,
                            Cylinder = adjacentCylinder,
                            EdgeCenter = bestEdgeCenter,
                            EdgeRadius = bestInnerRadius,
                            PlaneOrigin = bestEdgeCenter,
                            CylinderArea = cylArea,
                            PlaneIndex = validPlanes.Count
                        });
                    }
                }
            }
            catch { }
            return validPlanes;
        }

        private static void EnsureCylindersForTerminalSides(
            IpfcModelItemOwner itemOwner,
            List<TerminalSide> terminalSides)
        {
            if (terminalSides.Count < 2) return;

            IpfcModelItems surfaceItems = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
            if (surfaceItems == null) return;

            List<CylinderInfo> cylinders = new List<CylinderInfo>();
            for (int i = 0; i < surfaceItems.Count; i++)
            {
                IpfcSurface surf = (IpfcSurface)surfaceItems[i];
                if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                {
                    double area = 0.0;
                    try { area = surf.EvalArea(); } catch { }

                    cylinders.Add(new CylinderInfo
                    {
                        Surface = surf,
                        Area = area,
                        Index = cylinders.Count
                    });
                }
            }

            for (int s = 0; s < terminalSides.Count; s++)
            {
                if (terminalSides[s].Cylinder == null && cylinders.Count > 0)
                {
                    CylinderInfo bestCyl = null;
                    double minDistance = double.MaxValue;

                    for (int c = 0; c < cylinders.Count; c++)
                    {
                        double dist = GetSafeEdgeToSurfaceDistance(terminalSides[s].Edge, cylinders[c].Surface);
                        if (dist < minDistance || (Math.Abs(dist - minDistance) < 0.1 && cylinders[c].Area > (bestCyl?.Area ?? 0)))
                        {
                            minDistance = dist;
                            bestCyl = cylinders[c];
                        }
                    }

                    if (bestCyl != null)
                    {
                        terminalSides[s].Cylinder = bestCyl.Surface;
                        terminalSides[s].CylinderArea = bestCyl.Area;
                    }
                }
                else if (terminalSides[s].Cylinder != null && terminalSides[s].CylinderArea <= 0.001)
                {
                    try { terminalSides[s].CylinderArea = terminalSides[s].Cylinder.EvalArea(); } catch { }
                }
            }
        }

        private static double GetSafeEdgeToSurfaceDistance(IpfcEdge edge, IpfcSurface surf)
        {
            try
            {
                return GetSelectionDistance((IpfcModelItem)edge, (IpfcModelItem)surf);
            }
            catch
            {
                return double.MaxValue;
            }
        }

        private static IpfcModelItem CreateDatumPointAtEdgeCenter(
            IpfcModelItemOwner itemOwner,
            IpfcEdge edge,
            string pointName)
        {
            try
            {
                IpfcSession creoSession = (IpfcSession)Session;
                IpfcSelectionBuffer selectionBuffer = creoSession.CurrentSelectionBuffer;
                selectionBuffer.Clear();

                IpfcSelection edgeSelection = new CMpfcSelect()
                    .CreateModelItemSelection((IpfcModelItem)edge, null);
                selectionBuffer.AddSelection(edgeSelection);

                IpfcModelItems pointsBefore = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                int pointCountBefore = pointsBefore?.Count ?? 0;

                IpfcModelItems featsBefore = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                int featCountBefore = featsBefore?.Count ?? 0;

                string pointMacro =
                    "~ Command `ProCmdDatumPointGeneral` ;" +
                    "~ Trigger `Odui_Dlg_00` `t1.RefsTable` 2 `0` `c2`;" +
                    "~ Focus `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ FocusIn `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ Select `Odui_Dlg_00` `t1.RefsTable` 2 `0` `c2`;" +
                    "~ FocusOut `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ Open `Odui_Dlg_00` `ConstrTypeOptionMenu_OPTMENU1`;" +
                    "~ Trigger `Odui_Dlg_00` `t1.RefsTable` 2 `` ``;" +
                    "~ Timer `` `` `CollectorWdg_FocusTimer`;" +
                    "~ Close `Odui_Dlg_00` `ConstrTypeOptionMenu_OPTMENU1`;" +
                    "~ Select `Odui_Dlg_00` `ConstrTypeOptionMenu_OPTMENU1` 1 `DTMPNT_CONSTR_TYPE_CENTER`;" +
                    "~ FocusOut `Odui_Dlg_00` `t1.RefsTable`;" +
                    "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

                Session.RunMacro(pointMacro);
                Thread.Sleep(300);

                IpfcModelItems pointsAfter = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                if (pointsAfter == null || pointsAfter.Count <= pointCountBefore)
                {
                    return null;
                }

                IpfcModelItems featsAfter = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (featsAfter != null && featsAfter.Count > featCountBefore && !string.IsNullOrEmpty(pointName))
                {
                    try { ((IpfcModelItem)featsAfter[featsAfter.Count - 1])?.SetName(pointName); } catch { }
                }

                return pointsAfter[pointsAfter.Count - 1];
            }
            catch
            {
                return null;
            }
        }

        private static IpfcModelItem CreateAxisFromCylinder(
            IpfcModelItemOwner itemOwner,
            IpfcSurface cylinderSurface,
            string axisName)
        {
            try
