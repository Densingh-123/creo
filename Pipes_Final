                SetModelItemName(
                    coordinateSystem,
                    coordinateName);

                Console.WriteLine(
                    "Created coordinate system: " +
                    coordinateSystem.GetName());

                return coordinateSystem;
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "ERROR creating " + coordinateName +
                    " using CSYS mapkey: " + ex.Message);
                return null;
            }
        }

        // ====================================================================
