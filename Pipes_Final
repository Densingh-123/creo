        // ====================================================================
        // FIND TERMINAL SIDES
        // ====================================================================

        private static List<TerminalSide> FindTerminalSides(
            IpfcModelItemOwner itemOwner)
        {
            List<TerminalSide> candidates =
                new List<TerminalSide>();

            IpfcModelItems surfaceItems =
                itemOwner.ListItems(
                    EpfcModelItemType.EpfcITEM_SURFACE);

            IpfcModelItems edgeItems =
                itemOwner.ListItems(
                    EpfcModelItemType.EpfcITEM_EDGE);

            for (int s = 0;
                 s < surfaceItems.Count;
                 s++)
            {
                IpfcSurface plane =
                    (IpfcSurface)surfaceItems[s];

                if (plane.GetSurfaceType() !=
                    (int)EpfcSurfaceType.EpfcSURFACE_PLANE)
                {
                    continue;
                }

                double[] planeOrigin =
                    GetSurfaceOrigin(plane);

                IpfcEdge matchingEdge =
                    null;

                double[] matchingEdgeCenter =
                    null;

                for (int e = 0;
                     e < edgeItems.Count;
                     e++)
                {
                    IpfcEdge edge =
                        (IpfcEdge)edgeItems[e];

                    IpfcGeomCurve geomCurve =
                        (IpfcGeomCurve)edge;

                    IpfcCurveDescriptor curveDescriptor =
                        geomCurve.GetCurveDescriptor();

                    if ((int)curveDescriptor.GetCurveType() !=
                        (int)EpfcCurveType.EpfcCURVE_ARC)
                    {
                        continue;
                    }

                    IpfcArcDescriptor arcDescriptor =
                        (IpfcArcDescriptor)curveDescriptor;

                    CpfcPoint3D arcCenter =
                        (CpfcPoint3D)arcDescriptor.Center;

                    double[] edgeCenter =
                    {
                        arcCenter[0],
                        arcCenter[1],
                        arcCenter[2]
                    };

                    double distance =
                        Distance(
                            edgeCenter,
                            planeOrigin);

                    if (distance <
                        PLANE_TOLERANCE)
                    {
                        matchingEdge =
                            edge;

                        matchingEdgeCenter =
                            edgeCenter;

                        break;
                    }
                }

                if (matchingEdge is null)
                    continue;

                bool duplicatePlane =
                    false;

                foreach (TerminalSide existingSide
                         in candidates)
                {
                    if (Distance(
                            existingSide.PlaneOrigin,
                            planeOrigin)
                        < PLANE_TOLERANCE)
                    {
                        duplicatePlane =
                            true;

                        break;
                    }
                }

                if (duplicatePlane)
                    continue;

                candidates.Add(
                    new TerminalSide
                    {
                        Plane = plane,
                        Edge = matchingEdge,
                        PlaneOrigin = planeOrigin,
                        EdgeCenter = matchingEdgeCenter,
                        PlaneIndex = candidates.Count
                    });
            }

            if (candidates.Count <= 2)
                return candidates;

            TerminalSide bestSide1 =
                null;

            TerminalSide bestSide2 =
                null;

            double largestDistance =
                -1.0;

            for (int i = 0;
                 i < candidates.Count;
                 i++)
            {
                for (int j = i + 1;
                     j < candidates.Count;
                     j++)
                {
                    double distance =
                        Distance(
                            candidates[i].EdgeCenter,
                            candidates[j].EdgeCenter);

                    if (distance >
                        largestDistance)
                    {
                        largestDistance =
                            distance;

                        bestSide1 =
                            candidates[i];

                        bestSide2 =
                            candidates[j];
                    }
                }
            }

            List<TerminalSide> result =
                new List<TerminalSide>();

            if (bestSide1 != null)
                result.Add(bestSide1);

            if (bestSide2 != null)
                result.Add(bestSide2);

            return result;
        }

        // ====================================================================
        // FIND CYLINDERS
        // ====================================================================

        private static List<CylinderInfo> FindDistinctCylinders(
            IpfcModelItemOwner itemOwner)
        {
            List<CylinderInfo> result =
                new List<CylinderInfo>();

            List<double[]> cylinderOrigins =
                new List<double[]>();

            IpfcModelItems surfaceItems =
                itemOwner.ListItems(
                    EpfcModelItemType.EpfcITEM_SURFACE);

            for (int i = 0;
                 i < surfaceItems.Count;
                 i++)
            {
                IpfcSurface surface =
                    (IpfcSurface)surfaceItems[i];

                if (surface.GetSurfaceType() !=
                    (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                {
                    continue;
                }

                double[] origin =
                    GetSurfaceOrigin(surface);

                bool duplicateCylinder =
                    false;

                foreach (double[] existingOrigin
                         in cylinderOrigins)
                {
                    if (Distance(
                            origin,
                            existingOrigin)
                        < DIFFERENT_END_TOLERANCE)
                    {
                        duplicateCylinder =
                            true;

                        break;
                    }
                }

                if (duplicateCylinder)
                    continue;

                result.Add(
                    new CylinderInfo
                    {
                        Surface = surface,
                        Origin = origin,
                        Area = 0.0,
                        Index = result.Count
                    });

                cylinderOrigins.Add(
                    origin);
            }

            return result;
        }

        // ====================================================================
        // MATCH CYLINDERS
        // ====================================================================

        private static void MatchCylindersToTerminalSides(
            List<TerminalSide> terminalSides,
            List<CylinderInfo> cylinders)
        {
            if (terminalSides.Count < 2 ||
                cylinders.Count < 2)
            {
                return;
            }

            double distanceA1 =
                GetSafeSurfaceDistance(
                    terminalSides[0].Plane,
                    cylinders[0].Surface);

            double distanceA2 =
                GetSafeSurfaceDistance(
                    terminalSides[1].Plane,
                    cylinders[1].Surface);

            double distanceB1 =
                GetSafeSurfaceDistance(
                    terminalSides[0].Plane,
                    cylinders[1].Surface);

            double distanceB2 =
                GetSafeSurfaceDistance(
                    terminalSides[1].Plane,
                    cylinders[0].Surface);

            double assignmentA =
                distanceA1 + distanceA2;

            double assignmentB =
                distanceB1 + distanceB2;

            if (assignmentA <= assignmentB)
            {
                AssignCylinder(
                    terminalSides[0],
                    cylinders[0]);

                AssignCylinder(
                    terminalSides[1],
                    cylinders[1]);
            }
            else
            {
                AssignCylinder(
                    terminalSides[0],
                    cylinders[1]);

                AssignCylinder(
                    terminalSides[1],
                    cylinders[0]);
            }
        }

        // ====================================================================
        // ASSIGN CYLINDER
        // ====================================================================

        private static void AssignCylinder(
            TerminalSide side,
            CylinderInfo cylinder)
        {
            side.Cylinder =
                cylinder.Surface;

            side.CylinderArea =
                cylinder.Area;

            side.CylinderIndex =
                cylinder.Index;
        }

