        // ====================================================================
        // CREATE PIPE TREE
        // ====================================================================

        public static void CreatePipeTree()
        {
            try
            {
                IpfcModel model =
                    Session.CurrentModel;

                IpfcSolid solid =
                    (IpfcSolid)model;

                IpfcModelItemOwner itemOwner =
                    (IpfcModelItemOwner)model;

                // ============================================================
                // INITIAL AXIS COUNT
                // ============================================================

                IpfcModelItems initialAxes =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_AXIS);

                int initialAxisCount =
                    initialAxes?.Count ?? 0;

                // ============================================================
                // INITIAL POINT COUNT
                // ============================================================

                IpfcModelItems initialPoints =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_POINT);

                int initialPointCount =
                    initialPoints?.Count ?? 0;

                // ============================================================
                // FIND TERMINAL SIDES
                // ============================================================

                List<TerminalSide> terminalSides =
                    FindTerminalSides(itemOwner);

                if (terminalSides.Count < 2)
                {
                    Console.WriteLine(
                        "ERROR: Could not find two terminal planes " +
                        "with circular edges.");

                    return;
                }

                // ============================================================
                // FIND CYLINDERS
                // ============================================================

                List<CylinderInfo> cylinders =
                    FindDistinctCylinders(itemOwner);

                if (cylinders.Count < 2)
                {
                    Console.WriteLine(
                        "ERROR: Could not find two distinct cylindrical " +
                        "surfaces.");

                    return;
                }

                MatchCylindersToTerminalSides(
                    terminalSides,
                    cylinders);

                if (terminalSides[0].Cylinder is null ||
                    terminalSides[1].Cylinder is null)
                {
                    Console.WriteLine(
                        "ERROR: Could not match cylindrical surfaces.");

                    return;
                }

                // ============================================================
                // DETERMINE START / END  (start = shortest / smaller pipe)
                // ============================================================

                TerminalSide startingSide;
                TerminalSide endingSide;

                if (terminalSides[0].CylinderArea <=
                    terminalSides[1].CylinderArea)
                {
                    startingSide = terminalSides[0];
                    endingSide = terminalSides[1];
                }
                else
                {
                    startingSide = terminalSides[1];
                    endingSide = terminalSides[0];
                }

                // ============================================================
                // CREATE START POINT
                // ============================================================

                IpfcModelItem startPoint =
                    CreateDatumPointAtEdgeCenter(
                        itemOwner,
                        startingSide.Edge);

                if (startPoint is null)
                {
                    Console.WriteLine(
                        "ERROR: Could not create START_POINT.");

                    return;
                }

                SetModelItemName(
                    startPoint,
                    "START_POINT");

                Console.WriteLine(
                    "\nSTART_POINT created: " +
                    startPoint.GetName());

                // ============================================================
                // CREATE AXIS 1
                // ============================================================

                CreateAxisFromCylinder(
                    startingSide.Cylinder);

                // ============================================================
                // CREATE AXIS 2
                // ============================================================

                CreateAxisFromCylinder(
                    endingSide.Cylinder);

                IpfcModelItems updatedAxes =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_AXIS);

                if (updatedAxes is null ||
                    updatedAxes.Count <
                    initialAxisCount + 2)
                {
                    Console.WriteLine(
                        "ERROR: Two new axes were not created.");

                    return;
                }

                IpfcModelItem axis1 =
                    updatedAxes[
                        updatedAxes.Count - 2];

                IpfcModelItem axis2 =
                    updatedAxes[
                        updatedAxes.Count - 1];

                Console.WriteLine(
                    "AXIS1 created: " +
                    axis1.GetName());

                Console.WriteLine(
                    "AXIS2 created: " +
                    axis2.GetName());

                // ============================================================
                // CREATE MID POINT
                // ============================================================

                IpfcSession sessionContext =
                    (IpfcSession)Session;

                IpfcSelectionBuffer axisBuffer =
                    sessionContext.CurrentSelectionBuffer;

                axisBuffer.Clear();

                IpfcSelection axisSelection1 =
                    new CMpfcSelect()
                    .CreateModelItemSelection(
                        axis1,
                        null);

                IpfcSelection axisSelection2 =
                    new CMpfcSelect()
                    .CreateModelItemSelection(
                        axis2,
                        null);

                axisBuffer.AddSelection(
                    axisSelection1);

                axisBuffer.AddSelection(
                    axisSelection2);

                string midpointMacro =
                    "~ Command `ProCmdDatumPointGeneral` ;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

                Session.RunMacro(
                    midpointMacro);

                Thread.Sleep(2000);

                IpfcModelItems pointsAfterMidpoint =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_POINT);

                if (pointsAfterMidpoint is null ||
                    pointsAfterMidpoint.Count <
                    initialPointCount + 2)
                {
                    Console.WriteLine(
                        "ERROR: MID_POINT was not created.");

                    return;
                }

                IpfcModelItem midpoint =
                    pointsAfterMidpoint[
                        pointsAfterMidpoint.Count - 1];

                SetModelItemName(
                    midpoint,
                    "MID_POINT");

                Console.WriteLine(
                    "MID_POINT created: " +
                    midpoint.GetName());

                // ============================================================
                // CREATE END POINT
                // ============================================================

                IpfcModelItem endPoint =
                    CreateDatumPointAtEdgeCenter(
                        itemOwner,
                        endingSide.Edge);

                if (endPoint is null)
                {
                    Console.WriteLine(
                        "ERROR: Could not create END_POINT.");

                    return;
                }

                SetModelItemName(
                    endPoint,
                    "END_POINT");

                Console.WriteLine(
                    "END_POINT created: " +
                    endPoint.GetName());

                // ============================================================
                // DISTANCES
                // ============================================================

                startingSide.PipeDistance =
                    GetSelectionDistance(
                        midpoint,
                        startPoint);

                endingSide.PipeDistance =
                    GetSelectionDistance(
                        midpoint,
                        endPoint);

                double minimumPipeDistance =
                    startingSide.PipeDistance;

                double maximumPipeDistance =
                    endingSide.PipeDistance;

                solid.Regenerate(null);

                Session.get_CurrentWindow().Repaint();

                Console.WriteLine(
                    "\nSTARTING PIPE DETAILS");

                Console.WriteLine(
                    "  Starting point: " +
                    startPoint.GetName());

                Console.WriteLine(
                    "  Starting cylinder area: " +
                    startingSide.CylinderArea.ToString("F4"));

                Console.WriteLine(
                    "  Starting pipe distance: " +
                    minimumPipeDistance.ToString("F4"));

                Console.WriteLine(
                    "\nENDING PIPE DETAILS");

                Console.WriteLine(
                    "  Ending point: " +
                    endPoint.GetName());

                Console.WriteLine(
                    "  Ending cylinder area: " +
                    endingSide.CylinderArea.ToString("F4"));

                Console.WriteLine(
                    "  Ending pipe distance: " +
                    maximumPipeDistance.ToString("F4"));

                // ============================================================
                // CREATE COORDINATE SYSTEM 1
                //   Origin          -> START_POINT
                //   Direction 1     -> MID_POINT   ("use to project")
                //   Direction 2     -> END_POINT   ("use to determine" = Y)
                // ============================================================

                Console.WriteLine(
                    "\n========================================");

                Console.WriteLine(
                    "CREATING COORDINATE_1");

                Console.WriteLine(
                    "========================================");

                IpfcModelItem coordinate1 =
                    CreateCoordinateSystem(
                        itemOwner,
                        startPoint,
                        midpoint,
                        endPoint,
                        "COORDINATE_1");

                if (coordinate1 is null)
                {
                    Console.WriteLine(
                        "ERROR: COORDINATE_1 was not created.");

                    return;
                }

                // ============================================================
                // CHECK Y DIRECTION
                // ============================================================

                bool yOutward =
                    IsYAxisPointingOutward(
                        coordinate1,
                        startPoint,
                        midpoint);

                Console.WriteLine(
                    "\nCOORDINATE_1 Y DIRECTION");

                if (yOutward)
                {
                    Console.WriteLine(
                        "Y point is pointing OUTWARDS.");

                    Console.WriteLine(
                        "Do you want to flip Y inside?");

                    Console.Write(
                        "Enter YES or NO: ");

                    string answer =
                        Console.ReadLine();

                    if (!string.IsNullOrWhiteSpace(answer) &&
                        answer.Trim().Equals(
                            "YES",
                            StringComparison.OrdinalIgnoreCase))
                    {
                        Console.WriteLine(
                            "User selected YES. Flipping COORDINATE_1 Y axis.");

                        bool flipped1 =
                            FlipCoordinateSystemY(
                                coordinate1);

                        if (flipped1)
                        {
                            solid.Regenerate(null);
                            Session.get_CurrentWindow().Repaint();

                            Console.WriteLine(
                                "COORDINATE_1 Y axis flipped successfully.");
                        }
                        else
                        {
                            Console.WriteLine(
                                "WARNING: Could not flip COORDINATE_1.");
                        }
                    }
                    else
                    {
                        Console.WriteLine(
                            "COORDINATE_1 was not flipped.");
                    }
                }
                else
                {
                    Console.WriteLine(
                        "Y point is pointing INSIDE.");

                    Console.WriteLine(
                        "No flip required.");
                }

                // ============================================================
                // CREATE COORDINATE SYSTEM 2
                //   Same references, same position as COORDINATE_1.
                // ============================================================

                Console.WriteLine(
                    "\n========================================");

                Console.WriteLine(
                    "CREATING COORDINATE_2");

                Console.WriteLine(
                    "========================================");

                IpfcModelItem coordinate2 =
                    CreateCoordinateSystem(
                        itemOwner,
                        startPoint,
                        midpoint,
                        endPoint,
                        "COORDINATE_2");

                if (coordinate2 is null)
                {
                    Console.WriteLine(
                        "ERROR: COORDINATE_2 was not created.");

                    return;
                }

                // ============================================================
                // AUTOMATIC FLIP FOR COORDINATE_2
                //
                // COORDINATE_2 is built from the exact same three references,
                // so its Y axis starts out pointing the same way COORDINATE_1's
                // did BEFORE any user flip. If that original direction was
                // outward, COORDINATE_2 needs the same flip -- automatically,
                // with no prompt.
                // ============================================================

                if (yOutward)
                {
                    Console.WriteLine(
                        "COORDINATE_1's original Y direction was outward.");

                    Console.WriteLine(
                        "Automatically flipping COORDINATE_2 (no prompt).");

                    bool flipped2 =
                        FlipCoordinateSystemY(
                            coordinate2);

                    if (flipped2)
                    {
                        Console.WriteLine(
                            "COORDINATE_2 Y axis flipped successfully.");
                    }
                    else
                    {
                        Console.WriteLine(
                            "WARNING: Could not automatically flip COORDINATE_2.");
                    }
                }
                else
                {
                    Console.WriteLine(
                        "COORDINATE_1's original Y direction was inward. " +
                        "No flip needed for COORDINATE_2.");
                }

                // ============================================================
                // FINAL REGENERATION
                // ============================================================

                solid.Regenerate(null);

                Session.get_CurrentWindow().Repaint();

                Console.WriteLine(
                    "\n========================================");

                Console.WriteLine(
                    "PIPE TREE COMPLETED");

                Console.WriteLine(
                    "========================================");

                Console.WriteLine(
                    "START_POINT  = " +
                    startPoint.GetName());

                Console.WriteLine(
                    "MID_POINT    = " +
                    midpoint.GetName());

                Console.WriteLine(
                    "END_POINT    = " +
                    endPoint.GetName());

                Console.WriteLine(
                    "COORDINATE_1 = " +
                    coordinate1.GetName());

                Console.WriteLine(
                    "COORDINATE_2 = " +
                    coordinate2.GetName());

                Console.WriteLine(
                    "========================================");
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "Error in CreatePipeTree: " +
                    ex.Message);
            }
        }

        // ====================================================================
        // CREATE COORDINATE SYSTEM
        // ====================================================================
        //
        // IMPORTANT FIX vs. the previous version:
        //
        // The API's CurrentSelectionBuffer (used by SelectModelItem()) and
        // the interactive UI dialog's own collector state are two SEPARATE
        // things -- populating one does not feed the other. That is why the
        // dialog's Origin/Direction1/Direction2 collectors kept ending up
        // empty or wrong no matter how the calls were ordered.
        //
        // This version drops SelectModelItem() entirely for these three
        // references and instead TYPES each point's real name straight into
        // its collector field with `~ Input` / `~ Update`, exactly the same
        // technique this file already uses successfully for the coordinate
        // system's own Name field (t3.datum_csys_name, further down). Since
        // CreatePipeTree() always renames these points to START_POINT /
        // MID_POINT / END_POINT before this function runs, each collector
        // can resolve its reference purely from the typed name -- no 3D pick
        // and no dependence on the API selection buffer at all.
        //
        // Sequence per reference: Focus -> FocusIn -> Input(name) ->
        // Update(name) -> FocusOut.
        //
        // NOTE: exact widget names (`t1.OriginPlacement`, `t2.DirectionTable1`,
        // `t2.AxisMenu1`, etc.) are taken from your original recorded mapkey.
        // If your Creo version/language renders different dialog IDs, re-record
        // a trail doing this exact sequence and swap in the real widget names --
        // the underlying technique (type the name in, then Update) is what
        // needs to be preserved.
        // ====================================================================

        private static IpfcModelItem CreateCoordinateSystem(
            IpfcModelItemOwner itemOwner,
            IpfcModelItem startPoint,
            IpfcModelItem midpoint,
            IpfcModelItem endPoint,
            string coordinateName)
        {
            try
            {
                IpfcModelItems before =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_COORD_SYS);

                int countBefore = before?.Count ?? 0;

                // IMPORTANT:
                // Do NOT use CurrentSelectionBuffer for the CSYS references.
                // The rerecorded Creo mapkey explicitly drives the CSYS
                // dashboard collectors and selects the three point features
                // from the model tree:
                //
                // T3 10 -> Origin
                // T3 13 -> Direction 1 / reference
                // T3 14 -> Direction 2 / reference
                //
                // This is intentionally replayed exactly as recorded.
                // The point features have already been created before this
                // method is called.

                string coordinateMapkey =
                    "~ Command `ProCmdDatumCsys` ;" +
                    "~ Move `Odui_Dlg_00` `Odui_Dlg_00` 2 22.101167 5.852140;" +
                    "~ Trigger `Odui_Dlg_00` `t1.OriginPlacement` 2 `DuMmY` `constr`;" +
                    "~ Focus `Odui_Dlg_00` `t1.OriginPlacement`;" +
                    "~ FocusIn `Odui_Dlg_00` `t1.OriginPlacement`;" +
                    "~ Select `Odui_Dlg_00` `t1.OriginPlacement` 2 `DuMmY` `constr`;" +
                    "~ Timer `` `` `CollectorWdg_FocusTimer`;" +
                    "~ Trigger `Odui_Dlg_00` `t1.OriginPlacement` 2 `` ``;" +
                    "~ FocusOut `Odui_Dlg_00` `t1.OriginPlacement`;" +
                    "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `T3 10`;" +
                    "~ Select `Odui_Dlg_00` `pg_vis_tab` 1 `tab_2`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable1` 2 `DuMmY` `ref`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable1` 2 `` ``;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable1` 2 `DuMmY` `ref`;" +
                    "~ Focus `Odui_Dlg_00` `t2.DirectionTable1`;" +
                    "~ FocusIn `Odui_Dlg_00` `t2.DirectionTable1`;" +
                    "~ Select `Odui_Dlg_00` `t2.DirectionTable1` 2 `DuMmY` `ref`;" +
                    "~ Timer `` `` `CollectorWdg_FocusTimer`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable1` 2 `` ``;" +
                    "~ FocusOut `Odui_Dlg_00` `t2.DirectionTable1`;" +
                    "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `T3 13`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable2` 2 `DuMmY` `ref2`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable2` 2 `` ``;" +
                    "~ Open `Odui_Dlg_00` `t2.AxisMenu1`;" +
                    "~ Close `Odui_Dlg_00` `t2.AxisMenu1`;" +
                    "~ Select `Odui_Dlg_00` `t2.AxisMenu1` 1 `Axis_Y`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable2` 2 `DuMmY` `ref2`;" +
                    "~ Focus `Odui_Dlg_00` `t2.DirectionTable2`;" +
                    "~ FocusIn `Odui_Dlg_00` `t2.DirectionTable2`;" +
                    "~ Select `Odui_Dlg_00` `t2.DirectionTable2` 2 `DuMmY` `ref2`;" +
                    "~ Timer `` `` `CollectorWdg_FocusTimer`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable2` 2 `` ``;" +
                    "~ FocusOut `Odui_Dlg_00` `t2.DirectionTable2`;" +
                    "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `T3 14`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable2` 2 `0` `ref2`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable2` 2 `` ``;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable1` 2 `0` `ref`;" +
                    "~ Trigger `Odui_Dlg_00` `t2.DirectionTable1` 2 `` ``;" +
                    "~ Select `Odui_Dlg_00` `pg_vis_tab` 1 `tab_3`;" +
                    "~ Input `Odui_Dlg_00` `t3.datum_csys_name` `" +
                    coordinateName + "`;" +
                    "~ Update `Odui_Dlg_00` `t3.datum_csys_name` `" +
                    coordinateName + "`;" +
                    "~ FocusOut `Odui_Dlg_00` `t3.datum_csys_name`;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

                Console.WriteLine(
                    "Creating " + coordinateName +
                    " using the rerecorded CSYS mapkey...");

                Session.RunMacro(coordinateMapkey);

                // Give Creo enough time to finish the dashboard operation.
                Thread.Sleep(2200);

                IpfcModelItems after =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_COORD_SYS);

                if (after is null || after.Count <= countBefore)
                {
                    Console.WriteLine(
                        "ERROR: " + coordinateName +
                        " was not created by the mapkey.");
                    return null;
                }

                IpfcModelItem coordinateSystem =
                    after[after.Count - 1];

                // The mapkey already sets the Creo CSYS property name.
