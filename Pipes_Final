        private const string FLIP_Y_MAPKEY =
            "~ Command `ProCmdFeatEdit` ;" +
            "~ Select `Odui_Dlg_00` `pg_vis_tab` 1 `tab_2`;" +
            "~ Open `Odui_Dlg_00` `t2.AxisMenu1`;" +
            "~ Close `Odui_Dlg_00` `t2.AxisMenu1`;" +
            "~ Select `Odui_Dlg_00` `t2.AxisMenu1` 1 `Axis_Y`;" +
            "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

        private static bool FlipCoordinateSystemY(
            IpfcModelItem coordinateSystemItem)
        {
            try
            {
                if (coordinateSystemItem is null)
                {
                    Console.WriteLine(
                        "ERROR: Coordinate system is null.");

                    return false;
                }

                IpfcSession creoSession =
                    (IpfcSession)Session;

                IpfcSelectionBuffer buffer =
                    creoSession.CurrentSelectionBuffer;

                buffer.Clear();

                IpfcSelection csysSelection =
                    new CMpfcSelect()
                    .CreateModelItemSelection(
                        coordinateSystemItem,
                        null);

                buffer.AddSelection(
                    csysSelection);

                Session.RunMacro(
                    FLIP_Y_MAPKEY);

                Thread.Sleep(1500);

                Console.WriteLine(
                    "Flip macro replayed for: " +
                    coordinateSystemItem.GetName());

                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "ERROR flipping Y axis for " +
                    coordinateSystemItem.GetName() +
                    ": " +
                    ex.Message);

                return false;
            }
        }

