        private static bool IsYAxisPointingOutward(
            IpfcModelItem coordinateSystemItem,
            IpfcModelItem startPoint,
            IpfcModelItem midpoint)
        {
            try
            {
                IpfcCoordSystem coordinateSystem =
                    (IpfcCoordSystem)coordinateSystemItem;

                IpfcTransform3D transform =
                    coordinateSystem.CoordSys;

                IpfcVector3D yAxis =
                    transform.GetYAxis();

                if (yAxis is null)
                {
                    Console.WriteLine(
                        "WARNING: Could not obtain Y axis.");

                    return false;
                }

                double[] start =
                    GetModelItemCoordinates(
                        startPoint);

                double[] middle =
                    GetModelItemCoordinates(
                        midpoint);

                double[] outward =
                    new double[]
                    {
                        start[0] - middle[0],
                        start[1] - middle[1],
                        start[2] - middle[2]
                    };

                double outwardLength =
                    VectorLength(outward);

                double yLength =
                    Math.Sqrt(
                        yAxis[0] * yAxis[0] +
                        yAxis[1] * yAxis[1] +
                        yAxis[2] * yAxis[2]);

                if (outwardLength <=
                    DIRECTION_TOLERANCE)
                {
                    Console.WriteLine(
                        "WARNING: START_POINT and MID_POINT " +
                        "are too close.");

                    return false;
                }

                if (yLength <=
                    DIRECTION_TOLERANCE)
                {
                    Console.WriteLine(
                        "WARNING: Invalid Y axis.");

                    return false;
                }

                outward[0] /=
                    outwardLength;

                outward[1] /=
                    outwardLength;

                outward[2] /=
                    outwardLength;

                double yx =
                    yAxis[0] /
                    yLength;

                double yy =
                    yAxis[1] /
                    yLength;

                double yz =
                    yAxis[2] /
                    yLength;

                double dot =
                    yx * outward[0] +
                    yy * outward[1] +
                    yz * outward[2];

                Console.WriteLine(
                    "Y / outward dot product = " +
                    dot.ToString("F6"));

                return dot >
                       DIRECTION_TOLERANCE;
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "Error checking Y direction: " +
                    ex.Message);

                return false;
            }
        }

        private static double[] GetModelItemCoordinates(
            IpfcModelItem modelItem)
        {
            if (modelItem is null)
            {
                throw new Exception(
                    "Model item is null.");
            }

            IpfcSelection selection =
                new CMpfcSelect()
                .CreateModelItemSelection(
                    modelItem,
                    null);

            if (selection is null)
            {
                throw new Exception(
                    "Could not create selection.");
            }

            IpfcPoint3D point =
                selection.Point;

            if (point is null)
            {
                throw new Exception(
                    "Could not obtain IpfcPoint3D.");
            }

            return new double[]
            {
                point[0],
                point[1],
                point[2]
            };
        }
        private static double VectorLength(
            double[] vector)
        {
            return Math.Sqrt(
                vector[0] * vector[0] +
                vector[1] * vector[1] +
                vector[2] * vector[2]);
        }
