        public static void Connect()
        {
            try
            {
                Asc = new CCpfcAsyncConnection();
                Iac = Asc.Connect(null, null, null, null);
                Session = (IpfcBaseSession)Iac.Session;
            }
            catch
            {
                KillProcess("pfclscom");
                ConnectSecondTime();
            }
        }

        private static void ConnectSecondTime()
        {
            try
            {
                Asc = new CCpfcAsyncConnection();
                Iac = Asc.Connect(null, null, null, null);
                Session = (IpfcBaseSession)Iac.Session;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error connecting Creo: " + ex.Message);
            }
        }

        private static void KillProcess(string processName)
        {
            try
            {
                Process[] processes = Process.GetProcessesByName(processName);
                foreach (Process process in processes)
                {
                    process.Kill();
                }
            }
            catch { }
        }
    }
