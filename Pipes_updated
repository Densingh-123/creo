        private static bool InitializeWorkingModel(IpfcModel model)
        {
            try
            {
                bool isAssembly = model is IpfcAssembly;

                if (isAssembly)
                {
                    Console.WriteLine("\n=======================================================");
                    Console.WriteLine("Model is an ASSEMBLY: " + model.InstanceName);
                    Console.WriteLine("Searching all parts in the assembly for L-shaped / 1-bend pipe...");
                    Console.WriteLine("=======================================================");

                    // 1. Search all component parts in the assembly
                    List<IpfcModel> allComponents = new List<IpfcModel>();
                    HashSet<string> visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    CollectAllComponents((IpfcAssembly)model, allComponents, visited);

                    Console.WriteLine("Found " + allComponents.Count + " component part(s) in assembly hierarchy.");

                    IpfcModel bestPipeModel = null;
                    int highestScore = 0;

                    for (int i = 0; i < allComponents.Count; i++)
                    {
                        IpfcModel comp = allComponents[i];
                        int score = EvaluatePipeScore((IpfcModelItemOwner)comp, out int cylCount, out int torusCount, out int endsCount, out bool isBent);

                        Console.WriteLine("  [" + (i + 1) + "] " + comp.InstanceName +
                            " -> Cylinders: " + cylCount +
                            ", Bends (Torus): " + torusCount +
                            ", Terminal Ends: " + endsCount +
                            ", Is Non-Colinear (Bent): " + isBent +
                            " => Score: " + score);

                        if (score > highestScore && endsCount == 2)
                        {
                            highestScore = score;
                            bestPipeModel = comp;
                        }
                    }

                    // 2. If an L-shaped / 1-bend pipe part component is found, OPEN IN NEW WINDOW
                    if (bestPipeModel != null && highestScore >= 100)
                    {
                        Console.WriteLine("\n--> MATCH FOUND: Component '" + bestPipeModel.InstanceName +
                            "' is an L-shaped / 1-bend pipe (Score: " + highestScore + ").");
                        Console.WriteLine("--> Opening '" + bestPipeModel.InstanceName + "' in a NEW WINDOW in Creo...");

                        if (OpenModelInNewWindow(bestPipeModel))
                        {
                            WorkingModel = bestPipeModel;
                            WorkingItemOwner = (IpfcModelItemOwner)bestPipeModel;
                            FeatureItemOwner = (IpfcModelItemOwner)bestPipeModel;
                            Console.WriteLine("Successfully opened and activated window for: " + bestPipeModel.InstanceName);
                            return true;
                        }
                        else
                        {
                            Console.WriteLine("WARNING: Could not open in new window. Falling back to in-session model.");
                            WorkingModel = bestPipeModel;
                            WorkingItemOwner = (IpfcModelItemOwner)bestPipeModel;
                            FeatureItemOwner = (IpfcModelItemOwner)model;
                            return true;
                        }
                    }

                    // 3. Fallback: check if the top assembly itself has the pipe solid geometry (e.g. from Piping -> Make Solid)
                    int asmScore = EvaluatePipeScore((IpfcModelItemOwner)model, out int asmCyl, out int asmTorus, out int asmEnds, out bool asmBent);
                    Console.WriteLine("\nChecking top assembly geometry: Cylinders=" + asmCyl +
                        ", Torus=" + asmTorus + ", Ends=" + asmEnds + ", Bent=" + asmBent + " => Score: " + asmScore);

                    if (asmEnds >= 2 && asmCyl >= 1)
                    {
                        Console.WriteLine("Top assembly contains pipe geometry directly (Piping solid feature). Continuing in assembly window.");
                        WorkingModel = model;
                        WorkingItemOwner = (IpfcModelItemOwner)model;
                        FeatureItemOwner = (IpfcModelItemOwner)model;
                        return true;
                    }

                    Console.WriteLine("ERROR: No L-shaped or 1-bend pipe found in assembly or components.");
                    return false;
                }
                else
                {
                    Console.WriteLine("Model is a standalone part: " + model.InstanceName);
                    WorkingModel = model;
                    WorkingItemOwner = (IpfcModelItemOwner)model;
                    FeatureItemOwner = (IpfcModelItemOwner)model;
                    return true;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("ERROR initializing working model: " + ex.Message);
                return false;
            }
        }

        private static void CollectAllComponents(IpfcAssembly assembly, List<IpfcModel> collectedModels, HashSet<string> visitedNames)
        {
            try
            {
                IpfcModelItemOwner asmOwner = (IpfcModelItemOwner)assembly;
                IpfcModelItems features = asmOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (features == null) return;

                for (int i = 0; i < features.Count; i++)
                {
                    try
                    {
                        IpfcModelItem feat = features[i];
                        if (feat is IpfcComponentFeat compFeat)
                        {
                            IpfcModelDescriptor descr = compFeat.ModelDescr;
                            if (descr == null) continue;

                            IpfcModel compModel = Session.GetModelFromDescr(descr);
                            if (compModel == null) continue;

                            string name = compModel.InstanceName;
                            if (visitedNames.Contains(name)) continue;
                            visitedNames.Add(name);

                            if (compModel is IpfcAssembly subAsm)
                            {
                                CollectAllComponents(subAsm, collectedModels, visitedNames);
                            }
                            else if (compModel is IpfcSolid || compModel is IpfcPart)
                            {
                                collectedModels.Add(compModel);
                            }
                        }
                    }
                    catch { }
                }
            }
            catch { }
        }

        private static int EvaluatePipeScore(
            IpfcModelItemOwner itemOwner,
            out int cylinderCount,
            out int torusCount,
            out int terminalEndsCount,
            out bool isBent)
        {
            cylinderCount = CountCylinders(itemOwner);
            torusCount = CountTorusSurfaces(itemOwner);
            isBent = false;

            List<TerminalSide> ends = FindTerminalSides(itemOwner);
            terminalEndsCount = ends.Count;

            int score = 0;

            if (terminalEndsCount == 2)
            {
                score += 100; // Perfect 2 terminal ends
            }
            else if (terminalEndsCount > 2)
            {
                score += 30;
            }

            if (cylinderCount >= 2)
            {
                score += 40; // 2 straight pipe legs
            }
            else if (cylinderCount == 1)
            {
                score += 20; // 1 straight segment
            }

            if (torusCount >= 1)
            {
                score += 50; // Toroidal bend surface between legs
                isBent = true;
            }

            // Check if cylinder axes are non-colinear (bent / L-shaped)
            if (ends.Count == 2)
            {
                EnsureCylindersForTerminalSides(itemOwner, ends);
                if (ends[0].Cylinder != null && ends[1].Cylinder != null)
                {
                    double[] dir1 = GetCylinderAxisDirection(ends[0].Cylinder);
                    double[] dir2 = GetCylinderAxisDirection(ends[1].Cylinder);

                    if (dir1 != null && dir2 != null)
                    {
                        double dot = Math.Abs(dir1[0] * dir2[0] + dir1[1] * dir2[1] + dir1[2] * dir2[2]);
                        if (dot < 0.985) // Angle between legs is > 10 degrees (L-pipe or elbow)
                        {
                            score += 50;
                            isBent = true;
                        }
                    }
                }
            }

            return score;
        }

        private static bool OpenModelInNewWindow(IpfcModel model)
        {
            try
            {
                // Check if a window already exists for this model
                IpfcWindow window = null;
                try { window = Session.GetModelWindow(model); } catch { }

                if (window == null)
                {
                    try { window = Session.CreateModelWindow(model); } catch { }
                }

                if (window != null)
                {
                    window.Activate();
                    model.Display();
                    window.Refresh();
                }
                else
                {
                    model.DisplayInNewWindow();
                    try
                    {
                        window = Session.GetModelWindow(model);
                        window?.Activate();
                    }
                    catch { }
                }

                Thread.Sleep(1500);

                IpfcModel current = Session.CurrentModel;
                Console.WriteLine("Active model in Creo is now: " + (current?.InstanceName ?? "unknown"));
                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error opening model in new window: " + ex.Message);
                return false;
            }
        }

        private static int CountCylinders(IpfcModelItemOwner itemOwner)
        {
            try
            {
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null) return 0;
                int count = 0;
                for (int i = 0; i < surfaces.Count; i++)
                {
                    IpfcSurface surf = (IpfcSurface)surfaces[i];
                    if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                        count++;
                }
                return count;
            }
            catch
            {
                return 0;
            }
        }

        private static int CountTorusSurfaces(IpfcModelItemOwner itemOwner)
        {
            try
            {
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null) return 0;
                int count = 0;
                for (int i = 0; i < surfaces.Count; i++)
                {
                    IpfcSurface surf = (IpfcSurface)surfaces[i];
                    if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                        count++;
                }
                return count;
            }
            catch
            {
                return 0;
            }
        }

        private static double[] GetCylinderAxisDirection(IpfcSurface cylSurf)
        {
            try
            {
                IpfcTransformedSurface transSurf = cylSurf as IpfcTransformedSurface;
                if (transSurf != null && transSurf.CoordSys != null)
                {
                    IpfcVector3D zAxis = transSurf.CoordSys.GetZAxis();
                    if (zAxis != null)
                    {
                        double len = Math.Sqrt(zAxis[0] * zAxis[0] + zAxis[1] * zAxis[1] + zAxis[2] * zAxis[2]);
                        if (len > 0.0001)
                        {
                            return new double[] { zAxis[0] / len, zAxis[1] / len, zAxis[2] / len };
                        }
                    }
                }
            }
            catch { }
            return null;
        }

