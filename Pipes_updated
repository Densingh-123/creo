        private static Dictionary<string, string> FindTreeNodeNames(List<string> itemNames)
        {
            var result = new Dictionary<string, string>();
            var remaining = new List<string>(itemNames);

            IpfcSession creoSession = (IpfcSession)Session;
            IpfcSelectionBuffer buffer = creoSession.CurrentSelectionBuffer;

            Console.WriteLine("\nFinding tree node names for " + itemNames.Count + " item(s)...");

            // Expand model tree first so all child nodes are accessible
            try
            {
                Session.RunMacro("~ Command `ProCmdTreeExpandAll`;");
                Thread.Sleep(200);
            }
            catch { }

            int consecutiveMisses = 0;
            for (int i = 1; i <= 500 && remaining.Count > 0; i++)
            {
                string nodeName = "node" + i;

                try
                {
                    buffer.Clear();

                    string mapkey = "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `" + nodeName + "`;";
                    Session.RunMacro(mapkey);
                    Thread.Sleep(50);

                    IpfcSelections contents = buffer.Contents;
                    if (contents != null && contents.Count > 0)
                    {
                        consecutiveMisses = 0;
                        IpfcModelItem selItem = contents[0]?.get_SelItem();
                        if (selItem != null)
                        {
                            string foundName = "";
                            try { foundName = selItem.GetName(); } catch { }

                            for (int j = remaining.Count - 1; j >= 0; j--)
                            {
                                string targetName = remaining[j];
                                bool matched = false;

                                if (!string.IsNullOrEmpty(foundName) && foundName.Equals(targetName, StringComparison.OrdinalIgnoreCase))
                                {
                                    matched = true;
                                }
                                else if (selItem is IpfcFeature feat)
                                {
                                    try
                                    {
                                        IpfcModelItem featModelItem = feat as IpfcModelItem;
                                        if (featModelItem != null && featModelItem.GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase))
                                        {
                                            matched = true;
                                        }
                                        else
                                        {
                                            // Check sub-items inside feature
                                            IpfcModelItems subPoints = feat.ListSubItems(EpfcModelItemType.EpfcITEM_POINT);
                                            if (subPoints != null)
                                            {
                                                for (int k = 0; k < subPoints.Count; k++)
                                                {
                                                    if (subPoints[k].GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase)) { matched = true; break; }
                                                }
                                            }
                                            if (!matched)
                                            {
                                                IpfcModelItems subAxes = feat.ListSubItems(EpfcModelItemType.EpfcITEM_AXIS);
                                                if (subAxes != null)
                                                {
                                                    for (int k = 0; k < subAxes.Count; k++)
                                                    {
                                                        if (subAxes[k].GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase)) { matched = true; break; }
                                                    }
                                                }
                                            }
                                            if (!matched)
                                            {
                                                IpfcModelItems subCsys = feat.ListSubItems(EpfcModelItemType.EpfcITEM_COORD_SYS);
                                                if (subCsys != null)
                                                {
                                                    for (int c = 0; c < subCsys.Count; c++)
                                                    {
                                                        if (subCsys[c].GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase)) { matched = true; break; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    catch { }
                                }

                                if (matched)
                                {
                                    result[targetName] = nodeName;
                                    Console.WriteLine("  Found '" + targetName + "' at " + nodeName);
                                    remaining.RemoveAt(j);
                                    break;
                                }
                            }
                        }
                    }
                    else
                    {
                        consecutiveMisses++;
                        if (consecutiveMisses > 40 && i > 80)
                        {
                            break;
                        }
                    }
                }
                catch
                {
                }
            }

            if (remaining.Count > 0)
            {
                Console.WriteLine("Finished scanning. Located tree node names for: " + string.Join(", ", result.Keys));
            }
            else
            {
                Console.WriteLine("All tree node names found successfully.");
            }

            return result;
        }

