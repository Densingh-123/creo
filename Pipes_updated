            }

            return pointsAfter[
                pointsAfter.Count - 1];
        }

        private static double GetSelectionDistance(
            IpfcModelItem item1,
            IpfcModelItem item2)
        {
            IpfcSelection selection1 =
                new CMpfcSelect()
                .CreateModelItemSelection(
                    item1,
                    null);

            IpfcSelection selection2 =
                new CMpfcSelect()
                .CreateModelItemSelection(
                    item2,
                    null);

            IpfcSelectionPair pair =
                (IpfcSelectionPair)
                new CCpfcSelectionPair()
                .Create(
                    selection1,
                    selection2);

            IpfcSelectionEvaluator evaluator =
                new CMpfcInterference()
                .CreateSelectionEvaluator(
                    pair);

            double distance =
                evaluator
                .ComputeNearestCriticalDistance()
                .Distance;

            if (double.IsNaN(distance) ||
                double.IsInfinity(distance))
            {
                return 0.0;
            }

            return Math.Abs(distance);
        }
        private static double GetSurfaceDistance(
            IpfcSurface planeSurface,
            IpfcSurface cylinderSurface)
        {
            return GetSelectionDistance(
                (IpfcModelItem)planeSurface,
                (IpfcModelItem)cylinderSurface);
        }
        private static double GetSafeSurfaceDistance(
            IpfcSurface planeSurface,
            IpfcSurface cylinderSurface)
        {
            try
            {
                return GetSurfaceDistance(
                    planeSurface,
                    cylinderSurface);
            }
            catch
            {
                return double.MaxValue;
            }
        }

        private static double[] GetSurfaceOrigin(
            IpfcSurface surface)
        {
            IpfcTransformedSurface transformedSurface =
                (IpfcTransformedSurface)surface;

            IpfcMatrix3D matrix =
                transformedSurface.CoordSys.Matrix;

            return new double[]
            {
                matrix[3, 0],
                matrix[3, 1],
                matrix[3, 2]
            };
        }

        private static double Distance(
            double[] point1,
            double[] point2)
        {
            return Distance(
                point1[0],
                point1[1],
                point1[2],
                point2[0],
                point2[1],
                point2[2]);
        }

        private static double Distance(
            double x1,
            double y1,
            double z1,
            double x2,
            double y2,
            double z2)
        {
            return Math.Sqrt(
                Math.Pow(x1 - x2, 2.0) +
                Math.Pow(y1 - y2, 2.0) +
                Math.Pow(z1 - z2, 2.0));
        }


        public static void Connect()
        {
            try
            {
                Asc =
                    new CCpfcAsyncConnection();

                Iac =
                    Asc.Connect(
                        null,
                        null,
                        null,
                        null);

                Session =
                    (IpfcBaseSession)Iac.Session;
            }
            catch
            {
                KillProcess(
                    "pfclscom");

                ConnectSecondTime();
            }
        }
        private static void ConnectSecondTime()
        {
            try
            {
                Asc =
                    new CCpfcAsyncConnection();

                Iac =
                    Asc.Connect(
                        null,
                        null,
                        null,
                        null);

                Session =
                    (IpfcBaseSession)Iac.Session;
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "Error connecting Creo: " +
                    ex.Message);
            }
        }


        private static void KillProcess(
            string processName)
        {
            try
            {
                Process[] processes =
                    Process.GetProcessesByName(
                        processName);

                foreach (Process process
                         in processes)
                {
                    process.Kill();
                }
            }
            catch
            {
            }
        }
