        public static void CreatePipeTree()
        {
            try
            {
                IpfcModel model =Session.CurrentModel;
                IpfcSolid solid =(IpfcSolid)model;
                IpfcModelItemOwner itemOwner =(IpfcModelItemOwner)model;
                IpfcModelItems initialAxes =itemOwner.ListItems(EpfcModelItemType.EpfcITEM_AXIS);
                int initialAxisCount =initialAxes?.Count ?? 0;
                IpfcModelItems initialPoints =itemOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                int initialPointCount =initialPoints?.Count ?? 0;
                List<TerminalSide> terminalSides =FindTerminalSides(itemOwner);
                if (terminalSides.Count < 2)
                {
                    Console.WriteLine("ERROR: Could not find two terminal planes " +"with circular edges.");
                    return;
                }
                List<CylinderInfo> cylinders = FindDistinctCylinders(itemOwner);
                if (cylinders.Count < 2)
                {
                    Console.WriteLine("ERROR: Could not find two distinct cylindrical " +
                        "surfaces.");

                    return;
                }

                MatchCylindersToTerminalSides(
                    terminalSides,
                    cylinders);

                if (terminalSides[0].Cylinder is null ||
                    terminalSides[1].Cylinder is null)
                {
                    Console.WriteLine(
                        "ERROR: Could not match cylindrical surfaces.");

                    return;
                }

                TerminalSide startingSide;
                TerminalSide endingSide;

                if (terminalSides[0].CylinderArea <=
                    terminalSides[1].CylinderArea)
                {
                    startingSide = terminalSides[0];
                    endingSide = terminalSides[1];
                }
                else
                {
                    startingSide = terminalSides[1];
                    endingSide = terminalSides[0];
                }

                IpfcModelItem startPoint =
                    CreateDatumPointAtEdgeCenter(
                        itemOwner,
                        startingSide.Edge);

                if (startPoint is null)
                {
                    Console.WriteLine(
                        "ERROR: Could not create START_POINT.");

                    return;
                }

                SetModelItemName(
                    startPoint,
                    "PIPE_START_POINT");

                Console.WriteLine(
                    "\nSTART_POINT created: " +
                    startPoint.GetName());
                CreateAxisFromCylinder(
                    startingSide.Cylinder);

                CreateAxisFromCylinder(
                    endingSide.Cylinder);

                IpfcModelItems updatedAxes =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_AXIS);

                if (updatedAxes is null ||
                    updatedAxes.Count <
                    initialAxisCount + 2)
                {
                    Console.WriteLine(
                        "ERROR: Two new axes were not created.");

                    return;
                }

                IpfcModelItem axis1 =
                    updatedAxes[
                        updatedAxes.Count - 2];

                IpfcModelItem axis2 =
                    updatedAxes[
                        updatedAxes.Count - 1];

                Console.WriteLine(
                    "AXIS1 created: " +
                    axis1.GetName());

                Console.WriteLine(
                    "AXIS2 created: " +
                    axis2.GetName());
                IpfcSession sessionContext =
                    (IpfcSession)Session;

                IpfcSelectionBuffer axisBuffer =
                    sessionContext.CurrentSelectionBuffer;

                axisBuffer.Clear();

                IpfcSelection axisSelection1 =
                    new CMpfcSelect()
                    .CreateModelItemSelection(
                        axis1,
                        null);

                IpfcSelection axisSelection2 =
                    new CMpfcSelect()
                    .CreateModelItemSelection(
                        axis2,
                        null);

                axisBuffer.AddSelection(
                    axisSelection1);

                axisBuffer.AddSelection(
                    axisSelection2);

                string midpointMacro =
                    "~ Command `ProCmdDatumPointGeneral` ;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";

                Session.RunMacro(
                    midpointMacro);

                Thread.Sleep(2000);

                IpfcModelItems pointsAfterMidpoint =
                    itemOwner.ListItems(
                        EpfcModelItemType.EpfcITEM_POINT);

                if (pointsAfterMidpoint is null ||
                    pointsAfterMidpoint.Count <
                    initialPointCount + 2)
                {
                    Console.WriteLine(
                        "ERROR: MID_POINT was not created.");

                    return;
                }

                IpfcModelItem midpoint =
                    pointsAfterMidpoint[
                        pointsAfterMidpoint.Count - 1];

                SetModelItemName(
                    midpoint,
                    "PIPE_Z_POINT");

                Console.WriteLine(
                    "MID_POINT created: " +
                    midpoint.GetName());
                IpfcModelItem endPoint =
                    CreateDatumPointAtEdgeCenter(
                        itemOwner,
                        endingSide.Edge);

                if (endPoint is null)
                {
                    Console.WriteLine(
                        "ERROR: Could not create END_POINT.");

                    return;
                }

                SetModelItemName(
                    endPoint,
                    "PIPE_END_POINT");

                Console.WriteLine(
                    "END_POINT created: " +
                    endPoint.GetName());
                startingSide.PipeDistance =
                    GetSelectionDistance(
                        midpoint,
                        startPoint);

                endingSide.PipeDistance =
                    GetSelectionDistance(
                        midpoint,
                        endPoint);

                bool isStartingShorter =
                    startingSide.PipeDistance <= endingSide.PipeDistance;

                double minimumPipeDistance =
                    isStartingShorter
                        ? startingSide.PipeDistance
                        : endingSide.PipeDistance;

                double maximumPipeDistance =
                    isStartingShorter
                        ? endingSide.PipeDistance
                        : startingSide.PipeDistance;

                string shorterNode = isStartingShorter ? "node10" : "node14";
                string longerNode = isStartingShorter ? "node14" : "node10";
                IpfcModelItem shorterPoint = isStartingShorter ? startPoint : endPoint;
                IpfcModelItem longerPoint = isStartingShorter ? endPoint : startPoint;

                solid.Regenerate(null);

                Session.get_CurrentWindow().Repaint();

                Console.WriteLine(
                    "\nSTARTING PIPE DETAILS");

                Console.WriteLine(
                    "  Starting point: " +
                    startPoint.GetName());

                Console.WriteLine(
                    "  Starting cylinder area: " +
                    startingSide.CylinderArea.ToString("F4"));

                Console.WriteLine(
                    "  Starting pipe distance: " +
                    startingSide.PipeDistance.ToString("F4"));

                Console.WriteLine(
                    "\nENDING PIPE DETAILS");

                Console.WriteLine(
                    "  Ending point: " +
                    endPoint.GetName());

                Console.WriteLine(
                    "  Ending cylinder area: " +
                    endingSide.CylinderArea.ToString("F4"));

                Console.WriteLine(
                    "  Ending pipe distance: " +
                    endingSide.PipeDistance.ToString("F4"));

                Console.WriteLine(
                    "\nSHORTER PIPE: " +
                    (isStartingShorter ? "STARTING PIPE (" + startPoint.GetName() + ")" : "ENDING PIPE (" + endPoint.GetName() + ")") +
                    " with distance: " + minimumPipeDistance.ToString("F4"));

                Console.WriteLine(
                    "\n========================================");

                Console.WriteLine(
                    "CREATING COORDINATE_1 (at " + shorterPoint.GetName() + " on shorter pipe)");

                Console.WriteLine(
                    "========================================");

                IpfcModelItem coordinate1 =
                    CreateCoordinateSystem(
                        itemOwner,
                        shorterNode,
                        "node13",
                        longerNode,
                        "Axis_Y",
                        true,   // flipInitial = true: creates Y axis pointing OUTWARDS (outside) initially
                        "BEND_DATA");

                if (coordinate1 is null)
                {
                    Console.WriteLine(
                        "ERROR: COORDINATE_1 was not created.");

                    return;
                }

                solid.Regenerate(null);
                Session.get_CurrentWindow().Repaint();

                Console.WriteLine(
                    "\nCOORDINATE_1 (BEND_DATA) created pointing OUTWARDS (outside).");

                // Ask user in message box for BEND_DATA only
                Console.WriteLine(
                    "Displaying message box: Y axis is pointing outside. Ask user if they want to switch to inside...");

                DialogResult result = MessageBox.Show(
                    "COORDINATE_1 (BEND_DATA):\nThe Y axis is currently pointing OUTWARDS (outside).\n\nDo you want to switch the axis to point INWARDS (inside)?",
                    "BEND_DATA - Y Axis Direction",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

                if (result == DialogResult.Yes)
                {
                    Console.WriteLine(
                        "User selected YES in message box. Switching BEND_DATA Y axis to point INWARDS (inside)...");

                    FlipCoordinateSystemY(coordinate1);

                    solid.Regenerate(null);
                    Session.get_CurrentWindow().Repaint();

                    Console.WriteLine(
                        "COORDINATE_1 (BEND_DATA) Y axis switched to point INWARDS (inside) successfully.");
                }
                else
                {
                    Console.WriteLine(
                        "User selected NO in message box. COORDINATE_1 (BEND_DATA) Y axis kept pointing OUTWARDS (outside).");
                }

                Console.WriteLine(
                    "\n========================================");

                Console.WriteLine(
                    "CREATING COORDINATE_2 (at " + shorterPoint.GetName() + " on shorter pipe)");

                Console.WriteLine(
                    "========================================");

                IpfcModelItem coordinate2 =
                    CreateCoordinateSystem(
                        itemOwner,
                        shorterNode,
                        "node13",
                        longerNode,
                        "Axis_Y",
                        false,  // flipInitial = false: automatically points INWARDS directly
                        "PIPE_BOUND_BOX");

                if (coordinate2 is null)
                {
                    Console.WriteLine(
                        "ERROR: COORDINATE_2 was not created.");

                    return;
                }

                solid.Regenerate(null);
                Session.get_CurrentWindow().Repaint();

                Console.WriteLine(
                    "COORDINATE_2 (PIPE_BOUND_BOX) created pointing INWARDS (inside) automatically.");

                Console.WriteLine(
                    "\n========================================");

                Console.WriteLine(
                    "PIPE TREE COMPLETED");

                Console.WriteLine(
                    "========================================");

                Console.WriteLine(
                    "START_POINT  = " +
                    startPoint.GetName());

                Console.WriteLine(
                    "MID_POINT    = " +
                    midpoint.GetName());

                Console.WriteLine(
                    "END_POINT    = " +
                    endPoint.GetName());

                Console.WriteLine(
                    "COORDINATE_1 = " +
                    coordinate1.GetName());

                Console.WriteLine(
                    "COORDINATE_2 = " +
                    coordinate2.GetName());

                Console.WriteLine(
                    "========================================");
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    "Error in CreatePipeTree: " +
                    ex.Message);
            }
        }
