<Window x:Class="AGCE_Planetory_RingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AGCE_Planetory_RingApp"
        mc:Ignorable="d"
        Title="AGCE Planetory Ring - Creo Parametric Automation"
        Height="700" Width="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Style for group boxes -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Style for buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6B6B6B"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border Grid.Row="0" Background="#0078D4" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚙️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AGCE Planetory Ring - Creo Parametric Automation"
                               Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Connect to Creo · Open Drawing · Generate Views · Export to PDF"
                               Foreground="#E0E0E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN CONTENT ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ===== FILE SELECTION ===== -->
                <GroupBox Header="1. Select the Part/Assembly File">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtFilePath" Grid.Row="0" Grid.Column="0"
                                 Height="34" VerticalContentAlignment="Center"
                                 Text="Select a .prt or .asm file..."
                                 Foreground="#999" FontSize="13"
                                 Padding="8,0"
                                 BorderBrush="#CCC" BorderThickness="1.5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button x:Name="btnBrowse" Grid.Row="0" Grid.Column="1"
                                Content="📁  Browse" Width="110" Height="34"
                                Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0"
                                Click="btnBrowse_Click"/>
                    </Grid>
                </GroupBox>

                <!-- ===== PARAMETERS ===== -->
                <GroupBox Header="2. Find &amp; Update Parameters">
                    <StackPanel>
                        <TextBlock Text="Enter parameter names and new values to update in the model:"
                                   Foreground="#555" Margin="0,0,0,8" FontWeight="Normal" FontSize="12"/>

                        <!-- Parameter list header -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Parameter Name" FontWeight="Bold" FontSize="12" Foreground="#333"/>
                            <TextBlock Grid.Column="1" Text="New Value" FontWeight="Bold" FontSize="12" Foreground="#333" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Parameter rows container -->
                        <ItemsControl x:Name="paramItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding ParamName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" VerticalContentAlignment="Center"
                                                     Padding="6,0" BorderBrush="#CCC"/>
                                            <TextBox Grid.Column="1" Text="{Binding ParamValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" VerticalContentAlignment="Center"
                                                     Padding="6,0" BorderBrush="#CCC" Margin="8,0,0,0"/>
                                            <Border Grid.Column="2" Width="28" Height="28"
                                                    Background="#E81123" CornerRadius="4"
                                                    Margin="6,0,0,0">
                                                <Button Content="✕" FontSize="12"
                                                        Foreground="White" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding RemoveCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove this parameter"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="btnAddParam" Content="+  Add Parameter"
                                Style="{StaticResource SmallButton}"
                                Background="#107C10" Width="150"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="btnAddParam_Click"/>

                        <TextBlock x:Name="txtDefaultParams" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#888" Margin="0,6,0,0" FontWeight="Normal">
                            Default parameters: DESCRIPTION, MATERIAL, MASS, DENSITY, DRAWING_NUMBER, REVISION
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- ===== STATUS LOG ===== -->
                <GroupBox Header="3. Execution Log">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="txtLog" Grid.Row="0"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="#1E1E1E" Foreground="#D4D4D4"
                                 Padding="10,8"
                                 BorderThickness="1" BorderBrush="#333"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== BOTTOM BAR ===================== -->
        <Border Grid.Row="2" Background="#F0F0F0" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Progress Bar -->
                <ProgressBar x:Name="progressBar" Grid.Column="1"
                             Height="24"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#0078D4" Background="#E0E0E0"
                             BorderThickness="0" Margin="0,0,12,0"/>

                <!-- Execute Button -->
                <Button x:Name="btnExecute" Grid.Column="2"
                        Content="▶  Execute Automation"
                        Style="{StaticResource PrimaryButton}"
                        Height="36" Width="190"
                        IsEnabled="False"
                        Click="btnExecute_Click"/>

                <!-- Clear Log Button -->
                <Button x:Name="btnClearLog" Grid.Column="3"
                        Content="Clear Log"
                        Style="{StaticResource SmallButton}"
                        Background="#888" Height="36" Width="90"
                        Margin="8,0,0,0"
                        Click="btnClearLog_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
