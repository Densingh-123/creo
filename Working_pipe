                    if (p != null)
                    {
                        return new double[] { p[0], p[1], p[2] };
                    }
                }
                IpfcSelection sel = new CMpfcSelect().CreateModelItemSelection(pointItem, null);
                if (sel != null && sel.Point != null)
                {
                    return new double[] { sel.Point[0], sel.Point[1], sel.Point[2] };
                }
            }
            catch { }
            return null;
        }

