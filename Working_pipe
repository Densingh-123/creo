        private static bool InitializeWorkingModel(IpfcModel model)
        {
            try
            {
                bool isAssembly = model is IpfcAssembly;

                if (isAssembly)
                {
                    Console.WriteLine("Model is an ASSEMBLY: " + model.InstanceName);
                    Console.WriteLine("Searching all parts in the assembly for 1-bend / L-shaped pipe...");
                    List<IpfcModel> allComponents = new List<IpfcModel>();
                    HashSet<string> visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    CollectAllComponents((IpfcAssembly)model, allComponents, visited);
                    Console.WriteLine("Found " + allComponents.Count + " component part(s) in assembly hierarchy.");
                    IpfcModel bestOneBendModel = null;
                    int multiBendCount = 0;
                    for (int i = 0; i < allComponents.Count; i++)
                    {
                        IpfcModel comp = allComponents[i];
                        int bends = CountDistinctBends((IpfcModelItemOwner)comp);
                        List<TerminalSide> ends = FindTerminalSides((IpfcModelItemOwner)comp);
                        Console.WriteLine("  [" + (i + 1) + "] " + comp.InstanceName + " -> Ends: " + ends.Count + ", Bends: " + bends);
                        if (ends.Count == 2)
                        {
                            if (bends == 1)
                            {
                                if (bestOneBendModel == null)
                                {
                                    bestOneBendModel = comp;
                                }
                            }
                            else if (bends > 1)
                            {
                                multiBendCount++;
                            }
                        }
                    }
                    if (bestOneBendModel != null)
                    {
                        Console.WriteLine("\n--> MATCH FOUND: Component '" + bestOneBendModel.InstanceName + "' is a 1-bend (L-shaped) pipe.");
                        Console.WriteLine("--> Opening '" + bestOneBendModel.InstanceName + "' in a NEW WINDOW in Creo...");

                        if (OpenModelInNewWindow(bestOneBendModel))
                        {
                            WorkingModel = bestOneBendModel;
                            WorkingItemOwner = (IpfcModelItemOwner)bestOneBendModel;
                            FeatureItemOwner = (IpfcModelItemOwner)bestOneBendModel;
                            Console.WriteLine("Successfully opened and activated window for: " + bestOneBendModel.InstanceName);
                            return true;
                        }
                        else
                        {
                            Console.WriteLine("WARNING: Could not open in new window. Falling back to in-session model.");
                            WorkingModel = bestOneBendModel;
                            WorkingItemOwner = (IpfcModelItemOwner)bestOneBendModel;
                            FeatureItemOwner = (IpfcModelItemOwner)model;
                            return true;
                        }
                    }

                    int asmBends = CountDistinctBends((IpfcModelItemOwner)model);
                    List<TerminalSide> asmEnds = FindTerminalSides((IpfcModelItemOwner)model);

                    if (asmEnds.Count == 2 && asmBends == 1)
                    {
                        Console.WriteLine("Top assembly contains 1-bend pipe geometry directly. Continuing in assembly window.");
                        WorkingModel = model;
                        WorkingItemOwner = (IpfcModelItemOwner)model;
                        FeatureItemOwner = (IpfcModelItemOwner)model;
                        return true;
                    }
                    else if (asmEnds.Count == 2 && asmBends > 1)
                    {
                        multiBendCount++;
                    }
                    if (multiBendCount > 0)
                    {
                        Console.WriteLine("No 1-bend pipe found in assembly. Found multi-bend pipe(s).");
                        MessageBox.Show(
                            "No 1-bend (L-shaped) pipe found in the assembly.\n\n" +
                            "The assembly contains multi-bend pipe(s) with more than one bend. " +
                            "This automation currently supports only 1-bend (L-shaped) pipes.",
                            "Multi-Bend Pipe Detected",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Information);
                    }
                    else
                    {
                        Console.WriteLine("No 1-bend pipe found in assembly.");
                        MessageBox.Show(
                            "No 1-bend (L-shaped) pipe found in the active assembly hierarchy.",
                            "No 1-Bend Pipe Found",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning);
                    }

                    return false;
                }
                else
                {

                    Console.WriteLine("Model is a standalone part: " + model.InstanceName);
                    int partBends = CountDistinctBends((IpfcModelItemOwner)model);
                    List<TerminalSide> partEnds = FindTerminalSides((IpfcModelItemOwner)model);

                    Console.WriteLine("Part analysis: Ends = " + partEnds.Count + ", Bends = " + partBends);

                    if (partEnds.Count == 2)
                    {
                        if (partBends == 1)
                        {
                            WorkingModel = model;
                            WorkingItemOwner = (IpfcModelItemOwner)model;
                            FeatureItemOwner = (IpfcModelItemOwner)model;
                            return true;
                        }
                        else if (partBends > 1)
                        {
                            Console.WriteLine("Standalone part has more than one bend (" + partBends + " bends).");
                            MessageBox.Show(
                                "The open model has " + partBends + " bends (more than one bend).\n\n" +
                                "This automation currently supports only 1-bend (L-shaped) pipes.",
                                "Multi-Bend Pipe Detected",
                                MessageBoxButtons.OK,
                                MessageBoxIcon.Information);
                            return false;
                        }
                        else
                        {
                            Console.WriteLine("Standalone part has no bends (straight pipe).");
                            MessageBox.Show(
                                "The open model is a straight pipe with no bends.\n\n" +
                                "This automation requires a 1-bend (L-shaped) pipe.",
                                "Straight Pipe Detected",
                                MessageBoxButtons.OK,
                                MessageBoxIcon.Warning);
                            return false;
                        }
                    }
                    else
                    {
                        Console.WriteLine("Open model is not a valid 2-ended pipe.");
                        MessageBox.Show(
                            "The open model is not a recognized pipe geometry (found " + partEnds.Count + " terminal ends).",
                            "Invalid Model",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning);
                        return false;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("ERROR initializing working model: " + ex.Message);
                return false;
            }
        }

        private static int CountDistinctBends(IpfcModelItemOwner itemOwner)
        {
            try
            {
                IpfcModelItems surfaces = itemOwner.ListItems(EpfcModelItemType.EpfcITEM_SURFACE);
                if (surfaces == null) return 0;

                List<double[]> torusCenters = new List<double[]>();
                const double CENTER_TOLERANCE = 2.0;

                for (int i = 0; i < surfaces.Count; i++)
                {
                    try
                    {
                        IpfcSurface surf = (IpfcSurface)surfaces[i];
                        if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_TORUS)
                        {
                            IpfcTransformedSurface trans = surf as IpfcTransformedSurface;
                            if (trans != null && trans.CoordSys != null)
                            {
                                IpfcPoint3D origin = trans.CoordSys.GetOrigin();
                                if (origin != null)
                                {
                                    double[] c = new double[] { origin[0], origin[1], origin[2] };
                                    bool isDuplicate = false;
                                    for (int k = 0; k < torusCenters.Count; k++)
                                    {
                                        if (Distance(c, torusCenters[k]) < CENTER_TOLERANCE)
                                        {
                                            isDuplicate = true;
                                            break;
                                        }
                                    }
                                    if (!isDuplicate)
                                    {
                                        torusCenters.Add(c);
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }

                if (torusCenters.Count > 0)
                {
                    return torusCenters.Count;
                }
                List<double[]> cylinderDirs = new List<double[]>();
                for (int i = 0; i < surfaces.Count; i++)
                {
                    try
                    {
                        IpfcSurface surf = (IpfcSurface)surfaces[i];
                        if (surf.GetSurfaceType() == (int)EpfcSurfaceType.EpfcSURFACE_CYLINDER)
                        {
                            double[] dir = GetCylinderAxisDirection(surf);
                            if (dir != null)
                            {
                                bool isDuplicate = false;
                                for (int k = 0; k < cylinderDirs.Count; k++)
                                {
                                    double dot = Math.Abs(dir[0] * cylinderDirs[k][0] + dir[1] * cylinderDirs[k][1] + dir[2] * cylinderDirs[k][2]);
                                    if (dot > 0.985) // Colinear
                                    {
                                        isDuplicate = true;
                                        break;
                                    }
                                }
                                if (!isDuplicate)
                                {
                                    cylinderDirs.Add(dir);
                                }
                            }
                        }
                    }
                    catch { }
                }

                if (cylinderDirs.Count >= 2)
                {
                    return cylinderDirs.Count - 1;
                }

                return 0;
            }
            catch
            {
                return 0;
            }
        }

        private static void CollectAllComponents(IpfcAssembly assembly, List<IpfcModel> collectedModels, HashSet<string> visitedNames)
        {
            try
            {
                IpfcModelItemOwner asmOwner = (IpfcModelItemOwner)assembly;
                IpfcModelItems features = asmOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (features == null) return;

                for (int i = 0; i < features.Count; i++)
                {
                    try
                    {
                        IpfcModelItem feat = features[i];
                        if (feat is IpfcComponentFeat compFeat)
                        {
                            IpfcModelDescriptor descr = compFeat.ModelDescr;
                            if (descr == null) continue;

                            IpfcModel compModel = Session.GetModelFromDescr(descr);
                            if (compModel == null) continue;

                            string name = compModel.InstanceName;
                            if (visitedNames.Contains(name)) continue;
                            visitedNames.Add(name);

                            if (compModel is IpfcAssembly subAsm)
                            {
                                CollectAllComponents(subAsm, collectedModels, visitedNames);
                            }
                            else if (compModel is IpfcSolid || compModel is IpfcPart)
                            {
                                collectedModels.Add(compModel);
                            }
                        }
                    }
                    catch { }
                }
            }
            catch { }
        }

        private static bool OpenModelInNewWindow(IpfcModel model)
        {
            try
            {
                IpfcWindow window = null;
                try { window = Session.GetModelWindow(model); } catch { }

                if (window == null)
                {
                    try { window = Session.CreateModelWindow(model); } catch { }
                }

                if (window != null)
                {
                    window.Activate();
                    model.Display();
                    window.Refresh();
                }
                else
                {
                    model.DisplayInNewWindow();
                    try
                    {
                        window = Session.GetModelWindow(model);
                        window?.Activate();
                    }
                    catch { }
                }

                Thread.Sleep(1500);

                IpfcModel current = Session.CurrentModel;
                Console.WriteLine("Active model in Creo is now: " + (current?.InstanceName ?? "unknown"));
                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error opening model in new window: " + ex.Message);
                return false;
            }
        }

        private static double[] GetCylinderAxisDirection(IpfcSurface cylSurf)
        {
            try
            {
                IpfcTransformedSurface transSurf = cylSurf as IpfcTransformedSurface;
                if (transSurf != null && transSurf.CoordSys != null)
                {
                    IpfcVector3D zAxis = transSurf.CoordSys.GetZAxis();
                    if (zAxis != null)
                    {
                        double len = Math.Sqrt(zAxis[0] * zAxis[0] + zAxis[1] * zAxis[1] + zAxis[2] * zAxis[2]);
                        if (len > 0.0001)
                        {
                            return new double[] { zAxis[0] / len, zAxis[1] / len, zAxis[2] / len };
                        }
                    }
                }
            }
            catch { }
            return null;
        }


        private static bool IsPipeTargetName(string name)
        {
            if (string.IsNullOrEmpty(name)) return false;
            string upper = name.ToUpperInvariant().Trim();


            if (upper == "PIPE_START_POINT" ||
                upper == "PIPE_Z_POINT" ||
                upper == "PIPE_END_POINT" ||
                upper == "PIPE_AXIS_START" ||
                upper == "PIPE_AXIS_END" ||
                upper == "BEND_DATA" ||
                upper == "PIPE_BOUND_BOX")
            {
                return true;
            }

            if (upper == "A_1" || upper == "A_2" || upper == "A_3" || upper == "A_4" ||
                upper == "A1" || upper == "A2" || upper == "A3" || upper == "A4")
            {
                return true;
            }
            if (upper.StartsWith("A_") && upper.Length <= 5)
            {
                string suffix = upper.Substring(2);
                if (int.TryParse(suffix, out _))
                    return true;
            }

            // Substring matches for pipe items
            if (upper.Contains("PIPE_START") ||
                upper.Contains("PIPE_END") ||
                upper.Contains("PIPE_Z") ||
                upper.Contains("PIPE_AXIS") ||
                upper.Contains("BEND_DATA") ||
                upper.Contains("BOUND_BOX"))
            {
                return true;
            }

            return false;
        }

        private static bool CheckAndDeleteExistingItems(IpfcModelItemOwner featureOwner)
        {
            List<string> existingItems = new List<string>();

            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_COORD_SYS), "Coord System", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_AXIS), "Axis", existingItems);
            CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT), "Point", existingItems);
           // CollectPipeItems(featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE), "Feature", existingItems);

            if (existingItems.Count == 0)
            {
                Console.WriteLine("No existing pipe items found. Proceeding with creation.");
                return true;
            }

            Console.WriteLine("\nThe following existing items were found:");
            foreach (string item in existingItems)
            {
                Console.WriteLine("  - " + item);
            }

            DialogResult result = MessageBox.Show(
                "The following existing items were found:\n\n" +
                string.Join("\n", existingItems) +
                "\n\nDo you want to DELETE all of them and create new ones?",
                "Existing Items Found",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning);

            if (result == DialogResult.No)
            {
                Console.WriteLine("User chose NOT to delete existing items. Aborting.");
                return false;
            }
            DeleteAllExistingPipeItemsAllAtOnce(featureOwner);

            Console.WriteLine("Existing items cleanup completed successfully.");
            return true;
        }

        private static void CollectPipeItems(IpfcModelItems items, string prefix, List<string> existingItems)
        {
            if (items == null) return;
            for (int i = 0; i < items.Count; i++)
            {
                try
                {
                    string name = items[i].GetName();
                    if (IsPipeTargetName(name))
                    {
                        string entry = prefix + ": " + name;
                        if (!existingItems.Contains(entry))
                            existingItems.Add(entry);
                    }
                }
                catch { }
            }
        }

        private static void DeleteAllExistingPipeItemsAllAtOnce(IpfcModelItemOwner featureOwner)
        {
            Console.WriteLine("\nExecuting ALL-IN-ONE selection deletion of existing pipe items...");

            IpfcSession creoSession = (IpfcSession)Session;
            IpfcSelectionBuffer buffer = creoSession.CurrentSelectionBuffer;
            buffer.Clear();

            List<IpfcModelItem> itemsToSelect = new List<IpfcModelItem>();
            HashSet<int> addedIds = new HashSet<int>();
            EpfcModelItemType[] types = new[]
            {
                EpfcModelItemType.EpfcITEM_COORD_SYS,
                EpfcModelItemType.EpfcITEM_AXIS,
                EpfcModelItemType.EpfcITEM_POINT,
                EpfcModelItemType.EpfcITEM_FEATURE
            };

            foreach (var type in types)
            {
                try
                {
                    IpfcModelItems items = featureOwner.ListItems(type);
                    if (items != null)
                    {
                        for (int i = 0; i < items.Count; i++)
                        {
                            try
                            {
                                IpfcModelItem item = items[i];
                                string name = item.GetName();
                                if (IsPipeTargetName(name) && !addedIds.Contains(item.Id))
                                {
                                    addedIds.Add(item.Id);
                                    itemsToSelect.Add(item);
                                }
                            }
                            catch { }
                        }
                    }
                }
                catch { }
            }
            try
            {
                Session.RunMacro("~ Command `ProCmdTreeExpandAll`;");
                Thread.Sleep(200);
            }
            catch { }

            for (int i = 1; i <= 300; i++)
            {
                string nodeName = "node" + i;
                try
                {
                    string mapkey = "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `" + nodeName + "`;";
                    Session.RunMacro(mapkey);
                    Thread.Sleep(30);

                    IpfcSelections contents = buffer.Contents;
                    if (contents != null && contents.Count > 0)
                    {
                        IpfcModelItem selItem = contents[0]?.get_SelItem();
                        if (selItem != null)
                        {
                            string fName = "";
                            try { fName = selItem.GetName(); } catch { }
                            if (IsPipeTargetName(fName) && !addedIds.Contains(selItem.Id))
                            {
                                addedIds.Add(selItem.Id);
                                itemsToSelect.Add(selItem);
                            }
                        }
                    }
                }
                catch { }
            }
            buffer.Clear();
            Console.WriteLine("Adding " + itemsToSelect.Count + " item(s) simultaneously to selection buffer...");

            foreach (var item in itemsToSelect)
            {
                try
                {
                    IpfcSelection sel = new CMpfcSelect().CreateModelItemSelection(item, null);
                    buffer.AddSelection(sel);
                }
                catch { }
            }
            IpfcSolid solid = featureOwner as IpfcSolid ?? Session.CurrentModel as IpfcSolid;
            if (solid != null)
            {
                try
                {
                    CpfcFeatureOperations ops = new CpfcFeatureOperations();
                    HashSet<int> featOpsIds = new HashSet<int>();

                    foreach (var item in itemsToSelect)
                    {
                        try
                        {
                            IpfcFeature feat = item as IpfcFeature;
                            if (feat == null && item is IpfcAxis axis) { feat = axis.GetFeature(); }
                            if (feat == null && item is IpfcCoordSystem csys) { feat = csys.GetFeature(); }

                            if (feat != null)
                            {
                                int featId = ((IpfcModelItem)feat).Id;
                                if (!featOpsIds.Contains(featId))
                                {
                                    featOpsIds.Add(featId);
                                    IpfcDeleteOperation delOp = feat.CreateDeleteOp();
                                    delOp.Clip = true;
                                    delOp.AllowGroupMembers = true;
                                    delOp.AllowChildGroupMembers = true;
                                    ops.Append(delOp);
                                }
                            }
                        }
                        catch { }
                    }

                    if (ops.Count > 0)
                    {
                        Console.WriteLine("Executing single native batch deletion of " + ops.Count + " feature(s)...");
                        solid.ExecuteFeatureOps(ops, null);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Native batch delete note: " + ex.Message);
                }
            }
            string singleDeleteMacro =
                "~ Command `ProCmdEditDelete` ;" +
                "~ Command `ProCmdFeatDelete` ;" +
                "~ Activate `del_feat_dlg` `OK`;" +
                "~ Activate `del_feat_dlg` `stdbtn_1`;" +
                "~ Activate `del_feat_dlg` `delete_btn`;" +
                "~ Activate `del_feat_dlg` `ok_btn`;" +
                "~ Activate `del_feat_dlg` `CommitBtn`;" +
                "~ Activate `Odui_Dlg_01` `stdbtn_1`;" +
                "~ Activate `Odui_Dlg_00` `stdbtn_1`;" +
                "~ Activate `main_dlg_cur` `stdbtn_1`;";

            Session.RunMacro(singleDeleteMacro);
            Thread.Sleep(800);

            buffer.Clear();

            try
            {
                solid?.Regenerate(null);
                Session.get_CurrentWindow().Repaint();
            }
            catch { }

            Console.WriteLine("All-in-one deletion finished.");
        }
        private static Dictionary<string, string> FindTreeNodeNames(List<string> itemNames)
        {
            var result = new Dictionary<string, string>();
            var remaining = new List<string>(itemNames);

            IpfcSession creoSession = (IpfcSession)Session;
            IpfcSelectionBuffer buffer = creoSession.CurrentSelectionBuffer;

            Console.WriteLine("\nFinding tree node names for " + itemNames.Count + " item(s)...");

            try
            {
                Session.RunMacro("~ Command `ProCmdTreeExpandAll`;");
                Thread.Sleep(200);
            }
            catch { }

            int consecutiveMisses = 0;
            for (int i = 1; i <= 500 && remaining.Count > 0; i++)
            {
                string nodeName = "node" + i;

                try
                {
                    buffer.Clear();

                    string mapkey = "~ Select `main_dlg_cur` `PHTLeft.AssyTree` 1 `" + nodeName + "`;";
                    Session.RunMacro(mapkey);
                    Thread.Sleep(40);

                    IpfcSelections contents = buffer.Contents;
                    if (contents != null && contents.Count > 0)
                    {
                        consecutiveMisses = 0;
                        IpfcModelItem selItem = contents[0]?.get_SelItem();
                        if (selItem != null)
                        {
                            string foundName = "";
                            try { foundName = selItem.GetName(); } catch { }

                            for (int j = remaining.Count - 1; j >= 0; j--)
                            {
                                string targetName = remaining[j];
                                bool matched = false;

                                if (!string.IsNullOrEmpty(foundName) && foundName.Equals(targetName, StringComparison.OrdinalIgnoreCase))
                                {
                                    matched = true;
                                }
                                else if (selItem is IpfcFeature feat)
                                {
                                    try
                                    {
                                        IpfcModelItem featModelItem = feat as IpfcModelItem;
                                        if (featModelItem != null && featModelItem.GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase))
                                        {
                                            matched = true;
                                        }
                                        else
                                        {
                                            IpfcModelItems subPoints = feat.ListSubItems(EpfcModelItemType.EpfcITEM_POINT);
                                            if (subPoints != null)
                                            {
                                                for (int k = 0; k < subPoints.Count; k++)
                                                {
                                                    if (subPoints[k].GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase)) { matched = true; break; }
                                                }
                                            }
                                            if (!matched)
                                            {
                                                IpfcModelItems subAxes = feat.ListSubItems(EpfcModelItemType.EpfcITEM_AXIS);
                                                if (subAxes != null)
                                                {
                                                    for (int k = 0; k < subAxes.Count; k++)
                                                    {
                                                        if (subAxes[k].GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase)) { matched = true; break; }
                                                    }
                                                }
                                            }
                                            if (!matched)
                                            {
                                                IpfcModelItems subCsys = feat.ListSubItems(EpfcModelItemType.EpfcITEM_COORD_SYS);
                                                if (subCsys != null)
                                                {
                                                    for (int c = 0; c < subCsys.Count; c++)
                                                    {
                                                        if (subCsys[c].GetName().Equals(targetName, StringComparison.OrdinalIgnoreCase)) { matched = true; break; }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    catch { }
                                }

                                if (matched)
                                {
                                    result[targetName] = nodeName;
                                    Console.WriteLine("  Found '" + targetName + "' at " + nodeName);
                                    remaining.RemoveAt(j);
                                    break;
                                }
                            }
                        }
                    }
                    else
                    {
                        consecutiveMisses++;
                        if (consecutiveMisses > 40 && i > 80)
                        {
                            break;
                        }
                    }
                }
                catch
                {
                }
            }

            if (remaining.Count > 0)
            {
                Console.WriteLine("Finished scanning. Located tree node names for: " + string.Join(", ", result.Keys));
            }
            else
            {
                Console.WriteLine("All tree node names found successfully.");
            }

            return result;
        }
        public static void CreatePipeTree()
        {
            try
            {
                IpfcModelItemOwner itemOwner = WorkingItemOwner;
                IpfcModelItemOwner featureOwner = FeatureItemOwner;

                IpfcSolid solid = Session.CurrentModel as IpfcSolid;
                if (!CheckAndDeleteExistingItems(featureOwner))
                {
                    Console.WriteLine("Operation cancelled by user.");
                    return;
                }
                List<TerminalSide> terminalSides = FindTerminalSides(itemOwner);
                if (terminalSides.Count < 2)
                {
                    Console.WriteLine("ERROR: Could not find two terminal ends with circular edges. Found: " + terminalSides.Count);
                    return;
                }

                Console.WriteLine("\nFound " + terminalSides.Count + " terminal side(s):");
                for (int i = 0; i < terminalSides.Count; i++)
                {
                    Console.WriteLine("  Side " + (i + 1) + ": Edge Center = (" +
                        terminalSides[i].EdgeCenter[0].ToString("F2") + ", " +
                        terminalSides[i].EdgeCenter[1].ToString("F2") + ", " +
                        terminalSides[i].EdgeCenter[2].ToString("F2") + "), Radius = " +
                        terminalSides[i].EdgeRadius.ToString("F3") + ", Cylinder Area = " +
                        terminalSides[i].CylinderArea.ToString("F3"));
                }
                EnsureCylindersForTerminalSides(itemOwner, terminalSides);

                if (terminalSides[0].Cylinder == null || terminalSides[1].Cylinder == null)
                {
                    Console.WriteLine("ERROR: Could not match cylindrical surfaces to both terminal ends.");
                    return;
                }

                TerminalSide startingSide = terminalSides[0];
                TerminalSide endingSide = terminalSides[1];
                if (startingSide.CylinderArea > endingSide.CylinderArea && endingSide.CylinderArea > 0)
                {
                    startingSide = terminalSides[1];
                    endingSide = terminalSides[0];
                }
                Console.WriteLine("\nCreating PIPE_START_POINT...");
                IpfcModelItem startPoint = CreateDatumPointAtEdgeCenter(featureOwner, startingSide.Edge, "PIPE_START_POINT");
                if (startPoint == null)
                {
                    Console.WriteLine("ERROR: Could not create PIPE_START_POINT.");
                    return;
                }
                SetModelItemName(startPoint, "PIPE_START_POINT");
                Console.WriteLine("PIPE_START_POINT created: " + startPoint.GetName());
                Console.WriteLine("\nCreating A_1 (Start Axis)...");
                IpfcModelItem axis1 = CreateAxisFromCylinder(featureOwner, startingSide.Cylinder, "A_1");
                if (axis1 != null)
                {
                    SetModelItemName(axis1, "A_1");
                    Console.WriteLine("A_1 created: " + axis1.GetName());
                }
                else
                {
                    Console.WriteLine("ERROR: Could not create A_1.");
                    return;
                }
                Console.WriteLine("\nCreating A_2 (End Axis)...");
                IpfcModelItem axis2 = CreateAxisFromCylinder(featureOwner, endingSide.Cylinder, "A_2");
                if (axis2 != null)
                {
                    SetModelItemName(axis2, "A_2");
                    Console.WriteLine("A_2 created: " + axis2.GetName());
                }
                else
                {
                    Console.WriteLine("ERROR: Could not create A_2.");
                    return;
                }
                Console.WriteLine("\nCreating PIPE_Z_POINT (axis intersection)...");
                IpfcSession sessionContext = (IpfcSession)Session;
                IpfcSelectionBuffer axisBuffer = sessionContext.CurrentSelectionBuffer;
                axisBuffer.Clear();

                IpfcSelection axisSelection1 = new CMpfcSelect().CreateModelItemSelection(axis1, null);
                IpfcSelection axisSelection2 = new CMpfcSelect().CreateModelItemSelection(axis2, null);
                axisBuffer.AddSelection(axisSelection1);
                axisBuffer.AddSelection(axisSelection2);

                int pointCountBeforeMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT)?.Count ?? 0;
                int featCountBeforeMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE)?.Count ?? 0;

                string midpointMacro =
                    "~ Command `ProCmdDatumPointGeneral` ;" +
                    "~ Activate `Odui_Dlg_00` `stdbtn_1`;";
                Session.RunMacro(midpointMacro);
                Thread.Sleep(2000);

                IpfcModelItems pointsAfterMidpoint = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_POINT);
                if (pointsAfterMidpoint == null || pointsAfterMidpoint.Count <= pointCountBeforeMid)
                {
                    Console.WriteLine("ERROR: PIPE_Z_POINT was not created.");
                    return;
                }

                IpfcModelItem midpoint = pointsAfterMidpoint[pointsAfterMidpoint.Count - 1];
                SetModelItemName(midpoint, "PIPE_Z_POINT");

                IpfcModelItems featsAfterMid = featureOwner.ListItems(EpfcModelItemType.EpfcITEM_FEATURE);
                if (featsAfterMid != null && featsAfterMid.Count > featCountBeforeMid)
                {
                    try { ((IpfcModelItem)featsAfterMid[featsAfterMid.Count - 1])?.SetName("PIPE_Z_POINT"); } catch { }
                }

                Console.WriteLine("PIPE_Z_POINT created: " + midpoint.GetName());
                Console.WriteLine("\nCreating PIPE_END_POINT...");
                IpfcModelItem endPoint = CreateDatumPointAtEdgeCenter(featureOwner, endingSide.Edge, "PIPE_END_POINT");
                if (endPoint == null)
                {
                    Console.WriteLine("ERROR: Could not create PIPE_END_POINT.");
                    return;
                }
                SetModelItemName(endPoint, "PIPE_END_POINT");
                Console.WriteLine("PIPE_END_POINT created: " + endPoint.GetName());
                startingSide.PipeDistance = GetSelectionDistance(midpoint, startPoint);
                endingSide.PipeDistance = GetSelectionDistance(midpoint, endPoint);

                bool isStartingShorter = startingSide.PipeDistance <= endingSide.PipeDistance;
                double minimumPipeDistance = isStartingShorter ? startingSide.PipeDistance : endingSide.PipeDistance;
                double maximumPipeDistance = isStartingShorter ? endingSide.PipeDistance : startingSide.PipeDistance;

                IpfcModelItem shorterPoint = isStartingShorter ? startPoint : endPoint;
                IpfcModelItem longerPoint = isStartingShorter ? endPoint : startPoint;

                solid?.Regenerate(null);
                Session.get_CurrentWindow().Repaint();

                Console.WriteLine("\nSTARTING PIPE DETAILS");
                Console.WriteLine("  Starting point: " + startPoint.GetName());
                Console.WriteLine("  Starting cylinder area: " + startingSide.CylinderArea.ToString("F4"));
                Console.WriteLine("  Starting pipe distance: " + startingSide.PipeDistance.ToString("F4"));

                Console.WriteLine("\nENDING PIPE DETAILS");
                Console.WriteLine("  Ending point: " + endPoint.GetName());
                Console.WriteLine("  Ending cylinder area: " + endingSide.CylinderArea.ToString("F4"));
                Console.WriteLine("  Ending pipe distance: " + endingSide.PipeDistance.ToString("F4"));

                Console.WriteLine("\nSHORTER PIPE: " +
                    (isStartingShorter ? "STARTING PIPE (" + startPoint.GetName() + ")" : "ENDING PIPE (" + endPoint.GetName() + ")") +
                    " with distance: " + minimumPipeDistance.ToString("F4"));
                string shorterItemName = isStartingShorter ? "PIPE_START_POINT" : "PIPE_END_POINT";
                string longerItemName = isStartingShorter ? "PIPE_END_POINT" : "PIPE_START_POINT";
                string shorterAxisName = isStartingShorter ? "A_1" : "A_2";

                List<string> namesToFind = new List<string>
                {
                    shorterItemName,
                    longerItemName,
                    shorterAxisName,
                    "A_1",
                    "A_2",
                    "PIPE_AXIS_START",
                    "PIPE_AXIS_END"
                };

                Dictionary<string, string> nodeNames = FindTreeNodeNames(namesToFind);

                if (!nodeNames.TryGetValue(shorterItemName, out string shorterNode) ||
                    !nodeNames.TryGetValue(longerItemName, out string longerNode))
                {
                    Console.WriteLine("ERROR: Could not find tree node names for the end points.");
                    return;
                }

                if (!nodeNames.TryGetValue(shorterAxisName, out string axisRefNode))
                {
                    if (!nodeNames.TryGetValue("A_1", out axisRefNode) &&
                        !nodeNames.TryGetValue("A_2", out axisRefNode) &&
                        !nodeNames.TryGetValue("PIPE_AXIS_START", out axisRefNode) &&
                        !nodeNames.TryGetValue("PIPE_AXIS_END", out axisRefNode))
                    {
                        Console.WriteLine("ERROR: Could not find tree node name for pipe axis.");
                        return;
                    }
                }

                Console.WriteLine("\nDynamic tree node mapping:");
                Console.WriteLine("  Origin (" + shorterItemName + ") -> " + shorterNode);
                Console.WriteLine("  Ref1 Axis (" + shorterAxisName + ") -> " + axisRefNode);
                Console.WriteLine("  Ref2 (" + longerItemName + ") -> " + longerNode);

                double[] shorterCoords = GetPointCoordinates(shorterPoint);
                double[] apexCoords = GetPointCoordinates(midpoint);
                Console.WriteLine("CREATING COORDINATE_1 (BEND_DATA) at " + shorterPoint.GetName());
                IpfcModelItem coordinate1 = CreateCoordinateSystem(
                    featureOwner,
                    shorterNode,
                    axisRefNode,
                    longerNode,
                    "Axis_Y",
                    "BEND_DATA");
                if (coordinate1 == null)
                {
                    Console.WriteLine("ERROR: COORDINATE_1 (BEND_DATA) was not created.");
                    return;
                }

                solid?.Regenerate(null);
                Session.get_CurrentWindow().Repaint();
                bool isOutward1 = IsYAxisPointingOutward(coordinate1, shorterCoords, apexCoords);
                if (!isOutward1)
                {
                    Console.WriteLine("BEND_DATA Y-axis is pointing inwards. Automatically adjusting to point OUTWARDS ...");
                    FlipCoordinateSystemY(coordinate1);
                    solid?.Regenerate(null);
                    Session.get_CurrentWindow().Repaint();
                }

                Console.WriteLine("\nCOORDINATE_1 (BEND_DATA) is pointing OUTWARDS .");
                Console.WriteLine("Displaying prompt: Y axis is pointing outside. Prompting user if they want to switch to inside...");
                DialogResult result = MessageBox.Show(
                    "COORDINATE_1 (BEND_DATA):\nThe Y axis is currently pointing OUTWARDS .\n\nDo you want to switch the axis to point INWARDS ?",
                    "BEND_DATA - Y Axis Direction",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

                if (result == DialogResult.Yes)
                {
                    Console.WriteLine("User selected YES. Switching BEND_DATA Y axis to point INWARDS ");
                    FlipCoordinateSystemY(coordinate1);
                    solid?.Regenerate(null);
                    Session.get_CurrentWindow().Repaint();
                    Console.WriteLine("COORDINATE_1 (BEND_DATA) Y axis switched to point INWARDS successfully.");
                }
                else
                {
                    Console.WriteLine("User selected NO. COORDINATE_1 (BEND_DATA) Y axis kept pointing OUTWARDS .");
                }
                Console.WriteLine("CREATING COORDINATE_2 (PIPE_BOUND_BOX) at " + shorterPoint.GetName());
                IpfcModelItem coordinate2 = CreateCoordinateSystem(
                    featureOwner,
                    shorterNode,
                    axisRefNode,
                    longerNode,
                    "Axis_Y",
                    "PIPE_BOUND_BOX");

                if (coordinate2 == null)
                {
                    Console.WriteLine("ERROR: COORDINATE_2 (PIPE_BOUND_BOX) was not created.");
                    return;
                }

                solid?.Regenerate(null);
                Session.get_CurrentWindow().Repaint();
                bool isOutward2 = IsYAxisPointingOutward(coordinate2, shorterCoords, apexCoords);
                if (isOutward2)
                {
                    Console.WriteLine("PIPE_BOUND_BOX Y-axis is pointing outwards. Automatically adjusting to point INWARDS ...");
                    FlipCoordinateSystemY(coordinate2);
                    solid?.Regenerate(null);
                    Session.get_CurrentWindow().Repaint();
                }

                Console.WriteLine("COORDINATE_2 (PIPE_BOUND_BOX) created pointing INWARDS automatically.");
                Console.WriteLine("PIPE TREE COMPLETED SUCCESSFULLY");
                Console.WriteLine("START_POINT  = " + startPoint.GetName());
                Console.WriteLine("MID_POINT    = " + midpoint.GetName());
                Console.WriteLine("END_POINT    = " + endPoint.GetName());
                Console.WriteLine("AXIS_1 (A_1) = " + axis1.GetName());
                Console.WriteLine("AXIS_2 (A_2) = " + axis2.GetName());
                Console.WriteLine("COORDINATE_1 = " + coordinate1.GetName());
                Console.WriteLine("COORDINATE_2 = " + coordinate2.GetName());
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error in CreatePipeTree: " + ex.Message + "\n" + ex.StackTrace);
            }
        }
