        /// <summary>
        /// Browse for a Creo part (.prt) or assembly (.asm) file.
        /// </summary>
        private void btnBrowse_Click(object sender, RoutedEventArgs e)
        {
            var dialog = new Microsoft.Win32.OpenFileDialog
            {
                Title = "Select Creo Part or Assembly File",
                Filter = "Creo Files (*.prt;*.asm)|*.prt;*.asm|Part Files (*.prt)|*.prt|Assembly Files (*.asm)|*.asm|All Files (*.*)|*.*",
                Multiselect = false,
                CheckFileExists = true
            };

            if (dialog.ShowDialog() == true)
            {
                txtFilePath.Text = dialog.FileName;
                txtFilePath.Foreground = Brushes.Black;
                btnExecute.IsEnabled = true;
                AppendLog($"[✓] Selected file: {dialog.FileName}");
            }
        }

        /// <summary>
        /// Add a new empty parameter row to the list.
        /// </summary>
        private void btnAddParam_Click(object sender, RoutedEventArgs e)
        {
            var newParam = new ParameterItem
            {
                ParamName = "",
                ParamValue = "",
                RemoveCommand = new RelayCommand<ParameterItem>(RemoveParameter)
            };
            _parameters.Add(newParam);
        }

        /// <summary>
        /// Remove a parameter from the list.
        /// </summary>
        private void RemoveParameter(ParameterItem item)
        {
            if (_parameters.Contains(item))
                _parameters.Remove(item);
        }

