        /// <summary>
        /// Main execution button — runs the full Creo automation workflow.
        /// </summary>
        private async void btnExecute_Click(object sender, RoutedEventArgs e)
        {
            // Validate file selection
            string filePath = txtFilePath.Text.Trim();
            if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath))
            {
                MessageBox.Show("Please select a valid Creo part (.prt) or assembly (.asm) file.",
                                "File Required", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            // Disable UI during execution
            SetUIEnabled(false);
            progressBar.Value = 0;
            txtLog.Clear();
            AppendLog("═══════════════════════════════════════════════════");
            AppendLog("🚀 Starting Creo Parametric Automation...");
            AppendLog($"📁 File: {filePath}");
            AppendLog("═══════════════════════════════════════════════════\n");

            try
            {
                // Run the automation workflow on a background thread
                await System.Threading.Tasks.Task.Run(() =>
                {
                    ExecuteCreoAutomation(filePath);
                });
            }
            catch (Exception ex)
            {
                AppendLog($"\n[❌] FATAL ERROR: {ex.Message}");
                AppendLog($"[❌] Stack Trace:\n{ex.StackTrace}");
            }
            finally
            {
                // Clean up Creo connection if active
                CleanupCreoConnection();

                // Re-enable UI
                Dispatcher.Invoke(() =>
                {
                    SetUIEnabled(true);
                    progressBar.Value = progressBar.Maximum;
                    AppendLog("\n═══════════════════════════════════════════════════");
                    AppendLog(progressBar.Value >= 100 ? "✅ Automation completed successfully!" : "⚠️ Automation completed with issues.");
                    AppendLog("═══════════════════════════════════════════════════");
                });
            }
        }

        // ==================== CORE AUTOMATION LOGIC ====================

        /// <summary>
        /// Main Creo automation workflow.
        /// Steps: Connect → Open Model → Get/Create Drawing → Add Views →
        ///        Add Mass Table → Update Params → Export PDF
        /// </summary>
        private void ExecuteCreoAutomation(string filePath)
        {
            // --------------------------------------------------
            // PHASE 1: Connect to running Creo session
            // --------------------------------------------------
            AppendLog("[1/7] 🔌 Connecting to Creo Parametric session...");
            UpdateProgress(5);

            dynamic connection = ConnectToCreo();
            if (connection == null) return;
            _asyncConnection = connection;

            dynamic session = connection.Session;
            AppendLog("[✓] Connected to Creo session successfully.");
            UpdateProgress(10);

            try
            {
                // --------------------------------------------------
                // PHASE 2: Open the part/assembly model
                // --------------------------------------------------
                AppendLog("\n[2/7] 📂 Opening model file...");
                UpdateProgress(12);

                dynamic model = OpenModel(session, filePath);
                if (model == null) return;

                _solidModel = model;
                string modelName = Path.GetFileNameWithoutExtension(filePath);
                AppendLog($"[✓] Model opened: {modelName}");
                UpdateProgress(20);

                // --------------------------------------------------
                // PHASE 3: Create or open associated drawing
                // --------------------------------------------------
                AppendLog("\n[3/7] 📄 Opening/Creating drawing...");
                UpdateProgress(22);

                dynamic drawing = OpenOrCreateDrawing(session, model, modelName);
                if (drawing == null) return;

                _drawing = drawing;
                _session = session;
                AppendLog($"[✓] Drawing activated: {drawing.InstanceName}");
                UpdateProgress(30);

                // --------------------------------------------------
                // PHASE 4: Display the model in the drawing
                // --------------------------------------------------
                AppendLog("\n[4/7] 📐 Adding model to drawing...");
                UpdateProgress(32);

                drawing.AddModel(model);
                AppendLog("[✓] Model added to drawing.");
                UpdateProgress(35);

                // --------------------------------------------------
                // PHASE 5: Create 4 standard views
                // --------------------------------------------------
                AppendLog("\n[5/7] 🖼️ Creating 4 drawing views...");
                UpdateProgress(38);

                CreateFourViews(drawing, model);
                AppendLog("[✓] All 4 views created successfully.");
                UpdateProgress(50);

                // --------------------------------------------------
                // PHASE 6: Add mass properties table
                // --------------------------------------------------
                AppendLog("\n[6/7] 📊 Creating mass properties table...");
                UpdateProgress(55);

                CreateMassPropertiesTable(drawing, model);
                AppendLog("[✓] Mass properties table added.");
                UpdateProgress(65);

                // --------------------------------------------------
                // PHASE 7: Find & Update parameters
                // --------------------------------------------------
                AppendLog("\n[6b/7] 🔍 Finding & updating parameters...");
                UpdateProgress(70);

                UpdateModelParameters(model);
                UpdateProgress(80);

                // --------------------------------------------------
                // PHASE 8: Regenerate & Export to PDF
                // --------------------------------------------------
                AppendLog("\n[7/7] 📤 Exporting drawing to PDF...");
                UpdateProgress(82);

                ExportDrawingToPDF(drawing, modelName);
                UpdateProgress(95);

                AppendLog("\n✅ ALL STEPS COMPLETED SUCCESSFULLY!");
            }
            catch (Exception ex)
            {
                AppendLog($"\n[❌] Error during automation: {ex.Message}");
                throw;
            }
        }

