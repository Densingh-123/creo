    /// <summary>
    /// Represents a parameter name-value pair for the UI list.
    /// </summary>
    public class ParameterItem : INotifyPropertyChanged
    {
        private string _paramName;
        private string _paramValue;

        public string ParamName
        {
            get => _paramName;
            set { _paramName = value; OnPropertyChanged(nameof(ParamName)); }
        }

        public string ParamValue
        {
            get => _paramValue;
            set { _paramValue = value; OnPropertyChanged(nameof(ParamValue)); }
        }

        public ICommand RemoveCommand { get; set; }

        public event PropertyChangedEventHandler PropertyChanged;
        protected void OnPropertyChanged(string name) =>
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
    }

